---
import { Download, ExternalLink } from '@lucide/astro';
import type { LocaleCode } from '../config';
import { getDictionary } from '../i18n';

interface Props {
  /** GitHub Releases page */
  releases: string;
  /** GitHub repository */
  repo: string;
  class?: string;
  locale?: LocaleCode;
}

const { releases, repo, class: className = '', locale = 'en' } = Astro.props;
const t = await getDictionary(locale);
---

<div class:list={['flex flex-wrap items-center gap-3', className]}>
  <a
    href={releases}
    class="group inline-flex items-center gap-2 rounded-xl bg-brush-violet px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-violet-500/25 transition hover:bg-violet-700"
  >
    <Download class="h-4 w-4" aria-hidden="true" />
    {t.common.download}
  </a>
  <a
    href={repo}
    class="inline-flex items-center gap-2 rounded-xl border border-stone-300 bg-white px-6 py-3 text-sm font-semibold text-ink shadow-sm transition hover:border-violet-400 hover:text-brush-violet"
  >
    <ExternalLink class="h-4 w-4" aria-hidden="true" />
    {t.common.github}
  </a>
</div>
