---
/**
 * Shared product-page scaffold for the BrushLLM desktop apps
 * (github.com/BrushLLM). Each app page passes its SiteApp metadata plus
 * feature groups; personal sections go in the named slots.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import AppDownload from './AppDownload.astro';
import BrushStroke from './BrushStroke.astro';
import type { SiteApp } from '../data/apps';
import { SITE } from '../config';

export interface AppFeatureGroup {
  title: string;
  /** accent for the group's icon tiles: rotates the icon trio */
  items: { title: string; description: string }[];
}

interface Props {
  app: SiteApp;
  featureGroups: AppFeatureGroup[];
  /** hero badge text, e.g. "Desktop app · Free" */
  badge?: string;
  /** extra JSON-LD nodes for this page */
  extraSchema?: Record<string, unknown>[];
}

const { app, featureGroups, badge = 'Desktop app · Free', extraSchema = [] } = Astro.props;

const schema: Record<string, unknown> = {
  '@type': 'SoftwareApplication',
  '@id': `${SITE.url}/#${app.id}`,
  name: `BrushLLM ${app.name}`,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'macOS, Windows',
  description: app.description,
  url: `${SITE.url}${app.href}`,
  downloadUrl: app.releases,
  brand: { '@type': 'Brand', name: 'BrushLLM' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

/* icon tiles rotate the icon trio like the homepage benefit cards */
const tileStyles = [
  'bg-brush-violet text-white shadow-violet-500/25',
  'bg-brush-orange text-ink shadow-orange-500/25',
  'bg-brush-mint text-ink shadow-mint-600/25',
] as const;
---

<BaseLayout title={app.name} description={`${app.tagline} — ${app.description}`} extraSchema={[schema, ...extraSchema]}>
  <section class="relative mx-auto max-w-4xl overflow-hidden px-4 py-20 text-center sm:px-6">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <BrushStroke shape="sweep" color="violet" class="absolute -top-10 -left-40 w-[620px] -rotate-6 opacity-15" />
      <BrushStroke shape="sweep" color="mint" class="absolute top-40 -right-44 w-[560px] rotate-3 opacity-15" />
    </div>

    <img src={app.icon} alt="" width="96" height="96" class="mx-auto h-24 w-24 rounded-3xl shadow-xl shadow-stone-300/50" />
    <span class="mt-6 inline-flex items-center gap-2 rounded-full bg-brush-orange px-3.5 py-1 text-xs font-semibold uppercase tracking-widest text-ink shadow-md shadow-orange-500/25">
      {badge}
    </span>
    <h1 class="mt-6 text-4xl font-bold tracking-tight text-balance sm:text-5xl">
      BrushLLM {app.name},
      <span class="relative inline-block">
        <span>{app.tagline.replace(/^[a-z]/, (c) => c.toLowerCase())}</span>
        <BrushStroke shape="underline" color="orange" class="absolute -bottom-2 left-0 h-2.5 w-full" />
      </span>
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-muted">{app.description}</p>

    <div class="mt-8 flex justify-center">
      <AppDownload releases={app.releases} repo={app.repo} />
    </div>

    <ul class="mx-auto mt-6 flex flex-wrap justify-center gap-1.5 sm:gap-2">
      {
        app.highlights.map((h) => (
          <li class="rounded-full border border-stone-200 bg-white px-2.5 py-1 text-[11px] font-medium text-stone-600 shadow-sm sm:px-3 sm:text-xs">{h}</li>
        ))
      }
    </ul>
    <p class="mt-5 text-sm text-stone-500">{app.platforms.join(' · ')}</p>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <slot name="intro" />
    {
      featureGroups.map((group) => (
        <div class="reveal mt-12">
          <h2 class="text-2xl font-bold tracking-tight">{group.title}</h2>
          <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {group.items.map((item, i) => (
              <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-violet-300 hover:shadow-lg">
                <div class={`flex h-11 w-11 items-center justify-center rounded-xl shadow-lg ${tileStyles[i % tileStyles.length]}`}>
                  <span class="text-sm font-bold">{String(i + 1).padStart(2, '0')}</span>
                </div>
                <h3 class="mt-4 font-semibold">{item.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{item.description}</p>
              </div>
            ))}
          </div>
        </div>
      ))
    }
    <slot />
  </section>

  <section class="border-t border-stone-100 bg-stone-50/50">
    <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6">
      <div class="reveal relative overflow-hidden rounded-[2rem] border border-stone-200 bg-white px-6 py-12 shadow-xl shadow-stone-200/60 sm:px-14">
        <div class="pointer-events-none absolute inset-0" aria-hidden="true">
          <BrushStroke shape="underline" color="ink" class="absolute right-[14%] bottom-8 w-44 rotate-2 opacity-70" />
        </div>
        <h2 class="relative text-2xl font-bold tracking-tight">Open source, honest software</h2>
        <p class="relative mx-auto mt-2 max-w-md text-sm leading-relaxed text-muted">
          Source code, issues and releases live on GitHub{app.license ? ` — ${app.license}` : ''}. No telemetry, no accounts, no ads.
        </p>
        <div class="relative mt-6 flex justify-center">
          <AppDownload releases={app.releases} repo={app.repo} />
        </div>
        <slot name="outro" />
      </div>
    </div>
  </section>
</BaseLayout>
