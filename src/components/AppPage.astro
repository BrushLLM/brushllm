---
/**
 * Shared product-page scaffold for the BrushLLM desktop apps
 * (github.com/BrushLLM). Each app page passes its SiteApp metadata plus
 * feature groups; personal sections go in the named slots.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import AppDownload from './AppDownload.astro';
import BrushStroke from './BrushStroke.astro';
import type { SiteApp } from '../data/apps';
import { SITE, type LocaleCode } from '../config';
import { getDictionary, localePath } from '../i18n';

export interface AppFeatureGroup {
  title: string;
  items: { title: string; description: string }[];
}

interface Props {
  app: SiteApp;
  featureGroups: AppFeatureGroup[];
  /** hero badge text, e.g. "Desktop app · Free" */
  badge?: string;
  /** extra JSON-LD nodes for this page */
  extraSchema?: Record<string, unknown>[];
  locale?: LocaleCode;
}

const { app, featureGroups, extraSchema = [], locale = 'en' } = Astro.props;
const t = await getDictionary(locale);
const badge = Astro.props.badge ?? 'Desktop app · Free';
const appTr = t.data.apps[app.id as keyof typeof t.data.apps];
const tagline = appTr.tagline.replace(/^[a-z]/, (c) => c.toLowerCase());
const description = appTr.description;

const schema: Record<string, unknown> = {
  '@type': 'SoftwareApplication',
  '@id': `${SITE.url}/#${app.id}`,
  name: `BrushLLM ${app.name}`,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'macOS, Windows',
  description,
  url: `${SITE.url}${localePath(locale, app.href)}`,
  downloadUrl: app.releases,
  brand: { '@type': 'Brand', name: 'BrushLLM' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<BaseLayout locale={locale} title={app.name} description={`${tagline} — ${description}`} extraSchema={[schema, ...extraSchema]}>
  <section class="relative mx-auto max-w-4xl overflow-hidden px-4 py-20 text-center sm:px-6">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <BrushStroke shape="sweep" color="violet" class="absolute -top-10 -left-40 w-[620px] -rotate-6 opacity-15" />
      <BrushStroke shape="sweep" color="mint" class="absolute top-40 -right-44 w-[560px] rotate-3 opacity-15" />
    </div>

    <img src={app.icon} alt="" width="96" height="96" class="mx-auto h-24 w-24 rounded-panel shadow-lift shadow-stone-300/50" />
    <span class="mt-6 inline-flex items-center gap-2 rounded-full bg-brush-orange px-3.5 py-1 text-xs font-semibold text-ink shadow-card shadow-lift">
      {badge}
    </span>
    <h1 class="mt-6 text-4xl font-bold tracking-tight text-balance sm:text-5xl">
      BrushLLM {app.name},
      <span class="relative inline-block">
        <span>{tagline}</span>
        <BrushStroke shape="underline" color="orange" class="absolute -bottom-2 left-0 h-2.5 w-full" />
      </span>
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-muted">{description}</p>

    <div class="mt-8 flex justify-center">
      <AppDownload releases={app.releases} repo={app.repo} locale={locale} />
    </div>

    <ul class="mx-auto mt-6 flex flex-wrap justify-center gap-1.5 sm:gap-2">
      {
        appTr.highlights.map((h) => (
          <li class="rounded-full border border-stone-200 bg-white px-2.5 py-1 text-[11px] font-medium text-stone-600 shadow-soft sm:px-3 sm:text-xs">{h}</li>
        ))
      }
    </ul>
    <p class="mt-5 text-sm text-stone-500">{app.platforms.join(' · ')}</p>
  </section>

  <!-- the app itself: official screenshot in a window frame -->
  <section class="mx-auto max-w-5xl px-4 pb-16 sm:px-6">
    <div class="reveal overflow-hidden rounded-card border border-stone-200 bg-white shadow-lift">
      <div class="flex items-center gap-3 border-b border-stone-100 bg-stone-50 px-4 py-2.5">
        <div class="flex gap-1.5" aria-hidden="true">
          <span class="h-2.5 w-2.5 rounded-full bg-stone-300"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-stone-300"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-stone-300"></span>
        </div>
        <p class="flex-1 truncate rounded-chip bg-white px-3 py-1 text-center font-mono text-xs text-stone-500 ring-1 ring-stone-200">
          BrushLLM {app.name}
        </p>
      </div>
      <img src={app.screenshot} alt={`BrushLLM ${app.name} interface`} width="1200" class="w-full" loading="lazy" />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <slot name="intro" />
    {
      featureGroups.map((group) => (
        <div class="reveal mt-10">
          <h2 class="text-xl font-bold tracking-tight">{group.title}</h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {group.items.map((item) => (
              <div class="rounded-card border border-stone-200 bg-white p-5 shadow-soft transition hover:-translate-y-1 hover:border-violet-300 hover:shadow-lift">
                <h3 class="font-semibold">{item.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-muted">{item.description}</p>
              </div>
            ))}
          </div>
        </div>
      ))
    }
    <slot />
  </section>

  <section class="border-t border-stone-100 bg-stone-50/50">
    <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6">
      <div class="reveal relative overflow-hidden rounded-panel border border-stone-200 bg-white px-6 py-16 shadow-lift sm:px-14">
        <div class="pointer-events-none absolute inset-0" aria-hidden="true">
          <BrushStroke shape="underline" color="ink" class="absolute right-[14%] bottom-8 w-44 rotate-2 opacity-70" />
        </div>
        <h2 class="relative text-2xl font-bold tracking-tight">{t.appPage.openSourceTitle}</h2>
        <p class="relative mx-auto mt-2 max-w-md text-sm leading-relaxed text-muted">
          {t.appPage.openSourceText.replace('{license}', app.license ? ` — ${app.license}` : '')}
        </p>
        <div class="relative mt-6 flex justify-center">
          <AppDownload releases={app.releases} repo={app.repo} locale={locale} />
        </div>
        <slot name="outro" />
      </div>
    </div>
  </section>
</BaseLayout>
