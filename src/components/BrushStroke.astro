---
/**
 * A wide, flat brush swipe painted in one vivid color — the site's signature mark.
 * The band has near-parallel straight edges (one pass of a flat wall brush, not
 * a calligraphy stroke), and the texture inside is long, straight, parallel
 * bristle tracks running the full length of the swipe, with a dry-brush tail.
 *
 * shape: 'highlight' (band behind headline text — render at low opacity
 *         with ink text on top), 'underline' (short swipe under a word),
 *         'sweep' (long decorative swipe for section corners)
 */
interface Props {
  shape?: 'highlight' | 'underline' | 'sweep';
  color?: 'violet' | 'fuchsia' | 'orange' | 'cyan' | 'rose' | 'amber' | 'blue' | 'green';
  class?: string;
}

const { shape = 'sweep', color = 'violet', class: className = '' } = Astro.props;

const colors: Record<string, string> = {
  violet: '#7C3AED',
  fuchsia: '#D946EF',
  orange: '#F97316',
  cyan: '#06B6D4',
  rose: '#F43F5E',
  amber: '#F59E0B',
  blue: '#2563EB',
  green: '#059669',
};
const fill = colors[color]!;

const shapes: Record<string, { viewBox: string; d: string; streaks: { d: string; stroke: string; opacity: number; width: number }[] }> = {
  highlight: {
    viewBox: '0 0 400 100',
    d: 'M12 42 L 388 40 L 386 80 L 14 84 Z',
    streaks: [
      { d: 'M28 52 L 372 51', stroke: '#ffffff', opacity: 0.7, width: 6 },
      { d: 'M24 66 L 376 64', stroke: '#ffffff', opacity: 0.45, width: 3.5 },
      { d: 'M50 59 L 350 57', stroke: '#000000', opacity: 0.12, width: 4 },
    ],
  },
  underline: {
    viewBox: '0 0 320 26',
    d: 'M8 9 L 312 7 L 311 18 L 9 20 Z',
    streaks: [
      { d: 'M18 12 L 302 11', stroke: '#ffffff', opacity: 0.55, width: 2.4 },
      { d: 'M16 16 L 300 15', stroke: '#000000', opacity: 0.1, width: 1.8 },
    ],
  },
  sweep: {
    viewBox: '0 0 600 130',
    d: 'M16 66 L 470 48 C 520 44, 560 44, 586 50 L 582 82 C 556 76, 516 78, 466 74 L 20 92 Z',
    streaks: [
      { d: 'M44 58 L 560 58', stroke: '#ffffff', opacity: 0.5, width: 7 },
      { d: 'M34 78 L 552 74', stroke: '#ffffff', opacity: 0.3, width: 4 },
      { d: 'M74 68 L 508 66', stroke: '#000000', opacity: 0.1, width: 5 },
    ],
  },
};
const s = shapes[shape]!;
const clipId = `swipe-${shape}-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={['swipe-in pointer-events-none select-none', className]}
  viewBox={s.viewBox}
  aria-hidden="true"
  preserveAspectRatio="none"
>
  <defs>
    <clipPath id={clipId}>
      <path d={s.d}></path>
    </clipPath>
  </defs>
  <path d={s.d} fill={fill}></path>
  <g clip-path={`url(#${clipId})`}>
    {s.streaks.map((streak) => (
      <path
        d={streak.d}
        fill="none"
        stroke={streak.stroke}
        stroke-opacity={streak.opacity}
        stroke-width={streak.width}
        stroke-linecap="round"
      ></path>
    ))}
  </g>
</svg>
