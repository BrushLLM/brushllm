---
/**
 * A wide, flat brush swipe painted in one vivid color — the site's signature mark.
 * Filled path (not a stroked line), irregular edges, slight tilt: like one pass
 * of a paint brush on a white wall.
 *
 * shape:   'highlight' (wide band behind headline text)
 *          'underline' (short swipe under a word)
 *          'sweep'     (long decorative swipe for section corners)
 * color:   key of `colors` below
 */
interface Props {
  shape?: 'highlight' | 'underline' | 'sweep';
  color?: 'violet' | 'fuchsia' | 'orange' | 'cyan' | 'rose' | 'amber';
  class?: string;
}

const { shape = 'sweep', color = 'violet', class: className = '' } = Astro.props;

const colors: Record<string, string> = {
  violet: '#7C3AED',
  fuchsia: '#D946EF',
  orange: '#F97316',
  cyan: '#06B6D4',
  rose: '#F43F5E',
  amber: '#F59E0B',
};
const fill = colors[color]!;

const shapes = {
  highlight: {
    viewBox: '0 0 400 100',
    d: 'M8 55 C 90 24, 280 22, 392 38 L 390 82 C 280 66, 92 72, 10 96 Z',
  },
  underline: {
    viewBox: '0 0 320 26',
    d: 'M6 12 C 90 2, 220 20, 314 8 L 313 18 C 220 28, 90 12, 7 22 Z',
  },
  sweep: {
    viewBox: '0 0 600 130',
    d: 'M12 72 C 130 18, 300 26, 420 44 C 500 56, 560 40, 590 50 L 586 84 C 540 72, 480 90, 380 76 C 260 60, 120 82, 16 108 Z',
  },
};
const s = shapes[shape];
---

<svg
  class:list={['swipe-in pointer-events-none select-none', className]}
  viewBox={s.viewBox}
  fill={fill}
  aria-hidden="true"
  preserveAspectRatio="none"
>
  <path d={s.d}></path>
</svg>
