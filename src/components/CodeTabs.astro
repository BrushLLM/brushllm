---
import type { LocaleCode } from '../config';
import { getDictionary } from '../i18n';

export interface Tab {
  label: string;
  code: string;
}

interface Props {
  tabs: Tab[];
  class?: string;
  locale?: LocaleCode;
}

const { tabs, class: className = '', locale = 'en' } = Astro.props;
const t = await getDictionary(locale);
const uid = `ct-${Math.random().toString(36).slice(2, 8)}`;
---

<div class:list={['overflow-hidden rounded-card border border-stone-200 bg-white shadow-lift', className]} data-codetabs>
  <div class="flex items-center justify-between gap-2 border-b border-stone-100 bg-stone-50 pl-2 pr-2 sm:pr-3">
    <div class="flex flex-wrap gap-1" role="tablist" aria-label={t.common.codeExamples}>
      {
        tabs.map((tab, i) => (
          <button
            type="button"
            class="tab-btn px-3 py-2.5 text-sm font-medium"
            data-tab={i}
            role="tab"
            id={`${uid}-tab-${i}`}
            aria-controls={`${uid}-panel-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            {tab.label}
          </button>
        ))
      }
    </div>
    <button
      type="button"
      class="shrink-0 rounded-chip border border-stone-200 bg-white px-2.5 py-1.5 text-xs font-medium text-muted transition-colors hover:border-violet-300 hover:text-brush-violet"
      data-copy
      data-copy-label={t.common.copy}
      data-copied-label={t.common.copied}
      data-copy-fallback-label={t.common.copyFallback}
    >
      <span aria-live="polite">{t.common.copy}</span>
    </button>
  </div>
  {
    tabs.map((tab, i) => (
      <pre
        class:list={['overflow-x-auto p-4 font-mono text-[13px] leading-relaxed text-stone-800', i !== 0 && 'hidden']}
        data-panel={i}
        id={`${uid}-panel-${i}`}
        role="tabpanel"
        aria-labelledby={`${uid}-tab-${i}`}
        tabindex="0"
      >
        <code>{tab.code}</code>
      </pre>
    ))
  }
</div>

<style>
  .tab-btn {
    color: var(--color-stone-500);
    border-bottom: 2px solid transparent;
    transition: color 0.15s;
  }
  .tab-btn:hover {
    color: var(--color-ink);
  }
  .tab-btn[aria-selected='true'] {
    color: var(--color-brush-violet);
    border-bottom: 2px solid var(--color-brush-violet);
  }
</style>

<script>
  document.querySelectorAll<HTMLDivElement>('[data-codetabs]').forEach((root) => {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    const copyBtn = root.querySelector<HTMLButtonElement>('[data-copy]');

    const activate = (index: number) => {
      buttons.forEach((btn, i) => {
        const on = i === index;
        btn.setAttribute('aria-selected', String(on));
        btn.tabIndex = on ? 0 : -1;
      });
      panels.forEach((panel, i) => panel.classList.toggle('hidden', i !== index));
    };

    buttons.forEach((btn, i) => {
      btn.addEventListener('click', () => activate(i));
      // WAI-ARIA tabs pattern: arrow keys move between tabs, Home/End jump
      btn.addEventListener('keydown', (e) => {
        let next: number | null = null;
        if (e.key === 'ArrowRight') next = (i + 1) % buttons.length;
        else if (e.key === 'ArrowLeft') next = (i - 1 + buttons.length) % buttons.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = buttons.length - 1;
        if (next !== null) {
          e.preventDefault();
          activate(next);
          buttons[next]?.focus();
        }
      });
    });

    copyBtn?.addEventListener('click', async () => {
      if (!copyBtn) return;
      const live = copyBtn.querySelector('[aria-live]') ?? copyBtn;
      const active = panels.findIndex((panel) => !panel.classList.contains('hidden'));
      const text = panels[active]?.textContent?.trim() ?? '';
      const labels = {
        copy: copyBtn.dataset.copyLabel ?? 'Copy',
        copied: copyBtn.dataset.copiedLabel ?? 'Copied!',
        fallback: copyBtn.dataset.copyFallbackLabel ?? 'Copy failed',
      };
      let handle = 0;
      try {
        await navigator.clipboard.writeText(text);
        live.textContent = labels.copied;
      } catch {
        live.textContent = labels.fallback;
      }
      clearTimeout(Number(copyBtn.dataset.resetTimer ?? 0));
      handle = window.setTimeout(() => (live.textContent = labels.copy), 1500);
      copyBtn.dataset.resetTimer = String(handle);
    });
  });
</script>
