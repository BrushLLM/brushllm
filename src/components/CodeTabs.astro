---
export interface Tab {
  label: string;
  code: string;
}

interface Props {
  tabs: Tab[];
  class?: string;
}

const { tabs, class: className = '' } = Astro.props;
---

<div class:list={['overflow-hidden rounded-2xl border border-violet-100 bg-white shadow-lg shadow-violet-100/50', className]} data-codetabs>
  <div class="flex items-center justify-between gap-2 border-b border-violet-100 bg-gradient-to-r from-violet-50 via-fuchsia-50 to-orange-50 pl-2 pr-2 sm:pr-3">
    <div class="flex flex-wrap gap-1" role="tablist">
      {
        tabs.map((tab, i) => (
          <button type="button" class="tab-btn px-3 py-2.5 text-sm font-medium" data-tab={i} role="tab" aria-selected={i === 0 ? 'true' : 'false'}>
            {tab.label}
          </button>
        ))
      }
    </div>
    <button
      type="button"
      class="shrink-0 rounded-lg border border-violet-200 bg-white px-2.5 py-1.5 text-xs font-medium text-muted transition-colors hover:border-fuchsia-300 hover:text-brush-violet"
      data-copy
    >
      Copy
    </button>
  </div>
  {
    tabs.map((tab, i) => (
      <pre
        class:list={['overflow-x-auto p-4 font-mono text-[13px] leading-relaxed text-stone-800', i !== 0 && 'hidden']}
        data-panel={i}
      >
        <code>{tab.code}</code>
      </pre>
    ))
  }
</div>

<style>
  .tab-btn {
    color: var(--color-stone-500);
    border-bottom: 2px solid transparent;
    transition: color 0.15s;
  }
  .tab-btn:hover {
    color: var(--color-ink);
  }
  .tab-btn[aria-selected='true'] {
    color: var(--color-brush-violet);
    border-image: linear-gradient(90deg, #7c3aed, #d946ef, #f97316) 1;
    border-bottom-style: solid;
    border-bottom-width: 2px;
  }
</style>

<script>
  document.querySelectorAll<HTMLDivElement>('[data-codetabs]').forEach((root) => {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    const copyBtn = root.querySelector<HTMLButtonElement>('[data-copy]');

    const activate = (index: number) => {
      buttons.forEach((btn, i) => btn.setAttribute('aria-selected', String(i === index)));
      panels.forEach((panel, i) => panel.classList.toggle('hidden', i !== index));
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => activate(Number(btn.dataset.tab)));
    });

    copyBtn?.addEventListener('click', async () => {
      const active = panels.findIndex((panel) => !panel.classList.contains('hidden'));
      const text = panels[active]?.textContent?.trim() ?? '';
      try {
        await navigator.clipboard.writeText(text);
        copyBtn.textContent = 'Copied!';
      } catch {
        copyBtn.textContent = 'Press ⌘C';
      }
      setTimeout(() => (copyBtn.textContent = 'Copy'), 1500);
    });
  });
</script>
