---
export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  faqs: FaqItem[];
}

const { faqs } = Astro.props;
---

<div class="mx-auto max-w-3xl divide-y divide-stone-200 rounded-xl border border-stone-200 bg-white">
  {
    faqs.map((faq) => (
      <details class="faq group px-5 py-4 [&_summary::-webkit-details-marker]:hidden">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left font-medium">
          {faq.question}
          <svg
            class="h-4 w-4 shrink-0 text-stone-400 transition-transform group-open:rotate-45"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M12 5v14M5 12h14" />
          </svg>
        </summary>
        <p class="mt-3 text-sm leading-relaxed text-stone-600">{faq.answer}</p>
      </details>
    ))
  }
</div>
