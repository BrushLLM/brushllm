---
/**
 * Flat-head / block oil paint brush — BrushLLM's own mark, side view:
 * a narrow handle, a metal ferrule with crimp grooves, and a wide bristle
 * block with a SQUARE-CUT edge, pressing a flat, same-width stripe of paint.
 * Horizontal orientation so the "flat wall brush" silhouette reads even at
 * small sizes. currentColor; grooves/parting lines are translucent black.
 */
interface Props {
  class?: string;
}

const { class: className = 'h-7 w-7' } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <!-- handle -->
  <rect x="0.8" y="9.2" width="9.2" height="3.6" rx="1.8" fill="currentColor" opacity="0.92"></rect>
  <!-- ferrule with crimp grooves -->
  <rect x="10.4" y="8.2" width="4.6" height="5.6" rx="0.8" fill="currentColor" opacity="0.62"></rect>
  <rect x="11.3" y="8.7" width="0.5" height="4.6" rx="0.25" fill="#000" opacity="0.18"></rect>
  <rect x="13.0" y="8.7" width="0.5" height="4.6" rx="0.25" fill="#000" opacity="0.18"></rect>
  <!-- bristle block: wide, square-cut bottom edge -->
  <rect x="15.0" y="7.0" width="7.8" height="8.4" rx="0.5" fill="currentColor"></rect>
  <!-- bristle parting lines -->
  <rect x="17.0" y="7.6" width="0.55" height="7.2" fill="#000" opacity="0.18"></rect>
  <rect x="19.6" y="7.6" width="0.55" height="7.2" fill="#000" opacity="0.18"></rect>
  <!-- flat paint stripe just laid down behind the brush -->
  <rect x="6.4" y="15.8" width="16.4" height="5.4" rx="1.2" fill="currentColor" opacity="0.85"></rect>
</svg>
