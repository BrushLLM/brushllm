---
/**
 * Flat paint brush (flat-head oil paint brush) — BrushLLM's own mark.
 * Angled handle + ferrule + flat bristle block with notched bristle tips,
 * plus a fresh dab of paint. Uses currentColor; notches are transparent,
 * so it sits correctly on any background.
 */
interface Props {
  class?: string;
}

const { class: className = 'h-7 w-7' } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <g transform="rotate(-45 16 16)">
    <!-- handle -->
    <rect x="13.6" y="1.5" width="4.8" height="9" rx="2.4" fill="currentColor" opacity="0.9"></rect>
    <!-- ferrule -->
    <rect x="12.4" y="10.8" width="7.2" height="3.2" rx="1.1" fill="currentColor" opacity="0.72"></rect>
    <!-- flat bristle block with notched tips (transparent gaps) -->
    <path
      d="M11.4 14.4H20.6V21.4H19.6L19 19.4L18.4 21.4H17.1L16.5 19.4L15.9 21.4H14.6L14 19.4L13.4 21.4H11.4Z"
      fill="currentColor"
    ></path>
  </g>
  <!-- paint swipe under the tip -->
  <path d="M6.5 27.5q5 2.4 10-0.4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
  <circle cx="20" cy="9" r="1.3" fill="currentColor" opacity="0.75"></circle>
</svg>
