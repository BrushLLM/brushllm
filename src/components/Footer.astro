---
import { Mail, ArrowUpRight } from '@lucide/astro';
import { LINKS, SITE, type LocaleCode } from '../config';
import { getDictionary, localePath } from '../i18n';
import Logo from './Logo.astro';

interface Props {
  locale?: LocaleCode;
}

const { locale = 'en' } = Astro.props;
const t = await getDictionary(locale);
const year = new Date().getFullYear();

const productLinks = [
  { label: t.nav.models, href: localePath(locale, '/models') },
  { label: t.nav.pricing, href: localePath(locale, '/pricing') },
  { label: t.footer.imageStudio, href: localePath(locale, '/studio') },
  { label: t.footer.videoStudio, href: localePath(locale, '/video-studio') },
  { label: t.footer.player, href: localePath(locale, '/player') },
  { label: t.nav.docs, href: localePath(locale, '/docs') },
  { label: t.nav.about, href: localePath(locale, '/about') },
];
---

<footer class="border-t border-stone-200 bg-white">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <a href={localePath(locale, '/')} class="inline-flex items-center" aria-label={t.header.home}>
          <Logo />
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">{t.footer.blurb}</p>
        <p class="mt-4 text-sm text-stone-500">{t.footer.tagline}</p>
      </div>

      <nav aria-label={t.footer.product}>
        <h3 class="font-display text-sm font-semibold">{t.footer.product}</h3>
        <ul class="mt-3 space-y-2 text-sm">
          {
            productLinks.map((link) => (
              <li>
                <a href={link.href} class="text-muted transition-colors hover:text-brush-violet">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label={t.footer.console}>
        <h3 class="font-display text-sm font-semibold">{t.footer.console}</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href={LINKS.signIn} class="text-muted transition-colors hover:text-brush-violet">{t.header.logIn}</a></li>
          <li><a href={LINKS.signUp} class="text-muted transition-colors hover:text-brush-violet">{t.header.getStarted}</a></li>
          <li>
            <a href={LINKS.apiBase} class="break-all text-muted transition-colors hover:text-brush-violet" rel="noopener">
              {LINKS.apiBase}
            </a>
          </li>
        </ul>
      </nav>

      <nav aria-label={t.footer.company}>
        <h3 class="font-display text-sm font-semibold">{t.footer.company}</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a href={`mailto:${SITE.contactEmail}`} class="inline-flex items-center gap-1.5 text-muted transition-colors hover:text-brush-violet">
              <Mail class="h-3.5 w-3.5" aria-hidden="true" />
              {SITE.contactEmail}
            </a>
          </li>
          <li>
            <a href={localePath(locale, '/about')} class="inline-flex items-center gap-1.5 text-muted transition-colors hover:text-brush-violet">
              {t.footer.aboutBrushLLM}
              <ArrowUpRight class="h-3.5 w-3.5" aria-hidden="true" />
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-stone-100 pt-6 text-sm text-stone-500 sm:flex-row sm:items-center">
      <p>{t.footer.copyright.replace('{year}', String(year))}</p>
      <p>{t.footer.poweredBy}</p>
    </div>
  </div>
</footer>
