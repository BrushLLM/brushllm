---
import { Mail, ArrowUpRight } from '@lucide/astro';
import { LINKS, NAV, SITE } from '../config';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-stone-200 bg-white">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <a href="/" class="inline-flex items-center" aria-label="BrushLLM home">
          <Logo />
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">
          The source of China’s frontier AI — affordable, reliable, and open to developers in
          every country through one OpenAI-compatible endpoint. We protect your privacy: no
          trackers, no analytics, no ads.
        </p>
        <p class="mt-4 text-sm text-stone-400">One endpoint · Honest prices · Privacy-first</p>
      </div>

      <nav aria-label="Product">
        <h3 class="font-display text-sm font-semibold">Product</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/models" class="text-muted transition-colors hover:text-brush-violet">Models</a></li>
          <li><a href="/pricing" class="text-muted transition-colors hover:text-brush-violet">Pricing</a></li>
          <li>
            <a href="/studio" class="inline-flex items-center gap-1.5 text-muted transition-colors hover:text-brush-violet">
              Image Studio
              <span class="rounded-full bg-brush-fuchsia px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-white">Soon</span>
            </a>
          </li>
          <li><a href="/docs" class="text-muted transition-colors hover:text-brush-violet">Docs</a></li>
          <li><a href="/about" class="text-muted transition-colors hover:text-brush-violet">About</a></li>
        </ul>
      </nav>

      <nav aria-label="Console">
        <h3 class="font-display text-sm font-semibold">Console</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href={LINKS.signIn} class="text-muted transition-colors hover:text-brush-violet">Sign in</a></li>
          <li><a href={LINKS.signUp} class="text-muted transition-colors hover:text-brush-violet">Get API Key</a></li>
          <li>
            <a href={LINKS.apiBase} class="break-all text-muted transition-colors hover:text-brush-violet" rel="noopener">
              {LINKS.apiBase}
            </a>
          </li>
        </ul>
      </nav>

      <nav aria-label="Company">
        <h3 class="font-display text-sm font-semibold">Company</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a href={`mailto:${SITE.contactEmail}`} class="inline-flex items-center gap-1.5 text-muted transition-colors hover:text-brush-violet">
              <Mail class="h-3.5 w-3.5" aria-hidden="true" />
              {SITE.contactEmail}
            </a>
          </li>
          <li>
            <a href="/about" class="inline-flex items-center gap-1.5 text-muted transition-colors hover:text-brush-violet">
              About BrushLLM
              <ArrowUpRight class="h-3.5 w-3.5" aria-hidden="true" />
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-stone-100 pt-6 text-sm text-stone-500 sm:flex-row sm:items-center">
      <p>© {year} BrushLLM · brushllm.com</p>
      <p>Powered by an OpenAI-compatible gateway</p>
    </div>
  </div>
</footer>
