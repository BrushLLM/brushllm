---
import { LINKS, NAV, SITE } from '../config';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-stone-200 bg-white">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <a href="/" class="inline-flex items-center" aria-label="BrushLLM home">
          <Logo />
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-stone-600">
          One OpenAI-compatible endpoint for frontier models from China’s leading AI labs. Built for
          developers everywhere.
        </p>
        <p class="mt-4 font-sans text-sm text-stone-400">中国大模型 · One endpoint</p>
      </div>

      <nav aria-label="Product">
        <h3 class="text-sm font-semibold">Product</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/models" class="text-stone-600 hover:text-accent">Models</a></li>
          <li><a href="/pricing" class="text-stone-600 hover:text-accent">Pricing</a></li>
          <li><a href="/docs" class="text-stone-600 hover:text-accent">Docs</a></li>
          <li><a href="/news" class="text-stone-600 hover:text-accent">News</a></li>
          <li><a href="/about" class="text-stone-600 hover:text-accent">About</a></li>
        </ul>
      </nav>

      <nav aria-label="Console">
        <h3 class="text-sm font-semibold">Console</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href={LINKS.signIn} class="text-stone-600 hover:text-accent">Sign in</a></li>
          <li><a href={LINKS.signUp} class="text-stone-600 hover:text-accent">Get API Key</a></li>
          <li>
            <a href={LINKS.apiBase} class="break-all text-stone-600 hover:text-accent" rel="noopener">
              {LINKS.apiBase}
            </a>
          </li>
        </ul>
      </nav>

      <nav aria-label="Company">
        <h3 class="text-sm font-semibold">Company</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a href={`mailto:${SITE.contactEmail}`} class="text-stone-600 hover:text-accent">
              {SITE.contactEmail}
            </a>
          </li>
          <li><a href="/about" class="text-stone-600 hover:text-accent">About BrushLLM</a></li>
        </ul>
      </nav>
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-stone-100 pt-6 text-sm text-stone-500 sm:flex-row sm:items-center">
      <p>© {year} BrushLLM · brushllm.com</p>
      <p>Powered by an OpenAI-compatible gateway</p>
    </div>
  </div>
</footer>
