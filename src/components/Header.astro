---
import { Menu, X, ArrowRight } from '@lucide/astro';
import { LINKS, NAV, type LocaleCode } from '../config';
import { getDictionary, localePath, stripLocale } from '../i18n';
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale?: LocaleCode;
}

const { locale = 'en' } = Astro.props;
const t = await getDictionary(locale);

const navItems = NAV.map((item) => ({
  ...item,
  label: t.nav[item.label as keyof typeof t.nav] ?? item.label,
  href: localePath(locale, item.href),
}));

const path = stripLocale(Astro.url.pathname);
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---

<header class="sticky top-0 z-40 border-b border-stone-200/70 bg-white/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href={localePath(locale, '/')} class="flex shrink-0 items-center" aria-label={t.header.home}>
      <Logo />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label={t.header.mainNav}>
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'flex items-center rounded-chip px-3 py-2 text-sm font-medium transition-colors',
              isActive(item.href)
                ? 'bg-stone-100 text-brush-violet'
                : 'text-muted hover:bg-stone-100 hover:text-ink',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a
        href="https://github.com/BrushLLM"
        class="inline-flex h-9 w-9 items-center justify-center rounded-chip text-muted transition-colors hover:bg-stone-100 hover:text-ink"
        aria-label="GitHub"
        rel="noopener"
        target="_blank"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
        </svg>
      </a>
      <LanguageSwitcher locale={locale} />
      <a
        href={LINKS.signIn}
        class="rounded-chip px-3 py-2 text-sm font-medium text-muted transition-colors hover:text-ink"
      >
        {t.header.logIn}
      </a>
      <a
        href={LINKS.signUp}
        class="group inline-flex items-center gap-1.5 rounded-control bg-brush-violet px-4 py-2 text-sm font-semibold text-white shadow-brand transition hover:bg-violet-700"
      >
        {t.header.getStarted}
        <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
      </a>
    </div>

    <button
      id="menu-btn"
      class="inline-flex h-10 w-10 items-center justify-center rounded-chip text-muted hover:bg-stone-100 lg:hidden"
      aria-label={t.header.toggleMenu}
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Menu id="icon-open" class="h-5 w-5" aria-hidden="true" />
      <X id="icon-close" class="hidden h-5 w-5" aria-hidden="true" />
    </button>
  </div>

  <!-- mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-stone-200 bg-white px-4 pb-4 pt-2 lg:hidden">
    <nav class="flex flex-col gap-1" aria-label={t.header.mobileNav}>
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'flex items-center gap-2 rounded-chip px-3 py-2.5 text-sm font-medium',
              isActive(item.href)
                ? 'bg-stone-100 text-brush-violet'
                : 'text-muted hover:bg-stone-100 hover:text-ink',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="mt-3 flex flex-col gap-2">
      <a
        href="https://github.com/BrushLLM"
        class="flex items-center gap-2 rounded-chip px-3 py-2.5 text-sm font-medium text-muted hover:bg-stone-100 hover:text-ink"
        rel="noopener"
        target="_blank"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
        </svg>
        GitHub
      </a>
      <a
        href={LINKS.signUp}
        class="rounded-control bg-brush-violet px-4 py-2.5 text-center text-sm font-semibold text-white shadow-brand hover:bg-violet-700"
      >
        {t.header.getStarted}
      </a>
      <a
        href={LINKS.signIn}
        class="rounded-control border border-violet-200 px-4 py-2.5 text-center text-sm font-medium text-muted hover:bg-violet-50"
      >
        {t.header.logIn}
      </a>
    </div>
    <div class="mt-3 border-t border-stone-100 pt-3">
      <LanguageSwitcher locale={locale} compact />
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  });
</script>
