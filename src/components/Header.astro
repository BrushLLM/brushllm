---
import { Menu, X, ArrowRight } from 'lucide-astro';
import { LINKS, NAV } from '../config';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<!-- announcement bar -->
<div class="bg-brush px-4 py-2 text-center text-sm text-white">
  <p class="font-medium">
    New — Kimi K2 Thinking &amp; Qwen3-Max are live.
    {' '}<a href="/models" class="font-semibold underline underline-offset-2">Browse models →</a>
  </p>
</div>

<header class="sticky top-0 z-40 border-b border-violet-100/70 bg-white/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="flex shrink-0 items-center" aria-label="BrushLLM home">
      <Logo />
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
              isActive(item.href)
                ? 'bg-brush-soft text-brush-violet'
                : 'text-muted hover:bg-violet-50 hover:text-ink',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-2 md:flex">
      <a
        href={LINKS.signIn}
        class="rounded-lg px-3 py-2 text-sm font-medium text-muted transition-colors hover:text-ink"
      >
        Sign in
      </a>
      <a
        href={LINKS.signUp}
        class="bg-brush group inline-flex items-center gap-1.5 rounded-xl px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-fuchsia-500/25 transition hover:brightness-110"
      >
        Get API Key
        <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
      </a>
    </div>

    <button
      id="menu-btn"
      class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-muted hover:bg-violet-50 md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Menu id="icon-open" class="h-5 w-5" aria-hidden="true" />
      <X id="icon-close" class="hidden h-5 w-5" aria-hidden="true" />
    </button>
  </div>

  <!-- mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-violet-100 bg-white px-4 pb-4 pt-2 md:hidden">
    <nav class="flex flex-col gap-1" aria-label="Mobile">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-lg px-3 py-2.5 text-sm font-medium',
              isActive(item.href)
                ? 'bg-brush-soft text-brush-violet'
                : 'text-muted hover:bg-violet-50 hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="mt-3 flex flex-col gap-2">
      <a
        href={LINKS.signUp}
        class="bg-brush rounded-xl px-4 py-2.5 text-center text-sm font-semibold text-white shadow-lg shadow-fuchsia-500/25 hover:brightness-110"
      >
        Get API Key
      </a>
      <a
        href={LINKS.signIn}
        class="rounded-xl border border-violet-200 px-4 py-2.5 text-center text-sm font-medium text-muted hover:bg-violet-50"
      >
        Sign in
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  });
</script>
