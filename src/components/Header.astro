---
import { Menu, X, ArrowRight } from '@lucide/astro';
import { LINKS, NAV } from '../config';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<!-- announcement bar: white canvas, color in the marks -->
<div class="border-b border-stone-100 bg-white px-4 py-2 text-center text-sm">
  <p class="font-medium text-muted">
    <span class="rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-semibold text-amber-700">New</span>
    {' '}BrushLLM Image Studio is on the way — AI image creation and editing in your browser.
    {' '}<a href="/studio" class="font-semibold text-brush-violet hover:underline">Get early access →</a>
  </p>
</div>

<header class="sticky top-0 z-40 border-b border-stone-200/70 bg-white/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="flex shrink-0 items-center" aria-label="BrushLLM home">
      <Logo />
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              'flex items-center rounded-lg px-3 py-2 text-sm font-medium transition-colors',
              isActive(item.href)
                ? 'bg-stone-100 text-brush-violet'
                : 'text-muted hover:bg-stone-100 hover:text-ink',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
            {item.badge && (
              <span class="ml-1 rounded-full bg-brush-fuchsia px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-white">
                {item.badge}
              </span>
            )}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-2 md:flex">
      <a
        href={LINKS.signIn}
        class="rounded-lg px-3 py-2 text-sm font-medium text-muted transition-colors hover:text-ink"
      >
        Sign in
      </a>
      <a
        href={LINKS.signUp}
        class="group inline-flex items-center gap-1.5 rounded-xl bg-brush-violet px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-violet-500/25 transition hover:bg-violet-700"
      >
        Get API Key
        <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
      </a>
    </div>

    <button
      id="menu-btn"
      class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-muted hover:bg-stone-100 md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Menu id="icon-open" class="h-5 w-5" aria-hidden="true" />
      <X id="icon-close" class="hidden h-5 w-5" aria-hidden="true" />
    </button>
  </div>

  <!-- mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-stone-200 bg-white px-4 pb-4 pt-2 md:hidden">
    <nav class="flex flex-col gap-1" aria-label="Mobile">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              'flex items-center gap-2 rounded-lg px-3 py-2.5 text-sm font-medium',
              isActive(item.href)
                ? 'bg-stone-100 text-brush-violet'
                : 'text-muted hover:bg-stone-100 hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="mt-3 flex flex-col gap-2">
      <a
        href={LINKS.signUp}
        class="rounded-xl bg-brush-violet px-4 py-2.5 text-center text-sm font-semibold text-white shadow-lg shadow-violet-500/25 hover:bg-violet-700"
      >
        Get API Key
      </a>
      <a
        href={LINKS.signIn}
        class="rounded-xl border border-violet-200 px-4 py-2.5 text-center text-sm font-medium text-muted hover:bg-violet-50"
      >
        Sign in
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  });
</script>
