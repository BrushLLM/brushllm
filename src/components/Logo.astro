---
import siteIcon from '../assets/site-icon.svg?url';

interface Props {
  class?: string;
}

const { class: className = 'h-9 w-9' } = Astro.props;
---

<span class="inline-flex items-center gap-2.5">
  <img src={siteIcon} alt="" aria-hidden="true" width="36" height="36" class:list={['inline-block align-middle rounded-xl', className]} />
  <span class="font-display text-xl font-bold tracking-tight">
    Brush<span class="text-brush-violet">LLM</span>
  </span>
</span>
