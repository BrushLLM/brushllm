---
import { Brush } from 'lucide-astro';

interface Props {
  class?: string;
}

const { class: className = 'h-7 w-7' } = Astro.props;
---

<span class="inline-flex items-center gap-2.5">
  <span class="bg-brush flex h-9 w-9 items-center justify-center rounded-xl text-white shadow-lg shadow-fuchsia-500/25">
    <Brush class={className} stroke-width={2} aria-hidden="true" />
  </span>
  <span class="font-display text-xl font-bold tracking-tight">
    Brush<span class="text-brush">LLM</span>
  </span>
</span>
