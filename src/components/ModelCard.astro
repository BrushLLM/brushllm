---
import { ArrowRight } from '@lucide/astro';
import { LINKS } from '../config';
import { capabilityLabels, bestForLabels, formatContext, formatPrice, type Model } from '../data/models';
import { providers } from '../data/providers';

interface Props {
  model: Model;
}

const { model } = Astro.props;
const provider = providers.find((p) => p.id === model.provider)!;
const isImage = model.capabilities.includes('image');
const searchText = `${model.name} ${model.id} ${provider.name} ${model.description} ${model.capabilities
  .map((cap) => capabilityLabels[cap])
  .join(' ')} ${(model.bestFor ?? []).map((tag) => bestForLabels[tag]).join(' ')}`.toLowerCase();
---

<article
  class="model-card group flex flex-col rounded-2xl border border-stone-200 bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-blue-300 hover:shadow-lg hover:shadow-blue-100"
  data-provider={model.provider}
  data-capabilities={model.capabilities.join(',')}
  data-bestfor={(model.bestFor ?? []).join(',')}
  data-search={searchText}
>
  <p class="text-xs font-medium text-muted">{provider.name}</p>
  <div class="mt-1.5 flex items-center gap-2">
    <h3 class="font-semibold leading-snug">{model.name}</h3>
    {
      model.featured && (
        <span class="rounded-full bg-brush-fuchsia px-2.5 py-0.5 text-[11px] font-semibold text-white shadow-sm shadow-fuchsia-500/25">
          Featured
        </span>
      )
    }
  </div>

  <p class="mt-2 text-sm leading-relaxed text-muted">{model.description}</p>

  <div class="mt-3 flex flex-wrap gap-1.5">
    {
      model.capabilities.map((cap) => (
        <span class="rounded-full border border-stone-200 bg-stone-50 px-2 py-0.5 text-[11px] font-medium text-brush-blue">
          {capabilityLabels[cap]}
        </span>
      ))
    }
  </div>

  {
    isImage ? (
      <dl class="mt-4 grid grid-cols-3 gap-2 border-t border-stone-100 pt-3 text-center">
        <div>
          <dt class="text-[11px] font-medium uppercase tracking-wide text-stone-400">Type</dt>
          <dd class="mt-0.5 text-sm font-semibold">Text-to-Image</dd>
        </div>
        <div>
          <dt class="text-[11px] font-medium uppercase tracking-wide text-stone-400">Per image</dt>
          <dd class="mt-0.5 text-sm font-semibold">{formatPrice(model.imagePrice)}</dd>
        </div>
        <div>
          <dt class="text-[11px] font-medium uppercase tracking-wide text-stone-400">Output</dt>
          <dd class="mt-0.5 text-sm font-semibold">{model.resolution ?? '—'}</dd>
        </div>
      </dl>
    ) : (
      <dl class="mt-4 grid grid-cols-3 gap-2 border-t border-stone-100 pt-3 text-center">
        <div>
          <dt class="text-[11px] font-medium uppercase tracking-wide text-stone-400">Context</dt>
          <dd class="mt-0.5 text-sm font-semibold">{formatContext(model.context)}</dd>
        </div>
        <div>
          <dt class="text-[11px] font-medium uppercase tracking-wide text-stone-400">Input / 1M</dt>
          <dd class="mt-0.5 text-sm font-semibold">{formatPrice(model.price.input)}</dd>
        </div>
        <div>
          <dt class="text-[11px] font-medium uppercase tracking-wide text-stone-400">Output / 1M</dt>
          <dd class="mt-0.5 text-sm font-semibold">{formatPrice(model.price.output)}</dd>
        </div>
      </dl>
    )
  }

  <div class="mt-4 flex items-center justify-between gap-2 border-t border-stone-100 pt-4">
    <code class="truncate rounded-lg bg-stone-100 px-2 py-1 font-mono text-xs text-stone-700" title={model.id}>
      {model.id}
    </code>
    <a href={LINKS.console} class="inline-flex shrink-0 items-center gap-1 text-sm font-semibold text-brush-blue hover:text-blue-700">
      Try it
      <ArrowRight class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
    </a>
  </div>
</article>
