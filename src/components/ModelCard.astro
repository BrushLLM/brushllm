---
import { ArrowRight } from '@lucide/astro';
import { LINKS, type LocaleCode } from '../config';
import { capabilityLabels, bestForLabels, formatContext, formatPrice, type Model } from '../data/models';
import { providers } from '../data/providers';
import { getDictionary } from '../i18n';

interface Props {
  model: Model;
  locale?: LocaleCode;
}

const { model, locale = 'en' } = Astro.props;
const t = await getDictionary(locale);
const m = t.pages.models.card;
const provider = providers.find((p) => p.id === model.provider)!;
const isImage = model.capabilities.includes('image');
const localizedCapability: Record<string, string> = t.data.capability;
const localizedBestFor: Record<string, string> = Object.fromEntries(
  Object.entries(bestForLabels).map(([key, value]) => [key, value]),
);
const description = (t.data.models as Record<string, string>)[model.id] ?? model.description;
const searchText = `${model.name} ${model.id} ${provider.name} ${description} ${model.capabilities
  .map((cap) => localizedCapability[cap] ?? capabilityLabels[cap])
  .join(' ')} ${(model.bestFor ?? []).map((tag) => bestForLabels[tag]).join(' ')}`.toLowerCase();
---

<article
  class="model-card group flex flex-col rounded-card border border-stone-200 bg-white p-5 shadow-soft transition duration-200 hover:border-violet-300 hover:shadow-card"
  data-provider={model.provider}
  data-capabilities={model.capabilities.join(',')}
  data-bestfor={(model.bestFor ?? []).join(',')}
  data-search={searchText}
>
  <p class="text-xs font-medium text-muted">{provider.name}</p>
  <div class="mt-1.5 flex items-center gap-2">
    <h3 class="font-semibold leading-snug">{model.name}</h3>
    {
      model.featured && (
        <span class="rounded-full bg-brush-orange px-2.5 py-0.5 text-[11px] font-semibold text-ink shadow-card">
          {t.common.featured}
        </span>
      )
    }
  </div>

  <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-muted">{description}</p>

  <div class="mt-3 flex flex-wrap gap-1.5">
    {
      model.capabilities.map((cap) => (
        <span class="rounded-full border border-stone-200 bg-stone-50 px-2 py-0.5 text-[11px] font-medium text-brush-violet">
          {localizedCapability[cap] ?? capabilityLabels[cap]}
        </span>
      ))
    }
  </div>

  {
    isImage ? (
      <dl class="mt-3 grid grid-cols-3 gap-2 border-t border-stone-100 pt-3 text-center">
        <div>
          <dt class="text-[11px] font-medium text-stone-500">{m.type}</dt>
          <dd class="mt-0.5 text-sm font-semibold">{provider.name}</dd>
        </div>
        <div>
          <dt class="text-[11px] font-medium text-stone-500">{m.perImage}</dt>
          <dd class="mt-0.5 text-sm font-semibold tabular-nums">{formatPrice(model.imagePrice, t.common.free)}<span class="block text-[11px] font-normal text-stone-500 line-through">{formatPrice(model.listImagePrice, t.common.free)} list</span></dd>
        </div>
        <div>
          <dt class="text-[11px] font-medium text-stone-500">{m.output}</dt>
          <dd class="mt-0.5 text-sm font-semibold tabular-nums">{model.resolution ?? '—'}</dd>
        </div>
      </dl>
    ) : (
      <dl class="mt-3 grid grid-cols-3 gap-2 border-t border-stone-100 pt-3 text-center">
        <div>
          <dt class="text-[11px] font-medium text-stone-500">{m.context}</dt>
          <dd class="mt-0.5 text-sm font-semibold tabular-nums">{formatContext(model.context)}</dd>
        </div>
        <div>
          <dt class="text-[11px] font-medium text-stone-500">{m.input}</dt>
          <dd class="mt-0.5 text-sm font-semibold tabular-nums">{formatPrice(model.price.input, t.common.free)}<span class="block text-[11px] font-normal text-stone-500 line-through">{formatPrice(model.listPrice.input, t.common.free)} list</span></dd>
        </div>
        <div>
          <dt class="text-[11px] font-medium text-stone-500">{m.outputPer1M}</dt>
          <dd class="mt-0.5 text-sm font-semibold tabular-nums">{formatPrice(model.price.output, t.common.free)}<span class="block text-[11px] font-normal text-stone-500 line-through">{formatPrice(model.listPrice.output, t.common.free)} list</span></dd>
        </div>
      </dl>
    )
  }

  <div class="mt-4 flex items-center justify-between gap-2 border-t border-stone-100 pt-4">
    <code class="truncate rounded-chip bg-stone-100 px-2 py-1 font-mono text-xs text-stone-700" title={model.id}>
      {model.id}
    </code>
    <a href={LINKS.console} class="inline-flex shrink-0 items-center gap-1 text-sm font-semibold text-brush-violet hover:text-violet-700">
      {t.common.tryIt}
      <ArrowRight class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
    </a>
  </div>
</article>
