---
import { LINKS } from '../config';
import { capabilityLabels, formatContext, formatPrice, type Model } from '../data/models';
import { providers } from '../data/providers';

interface Props {
  model: Model;
}

const { model } = Astro.props;
const provider = providers.find((p) => p.id === model.provider)!;
const searchText = `${model.name} ${model.id} ${provider.name} ${provider.nameZh} ${model.description}`.toLowerCase();
---

<article
  class="model-card flex flex-col rounded-xl border border-stone-200 bg-white p-5 transition hover:border-accent/40 hover:shadow-sm"
  data-provider={model.provider}
  data-search={searchText}
>
  <p class="text-xs font-medium text-stone-500">
    {provider.name} <span class="text-stone-400">· {provider.nameZh}</span>
  </p>
  <div class="mt-1 flex items-center gap-2">
    <h3 class="font-semibold leading-snug">{model.name}</h3>
    {model.featured && <span class="rounded-full bg-accent-soft px-2 py-0.5 text-[11px] font-semibold text-accent">Featured</span>}
  </div>

  <p class="mt-2 text-sm leading-relaxed text-stone-600">{model.description}</p>

  <div class="mt-3 flex flex-wrap gap-1.5">
    {
      model.capabilities.map((cap) => (
        <span class="rounded-full border border-stone-200 bg-stone-50 px-2 py-0.5 text-[11px] font-medium text-stone-600">
          {capabilityLabels[cap]}
        </span>
      ))
    }
  </div>

  <dl class="mt-4 grid grid-cols-3 gap-2 border-t border-stone-100 pt-3 text-center">
    <div>
      <dt class="text-[11px] font-medium uppercase tracking-wide text-stone-400">Context</dt>
      <dd class="mt-0.5 text-sm font-semibold">{formatContext(model.context)}</dd>
    </div>
    <div>
      <dt class="text-[11px] font-medium uppercase tracking-wide text-stone-400">Input / 1M</dt>
      <dd class="mt-0.5 text-sm font-semibold">{formatPrice(model.price.input)}</dd>
    </div>
    <div>
      <dt class="text-[11px] font-medium uppercase tracking-wide text-stone-400">Output / 1M</dt>
      <dd class="mt-0.5 text-sm font-semibold">{formatPrice(model.price.output)}</dd>
    </div>
  </dl>

  <div class="mt-4 flex items-center justify-between gap-2 border-t border-stone-100 pt-4">
    <code class="truncate rounded-md bg-stone-100 px-2 py-1 font-mono text-xs text-stone-700" title={model.id}>
      {model.id}
    </code>
    <a href={LINKS.console} class="shrink-0 text-sm font-medium text-accent hover:text-accent-strong">
      Try it →
    </a>
  </div>
</article>
