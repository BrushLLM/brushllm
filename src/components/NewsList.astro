---
import { ArrowRight } from '@lucide/astro';
import { formatDate, news } from '../data/news';

interface Props {
  limit?: number;
}

const { limit } = Astro.props;
const items = limit ? news.slice(0, limit) : news;

const pillColors = [
  'bg-violet-100 text-violet-700',
  'bg-fuchsia-100 text-fuchsia-700',
  'bg-orange-100 text-orange-700',
  'bg-cyan-100 text-cyan-700',
  'bg-rose-100 text-rose-700',
  'bg-amber-100 text-amber-700',
] as const;
---

<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
  {
    items.map((item, i) => (
      <article class="group flex flex-col rounded-2xl border border-stone-200 bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-violet-300 hover:shadow-lg hover:shadow-violet-100">
        <time class={`w-fit rounded-full px-2.5 py-1 text-[11px] font-semibold ${pillColors[i % pillColors.length]}`} datetime={item.date}>
          {formatDate(item.date)}
        </time>
        <h3 class="mt-3 leading-snug font-semibold">
          <a href={`/news/${item.slug}`} class="inline-flex items-start gap-1 transition-colors group-hover:text-brush-violet">
            {item.title}
            <ArrowRight class="mt-1 h-3.5 w-3.5 shrink-0 opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true" />
          </a>
        </h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">{item.summary}</p>
        <a href={`/news/${item.slug}`} class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brush-violet opacity-0 transition-opacity group-hover:opacity-100">
          Read more
          <ArrowRight class="h-3.5 w-3.5" aria-hidden="true" />
        </a>
      </article>
    ))
  }
</div>
