---
import { formatDate, news } from '../data/news';

interface Props {
  limit?: number;
}

const { limit } = Astro.props;
const items = limit ? news.slice(0, limit) : news;
---

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {
    items.map((item) => (
      <article class="group flex flex-col rounded-xl border border-stone-200 bg-white p-5 transition hover:border-accent/40 hover:shadow-sm">
        <time class="text-xs font-medium uppercase tracking-wider text-stone-400" datetime={item.date}>
          {formatDate(item.date)}
        </time>
        <h3 class="mt-2 leading-snug font-semibold">
          {item.link ? (
            <a href={item.link} class="transition-colors group-hover:text-accent">
              {item.title}
            </a>
          ) : (
            item.title
          )}
        </h3>
        <p class="mt-2 text-sm leading-relaxed text-stone-600">{item.summary}</p>
      </article>
    ))
  }
</div>
