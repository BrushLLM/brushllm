---
/**
 * Provider brand mark: official vector SVG where a public icon exists,
 * an official raster mark (transparent PNG) for GLM, otherwise a neutral dot.
 */
import deepseek from '../assets/brands/deepseek.svg?raw';
import qwen from '../assets/brands/qwen.svg?raw';
import kimi from '../assets/brands/kimi.svg?raw';
import doubao from '../assets/brands/doubao.svg?raw';
import minimax from '../assets/brands/minimax.svg?raw';
import openai from '../assets/brands/openai.svg?raw';
import glm from '../assets/brands/glm.svg?raw';

const brandIcons: Record<string, string> = {
  deepseek,
  qwen,
  kimi,
  doubao, // ByteDance mark (Doubao's parent)
  minimax,
  openai, // ChatGPT / GPT-Image
  glm, // official raster mark wrapped in an inline svg
};

interface Props {
  provider: string;
  class?: string;
}

const { provider, class: className = 'h-5 w-5' } = Astro.props;
const icon = brandIcons[provider];
---

{
  icon ? (
    <span
      class:list={['inline-flex [&_svg]:h-full [&_svg]:w-full', className]}
      set:html={icon}
      aria-hidden="true"
    />
  ) : (
    <span class="inline-flex h-5 w-5 rounded-full bg-stone-200" aria-hidden="true" />
  )
}
