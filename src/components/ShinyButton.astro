---
/**
 * Primary CTA button. Quiet and disciplined: solid fill, brand shadow,
 * color-only hover — no orbiting-light gimmicks, no layout-shifting motion.
 * The API (bg / hoverBg / shadowColor / class) is unchanged so existing
 * call sites keep working, including the ink-text override on accent fills.
 */
interface Props {
  href: string;
  /** base face color class, e.g. bg-brush-violet */
  bg?: string;
  /** hover face color class, e.g. group-hover:bg-violet-700 */
  hoverBg?: string;
  /** shadow class, e.g. shadow-brand */
  shadowColor?: string;
  class?: string;
}

const {
  href,
  bg = 'bg-brush-violet',
  hoverBg = 'group-hover:bg-violet-700',
  shadowColor = 'shadow-brand',
  class: className = '',
} = Astro.props;
---

<a
  href={href}
  class:list={[
    'group inline-flex w-full items-center justify-center gap-2 rounded-control px-8 py-4 text-base font-semibold whitespace-nowrap text-white transition-colors duration-200 sm:w-auto',
    bg,
    hoverBg,
    shadowColor,
    className,
  ]}
>
  <slot />
</a>
