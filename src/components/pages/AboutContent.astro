---
import { ArrowRight, EyeOff, Globe2, Paintbrush, Tag } from '@lucide/astro';
import BrushStroke from '../BrushStroke.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LINKS, SITE, type LocaleCode } from '../../config';
import { models } from '../../data/models';
import { apps } from '../../data/apps';
import { visibleProviders } from '../../data/providers';
import { getDictionary, localePath } from '../../i18n';

interface Props {
  locale?: LocaleCode;
}

const { locale = 'en' } = Astro.props;
const t = await getDictionary(locale);
const a = t.pages.about;
const L = (path: string) => localePath(locale, path);

const valueIcons = [Globe2, Paintbrush, Tag, EyeOff];
const values = a.values.map((value, i) => ({
  icon: valueIcons[i % valueIcons.length],
  ...value,
  tile: ['bg-brush-violet text-white shadow-brand', 'bg-brush-orange text-ink shadow-lift', 'bg-brush-mint text-ink shadow-lift', 'bg-brush-violet text-white shadow-brand'][i % 4],
}));
---

<BaseLayout locale={locale} title={t.nav.about} description={a.metaDescription}>
  <section class="relative mx-auto max-w-4xl overflow-hidden px-4 py-16 sm:px-6">
    <BrushStroke shape="sweep" color="violet" class="pointer-events-none absolute -top-10 -right-44 w-[620px] rotate-2 opacity-15" />

    <p class="text-sm font-semibold text-brush-violet">{a.eyebrow}</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-balance sm:text-5xl">
      {a.title}{' '}
      <span class="brush-band text-ink">{a.titleBand}</span>
    </h1>

    <div class="mt-8 space-y-5 text-lg leading-relaxed text-muted">
      <p>
        {a.intro}
      </p>
      <p>
        <strong class="text-ink">{a.forDevelopers}</strong>{' '}
        <Fragment set:html={a.forDevelopersText
          .replace('{link}', `<a href="${L('/models')}" class="font-semibold text-brush-violet hover:text-violet-700">${a.forDevelopersLink}</a>`)
          .replace('{count}', String(models.length))} />
      </p>
      <p>
        <strong class="text-ink">{a.forCreators}</strong>{' '}
        <Fragment set:html={a.forCreatorsText.replace('{link}', `<a href="${L('/apps')}" class="font-semibold text-brush-violet hover:text-violet-700">${a.forCreatorsLink}</a>`)} />
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        values.map((value) => (
          <div class="reveal rounded-card border border-stone-200 bg-white p-6 shadow-soft transition hover:-translate-y-1 hover:border-violet-300 hover:shadow-lift">
            <div class={`flex h-11 w-11 items-center justify-center rounded-control shadow-lift ${value.tile}`}>
              <value.icon class="h-5 w-5" aria-hidden="true" />
            </div>
            <h2 class="mt-4 font-semibold">{value.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-muted">{value.description}</p>
          </div>
        ))
      }
    </div>

    <div class="reveal mt-12">
      <h2 class="text-xl font-bold tracking-tight">{a.familyTitle}</h2>
      <p class="mt-2 text-sm leading-relaxed text-muted">
        {a.familyText}
      </p>
      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <a href={L('/models')} class="group rounded-card border border-stone-200 bg-white p-5 shadow-soft transition hover:-translate-y-1 hover:border-violet-300 hover:shadow-lift">
          <h3 class="font-semibold group-hover:text-brush-violet">{a.familyApiTitle}</h3>
          <p class="mt-1.5 text-sm text-muted">{a.familyApiText.replace('{count}', String(models.length)).replace('{providers}', String(visibleProviders.length))}</p>
        </a>
        {apps.map((app) => (
          <a href={L(app.href)} class="group flex items-center gap-4 rounded-card border border-stone-200 bg-white p-5 shadow-soft transition hover:-translate-y-1 hover:border-violet-300 hover:shadow-lift">
            <img src={app.icon} alt="" width="40" height="40" class="h-10 w-10 shrink-0 rounded-control shadow-soft" />
            <div>
              <h3 class="font-semibold group-hover:text-brush-violet">{app.name}</h3>
              <p class="text-sm text-muted">{t.data.apps[app.id as keyof typeof t.data.apps].tagline}</p>
            </div>
          </a>
        ))}
      </div>
    </div>

    <div class="reveal mt-12 rounded-card border border-stone-200 bg-white p-8 shadow-soft">
      <h2 class="text-xl font-bold tracking-tight">{a.contactTitle}</h2>
      <p class="mt-2 text-sm leading-relaxed text-muted">
        {a.contactText}
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href={`mailto:${SITE.contactEmail}`}
          class="inline-flex items-center gap-2 rounded-control border border-stone-300 bg-white px-5 py-2.5 text-sm font-semibold text-ink shadow-soft transition hover:border-violet-400 hover:text-brush-violet"
        >
          {SITE.contactEmail}
        </a>
        <a
          href={LINKS.signUp}
          class="group inline-flex items-center gap-2 rounded-control bg-brush-violet px-5 py-2.5 text-sm font-semibold text-white shadow-brand transition hover:bg-violet-700"
        >
          {a.contactCta}
          <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
