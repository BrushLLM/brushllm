---
import { ArrowRight, Download, ExternalLink } from '@lucide/astro';
import BrushStroke from '../BrushStroke.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, type LocaleCode } from '../../config';
import { apps } from '../../data/apps';
import { getDictionary, localePath } from '../../i18n';

interface Props {
  locale?: LocaleCode;
}

const { locale = 'en' } = Astro.props;
const t = await getDictionary(locale);
const a = t.pages.apps;
const L = (path: string) => localePath(locale, path);

const listSchema: Record<string, unknown> = {
  '@type': 'ItemList',
  name: 'BrushLLM Apps',
  itemListElement: apps.map((app, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${SITE.url}${L(app.href)}`,
    name: `BrushLLM ${app.name}`,
  })),
};

const platforms = [...new Set(apps.flatMap((app) => app.platforms))];
const appData = apps.map((app) => {
  const tr = t.data.apps[app.id as keyof typeof t.data.apps];
  return {
    ...app,
    href: L(app.href),
    tagline: tr.tagline,
    description: tr.description,
    highlights: tr.highlights,
  };
});
---

<BaseLayout locale={locale} title={t.nav.apps} description={a.metaDescription} extraSchema={[listSchema]}>
  <section class="relative mx-auto max-w-4xl overflow-hidden px-4 py-20 text-center sm:px-6">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <BrushStroke shape="sweep" color="violet" class="absolute -top-10 -left-40 w-[620px] -rotate-6 opacity-15" />
      <BrushStroke shape="sweep" color="mint" class="absolute top-40 -right-44 w-[560px] rotate-3 opacity-15" />
    </div>

    <p class="text-sm font-semibold uppercase tracking-widest text-brush-violet">{a.eyebrow}</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-balance sm:text-5xl">
      {a.title}
      <span class="relative inline-block">
        <span>{a.titleBand}</span>
        <BrushStroke shape="underline" color="orange" class="absolute -bottom-2 left-0 h-2.5 w-full" />
      </span>
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-muted">
      {a.intro}
    </p>
    <p class="mt-5 text-sm text-stone-500">{platforms.join(' · ')}</p>
  </section>

  <section class="mx-auto max-w-4xl px-4 pb-24 sm:px-6">
    <div class="space-y-6">
      {
        appData.map((app) => (
          <div class="reveal flex flex-col gap-6 rounded-[2rem] border border-stone-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:border-violet-300 hover:shadow-lg sm:flex-row">
            <img src={app.icon} alt="" width="80" height="80" class="h-20 w-20 shrink-0 rounded-2xl shadow-lg shadow-stone-300/50" />
            <div class="flex-1">
              <h2 class="text-2xl font-bold tracking-tight">{app.name}</h2>
              <p class="mt-1 font-display text-sm font-semibold text-brush-violet">{app.tagline}</p>
              <p class="mt-3 text-sm leading-relaxed text-muted">{app.description}</p>
              <ul class="mt-4 flex flex-wrap gap-1.5">
                {app.highlights.map((h) => (
                  <li class="rounded-full border border-stone-200 bg-stone-50 px-2.5 py-1 text-[11px] font-medium text-stone-600">{h}</li>
                ))}
              </ul>
              <p class="mt-3 text-xs font-medium uppercase tracking-wide text-stone-500">
                {app.platforms.join(' · ')}{app.license ? ` · ${app.license}` : ''}
              </p>
            </div>
            <div class="flex shrink-0 flex-col justify-center gap-3">
              <a
                href={app.href}
                class="group inline-flex items-center justify-center gap-2 rounded-xl bg-brush-violet px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-violet-500/25 transition hover:bg-violet-700"
              >
                {t.common.learnMore}
                <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
              </a>
              <a
                href={app.releases}
                class="inline-flex items-center justify-center gap-2 rounded-xl border border-stone-300 bg-white px-6 py-3 text-sm font-semibold text-ink shadow-sm transition hover:border-violet-400 hover:text-brush-violet"
              >
                <Download class="h-4 w-4" aria-hidden="true" />
                {t.common.download}
              </a>
              <a
                href={app.repo}
                class="inline-flex items-center justify-center gap-2 rounded-xl px-6 py-2 text-sm font-medium text-muted transition hover:text-brush-violet"
              >
                <ExternalLink class="h-4 w-4" aria-hidden="true" />
                {t.common.github}
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <div class="reveal mt-14 rounded-[2rem] border border-stone-200 bg-white p-8 text-center shadow-sm">
      <h2 class="text-xl font-bold tracking-tight">{a.apiTitle}</h2>
      <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-muted">
        {a.apiText}
      </p>
      <a
        href={L('/models')}
        class="group mt-5 inline-flex items-center gap-2 rounded-xl bg-brush-violet px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-violet-500/25 transition hover:bg-violet-700"
      >
        {t.common.exploreAiModels}
        <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
      </a>
    </div>
  </section>
</BaseLayout>
