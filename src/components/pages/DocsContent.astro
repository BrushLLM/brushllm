---
import { ArrowRight, LifeBuoy } from '@lucide/astro';
import BrushStroke from '../BrushStroke.astro';
import CodeTabs from '../CodeTabs.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LINKS, SITE, type LocaleCode } from '../../config';
import { formatContext, models } from '../../data/models';
import { getDictionary, localePath } from '../../i18n';

interface Props {
  locale?: LocaleCode;
}

const { locale = 'en' } = Astro.props;
const t = await getDictionary(locale);
const d = t.pages.docs;
const L = (path: string) => localePath(locale, path);

const codeTabs = [
  {
    label: 'cURL',
    code: `curl ${LINKS.apiBase}/chat/completions \\
  -H "Authorization: Bearer $BRUSH_LLM_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "model": "deepseek-chat",
    "messages": [
      {"role": "user", "content": "Say hello in three languages."}
    ]
  }'`,
  },
  {
    label: 'Python',
    code: `from openai import OpenAI

client = OpenAI(
    api_key="brsh-...",              # your BrushLLM key
    base_url="${LINKS.apiBase}",
)

stream = client.chat.completions.create(
    model="glm-4.6",
    messages=[{"role": "user", "content": "Say hello in three languages."}],
    stream=True,
)
for chunk in stream:
    print(chunk.choices[0].delta.content or "", end="")`,
  },
  {
    label: 'Node.js',
    code: `import OpenAI from "openai";

const client = new OpenAI({
  apiKey: process.env.BRUSH_LLM_API_KEY,
  baseURL: "${LINKS.apiBase}",
});

const stream = await client.chat.completions.create({
  model: "kimi-k2-0905",
  messages: [{ role: "user", content: "Say hello in three languages." }],
  stream: true,
});
for await (const chunk of stream) {
  process.stdout.write(chunk.choices[0]?.delta?.content ?? "");
}`,
  },
  {
    label: 'Go',
    code: `package main

import (
	"context"
	"fmt"
	"os"

	openai "github.com/sashabaranov/go-openai"
)

func main() {
	cfg := openai.DefaultConfig(os.Getenv("BRUSH_LLM_API_KEY"))
	cfg.BaseURL = "${LINKS.apiBase}"
	client := openai.NewClientWithConfig(cfg)

	resp, err := client.CreateChatCompletion(context.Background(),
		openai.ChatCompletionRequest{
			Model:    "qwen3-max",
			Messages: []openai.ChatCompletionMessage{{Role: "user", Content: "Say hello in three languages."}},
		})
	if err != nil {
		panic(err)
	}
	fmt.Println(resp.Choices[0].Message.Content)
}`,
  },
];

const errorCodes = ['401', '404', '429', '402', '5xx'];
const errors = d.errors.map((error, i) => ({ code: errorCodes[i] ?? '', ...error }));
---

<BaseLayout locale={locale} title={t.nav.docs} description={d.metaDescription}>
  <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-widest text-brush-violet">{d.eyebrow}</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
      {d.title} <span class="relative inline-block">{d.titleBand}<BrushStroke shape="underline" color="orange" class="absolute -bottom-2 left-0 h-2.5 w-full" /></span>
    </h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
      {d.intro}
    </p>

    <nav class="mt-6 flex flex-wrap gap-2" aria-label={d.tocLabel}>
      {[
        [d.toc.quickstart, '#quickstart'],
        [d.toc.firstRequest, '#examples'],
        [d.toc.modelIds, '#model-ids'],
        [d.toc.errors, '#errors'],
      ].map(([label, href]) => (
        <a href={href} class="rounded-full border border-stone-200 bg-white px-3.5 py-1.5 text-sm font-medium text-muted transition hover:border-violet-300 hover:text-brush-violet">{label}</a>
      ))}
    </nav>

    <!-- Steps -->
    <div id="quickstart" class="scroll-mt-24"></div>
    <ol class="mt-12 space-y-5">
      <li class="reveal flex gap-5 rounded-2xl border border-stone-200 bg-white p-6 shadow-sm transition hover:border-violet-300">
        <span class="bg-brush-violet flex h-10 w-10 shrink-0 items-center justify-center rounded-xl font-bold text-white shadow-lg shadow-violet-500/25">1</span>
        <div>
          <h2 class="font-semibold">{d.steps[0].title}</h2>
          <p class="mt-1.5 text-sm leading-relaxed text-muted">
            <Fragment set:html={d.steps[0].description
              .replace('{createLink}', `<a href="${LINKS.signUp}" class="font-semibold text-brush-violet hover:text-violet-700">${d.steps[0].createLink}</a>`)
              .replace('{signInLink}', `<a href="${LINKS.signIn}" class="font-semibold text-brush-violet hover:text-violet-700">${d.steps[0].signInLink}</a>`)
              .replace('{code}', '<code class="rounded bg-stone-100 px-1.5 py-0.5 font-mono text-xs">brsh-…</code>')} />
          </p>
        </div>
      </li>
      <li class="reveal flex gap-5 rounded-2xl border border-stone-200 bg-white p-6 shadow-sm transition hover:border-violet-300">
        <span class="bg-brush-violet flex h-10 w-10 shrink-0 items-center justify-center rounded-xl font-bold text-white shadow-lg shadow-violet-500/25">2</span>
        <div>
          <h2 class="font-semibold">{d.steps[1].title}</h2>
          <p class="mt-1.5 text-sm leading-relaxed text-muted">
            {d.steps[1].description}
          </p>
          <div class="mt-3 space-y-1.5">
            <p class="font-mono text-xs text-stone-500">{d.steps[1].baseUrlLabel}</p>
            <code class="block rounded-lg bg-stone-100 px-3 py-2 font-mono text-sm break-all">{LINKS.apiBase}</code>
          </div>
        </div>
      </li>
      <li class="reveal flex gap-5 rounded-2xl border border-stone-200 bg-white p-6 shadow-sm transition hover:border-violet-300">
        <span class="bg-brush-violet flex h-10 w-10 shrink-0 items-center justify-center rounded-xl font-bold text-white shadow-lg shadow-violet-500/25">3</span>
        <div>
          <h2 class="font-semibold">{d.steps[2].title}</h2>
          <p class="mt-1.5 text-sm leading-relaxed text-muted">
            <Fragment set:html={d.steps[2].description.replace('{code}', '<code class="rounded bg-stone-100 px-1.5 py-0.5 font-mono text-xs">model</code>')} />
          </p>
        </div>
      </li>
    </ol>

    <!-- Code -->
    <h2 class="reveal mt-16 scroll-mt-24 text-2xl font-bold tracking-tight" id="examples">{d.firstRequestTitle}</h2>
    <p class="reveal mt-3 text-muted">
      {d.firstRequestText}
    </p>
    <div class="reveal mt-6">
      <CodeTabs tabs={codeTabs} locale={locale} />
    </div>

    <!-- Model ids -->
    <h2 class="reveal mt-16 scroll-mt-24 text-2xl font-bold tracking-tight" id="model-ids">{d.modelIdsTitle}</h2>
    <p class="reveal mt-3 text-muted">
      <Fragment set:html={d.modelIdsText
        .replace('{modelsLink}', `<a href="${L('/models')}" class="font-semibold text-brush-violet hover:text-violet-700">${d.modelIdsModelsLink}</a>`)
        .replace('{code}', '<code class="rounded bg-stone-100 px-1.5 py-0.5 font-mono text-xs">POST /v1/images/generations</code>')} />
    </p>
    <div class="reveal mt-6 overflow-x-auto rounded-2xl border border-stone-200 bg-white shadow-sm">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-stone-100 bg-stone-50 text-xs uppercase tracking-wide text-stone-500">
          <tr>
            <th class="px-4 py-3 font-medium">{d.modelIdsTable.id}</th>
            <th class="px-4 py-3 font-medium">{d.modelIdsTable.name}</th>
            <th class="px-4 py-3 font-medium">{d.modelIdsTable.context}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          {
            models.map((model) => (
              <tr>
                <td class="px-4 py-2.5">
                  <code class="rounded bg-stone-100 px-1.5 py-0.5 font-mono text-xs">{model.id}</code>
                </td>
                <td class="px-4 py-2.5 text-stone-700">{model.name}</td>
                <td class="px-4 py-2.5 text-stone-500">{formatContext(model.context)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <!-- Errors -->
    <h2 class="reveal mt-16 scroll-mt-24 text-2xl font-bold tracking-tight" id="errors">{d.errorsTitle}</h2>
    <div class="reveal mt-6 overflow-x-auto rounded-2xl border border-stone-200 bg-white shadow-sm">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-stone-100 bg-stone-50 text-xs uppercase tracking-wide text-stone-500">
          <tr>
            <th class="px-4 py-3 font-medium">{d.errorsTable.status}</th>
            <th class="px-4 py-3 font-medium">{d.errorsTable.meaning}</th>
            <th class="px-4 py-3 font-medium">{d.errorsTable.fix}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          {
            errors.map((error) => (
              <tr>
                <td class="px-4 py-2.5 font-mono font-semibold text-brush-violet">{error.code}</td>
                <td class="px-4 py-2.5 text-stone-700">{error.meaning}</td>
                <td class="px-4 py-2.5 text-stone-500">{error.fix}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <!-- Help -->
    <div class="reveal relative mt-16 overflow-hidden rounded-3xl border border-stone-200 bg-white p-10 text-center shadow-xl shadow-stone-200/60">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <BrushStroke shape="sweep" color="violet" class="absolute -top-10 -left-28 w-[480px] -rotate-3 opacity-80" />
        <BrushStroke shape="underline" color="orange" class="absolute right-[14%] -bottom-2 w-52 rotate-2 opacity-70" />
      </div>
      <LifeBuoy class="relative mx-auto h-10 w-10 text-brush-violet" aria-hidden="true" />
      <h2 class="relative mt-4 text-xl font-bold tracking-tight">{d.helpTitle}</h2>
      <p class="relative mx-auto mt-2 max-w-md text-sm leading-relaxed text-muted">
        <Fragment set:html={d.helpText.replace('{email}', `<a href="mailto:${SITE.contactEmail}" class="font-semibold text-brush-violet underline underline-offset-2">${SITE.contactEmail}</a>`)} />
      </p>
      <a href={LINKS.console} class="group relative mt-6 inline-flex items-center gap-2 rounded-xl bg-brush-violet px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-violet-500/25 transition hover:bg-violet-700">
        {t.common.openTheConsole}
        <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
      </a>
    </div>
  </div>
</BaseLayout>
