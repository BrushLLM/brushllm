---
import {
  ArrowRight,
  Eraser,
  ExternalLink,
  ImagePlus,
  KeyRound,
  Layers,
  Link2,
  Maximize2,
  Palette,
  PlugZap,
  Sparkles,
  Wand2,
  Wallet,
} from '@lucide/astro';
import BrushStroke from '../BrushStroke.astro';
import CodeTabs from '../CodeTabs.astro';
import FAQ from '../FAQ.astro';
import ProviderLogo from '../ProviderLogo.astro';
import ShinyButton from '../ShinyButton.astro';
import { LINKS, SITE, type LocaleCode } from '../../config';
import { models } from '../../data/models';
import { visibleProviders } from '../../data/providers';
import { apps } from '../../data/apps';
import { getDictionary, localePath } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  locale?: LocaleCode;
}

const { locale = 'en' } = Astro.props;
const t = await getDictionary(locale);
const home = t.pages.home;
const L = (path: string) => localePath(locale, path);

/* GEO structured data: the platform's products, stated factually */
const productSchemas: Record<string, unknown>[] = [
  {
    '@type': 'Product',
    '@id': `${SITE.url}/#ai-model-services`,
    name: 'BrushLLM AI Model Services',
    description:
      'Unified API access to multiple AI models through one OpenAI-compatible endpoint. Built for developers, startups, and businesses.',
    url: `${SITE.url}${L('/models')}`,
    brand: { '@type': 'Brand', name: 'BrushLLM' },
    category: 'AI Model API',
  },
  {
    '@type': 'SoftwareApplication',
    '@id': `${SITE.url}/#image-studio`,
    name: 'BrushLLM Image Studio',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'macOS, Windows',
    description:
      'Local-first desktop image toolbox — free offline tools for convert, compress, crop and EXIF, plus AI generation and editing through the BrushLLM API, billed per image.',
    url: `${SITE.url}${L('/studio')}`,
    downloadUrl: 'https://github.com/BrushLLM/brushllm-image-studio/releases',
    brand: { '@type': 'Brand', name: 'BrushLLM' },
  },
  {
    '@type': 'SoftwareApplication',
    '@id': `${SITE.url}/#video-studio`,
    name: 'BrushLLM Video Studio',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'macOS, Windows',
    description:
      'Free, local-first toolbox for video, audio and subtitle processing — 100% local, zero network requests, 9-language UI.',
    url: `${SITE.url}${L('/video-studio')}`,
    downloadUrl: 'https://github.com/BrushLLM/brushllm-video-studio/releases',
    brand: { '@type': 'Brand', name: 'BrushLLM' },
  },
  {
    '@type': 'SoftwareApplication',
    '@id': `${SITE.url}/#player`,
    name: 'BrushLLM Player',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'macOS, Windows',
    description:
      'Open-source cross-platform media player built on mpv — every format, plus WebDAV, SMB, FTP, Emby and Jellyfin streaming.',
    url: `${SITE.url}${L('/player')}`,
    downloadUrl: 'https://github.com/BrushLLM/brushllm-player/releases',
    brand: { '@type': 'Brand', name: 'BrushLLM' },
  },
];

const codeTabs = [
  {
    label: 'cURL',
    code: `curl ${LINKS.apiBase}/chat/completions \\
  -H "Authorization: Bearer $BRUSH_LLM_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "model": "deepseek-chat",
    "messages": [
      {"role": "user", "content": "Hello, BrushLLM!"}
    ]
  }'`,
  },
  {
    label: 'Python',
    code: `from openai import OpenAI

client = OpenAI(
    api_key="brsh-...",
    base_url="${LINKS.apiBase}",
)

response = client.chat.completions.create(
    model="glm-4.6",
    messages=[{"role": "user", "content": "Hello, BrushLLM!"}],
)
print(response.choices[0].message.content)`,
  },
  {
    label: 'Node.js',
    code: `import OpenAI from "openai";

const client = new OpenAI({
  apiKey: process.env.BRUSH_LLM_API_KEY,
  baseURL: "${LINKS.apiBase}",
});

const response = await client.chat.completions.create({
  model: "kimi-k2-0905",
  messages: [{ role: "user", content: "Hello, BrushLLM!" }],
});
console.log(response.choices[0].message.content);`,
  },
  {
    label: 'Go',
    code: `package main

import (
	"context"
	"fmt"
	"os"

	openai "github.com/sashabaranov/go-openai"
)

func main() {
	cfg := openai.DefaultConfig(os.Getenv("BRUSH_LLM_API_KEY"))
	cfg.BaseURL = "${LINKS.apiBase}"
	client := openai.NewClientWithConfig(cfg)

	resp, _ := client.CreateChatCompletion(context.Background(),
		openai.ChatCompletionRequest{
			Model:    "qwen3-max",
			Messages: []openai.ChatCompletionMessage{{Role: "user", Content: "Hello, BrushLLM!"}},
		})
	fmt.Println(resp.Choices[0].Message.Content)
}`,
  },
];

/* AI Model Services benefit cards — icon tiles rotate the icon's trio */
const benefitStyles = [
  'bg-brush-violet text-white shadow-brand',
  'bg-brush-orange text-ink shadow-lift',
  'bg-brush-mint text-ink shadow-lift',
  'bg-brush-violet text-white shadow-brand',
] as const;

const benefitIcons = [PlugZap, Layers, Link2, Wallet];
const stepIcons = [KeyRound, Link2, Sparkles];

const benefits = home.benefits.map((benefit, i) => ({
  icon: benefitIcons[i % benefitIcons.length],
  title: benefit.title,
  description: benefit.description.replace('{count}', String(models.length)),
}));

const steps = home.howSteps.map((step, i) => ({ icon: stepIcons[i % stepIcons.length], ...step }));

/* Marquee: six copies of the provider row. The -50% loop point lands on a
   copy boundary (seamless wrap), and half the track — three copies, ~3.9k px —
   stays wider than any viewport so the track's right end is never exposed. */
const marqueeProviders = Array.from({ length: 6 }, () => visibleProviders).flat();

const faqLink = (href: string, label: string) =>
  `<a href="${href}" class="font-semibold text-brush-violet hover:text-violet-700">${label}</a>`;
const developerFaqs = home.developerFaqs.map((faq) => ({
  question: faq.question,
  answer: faq.answer
    .replace('{apiBase}', LINKS.apiBase)
    .replace('{count}', String(models.length))
    .replace('{privacyLink}', faqLink(L('/privacy'), t.footer.privacyPolicy))
    .replace('{pricingLink}', faqLink(L('/pricing'), t.nav.pricing)),
}));
const creatorFaqs = home.creatorFaqs.map((faq) => ({ question: faq.question, answer: faq.answer }));
/* homepage shows the top 4 per group; the full set lives on /faq */
const homeDevFaqs = developerFaqs.slice(0, 4);
const homeCreatorFaqs = creatorFaqs.slice(0, 4);
const faqSchema = [...homeDevFaqs, ...homeCreatorFaqs];
---

<BaseLayout locale={locale} faqSchema={faqSchema} extraSchema={productSchemas}>
  <!-- ═══ Hero ═══ -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <BrushStroke shape="sweep" color="violet" class="absolute -top-8 -left-40 w-[720px] -rotate-6 opacity-20" />
      <BrushStroke shape="sweep" color="mint" class="absolute top-40 -right-52 w-[680px] rotate-3 opacity-15" />
    </div>

    <div class="mx-auto max-w-6xl px-4 pb-20 pt-20 text-center sm:px-6 sm:pt-28">
    <p class="reveal mx-auto inline-flex items-center gap-2 rounded-full border border-stone-200 bg-white px-4 py-1.5 text-sm font-semibold text-stone-600 shadow-soft">
      <span class="h-2 w-2 rounded-full bg-brush-mint"></span>
      {home.heroBadge}
    </p>

    <h1 class="reveal mx-auto mt-7 max-w-4xl text-5xl font-bold tracking-tight text-balance sm:text-6xl lg:text-7xl">
      {home.heroTitle}{' '}
      <span class="brush-band text-ink">{home.heroTitleBand}</span>
    </h1>

    <p class="reveal mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-muted">
      {home.heroSubtitle}
    </p>

    <div class="reveal mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <ShinyButton href={LINKS.signUp}>
        {home.heroCtaApi}
        <ArrowRight class="h-4.5 w-4.5 transition-transform group-hover:translate-x-1" aria-hidden="true" />
      </ShinyButton>
      <ShinyButton
        href={L('/apps')}
        bg="bg-brush-orange"
        hoverBg="group-hover:bg-orange-600"
        shadowColor="shadow-lift"
        class="text-ink!"
      >
        {home.heroCtaApps}
        <ArrowRight class="h-4.5 w-4.5 transition-transform group-hover:translate-x-1" aria-hidden="true" />
      </ShinyButton>
    </div>
    <p class="reveal mt-5 text-sm text-stone-500">{home.heroNote}</p>
    </div>
  </section>

<!-- ═══ One platform: API + apps ═══ -->
<section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <div class="reveal mx-auto max-w-2xl text-center">
    <p class="text-sm font-semibold text-brush-violet">{home.platformEyebrow}</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{home.platformTitle}</h2>
    <p class="mt-4 leading-relaxed text-muted">
      <Fragment set:html={home.platformIntro
        .replace('{modelsLink}', `<a href="${L('/models')}" class="font-semibold text-brush-violet hover:text-violet-700">${home.platformModelsLink}</a>`)
        .replace('{appsLink}', `<a href="${L('/apps')}" class="font-semibold text-brush-violet hover:text-violet-700">${home.platformAppsLink}</a>`)} />
    </p>
  </div>

  <div class="mt-12 grid gap-6 lg:grid-cols-2">
    <!-- product 1: AI Model Services -->
    <div class="reveal group rounded-panel border border-stone-200 bg-white p-8 shadow-soft transition hover:-translate-y-1 hover:border-violet-300 hover:shadow-lift">
      <span class="inline-flex items-center gap-2 rounded-full bg-brush-violet px-3 py-1 text-[11px] font-semibold text-white shadow-brand">
        {home.apiCardBadge}
      </span>
      <h3 class="mt-4 text-2xl font-bold tracking-tight">{home.apiCardTitle}</h3>
      <p class="mt-1 font-display text-sm font-semibold text-brush-violet">{home.apiCardSubtitle}</p>
      <p class="mt-3 text-sm leading-relaxed text-muted">
        {home.apiCardDescription.replace('{count}', String(models.length)).replace('{providers}', String(visibleProviders.length))}
      </p>
      <ul class="mt-5 space-y-2 text-sm text-muted">
        <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-brush-violet"></span>{home.apiCardBullets[0]}</li>
        <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-brush-violet"></span>{home.apiCardBullets[1]}</li>
        <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-brush-orange"></span>{home.apiCardBullets[2]}</li>
      </ul>
      <ul class="mt-5 flex flex-wrap gap-2">
        {[
          [home.apiCardChips.models, L('/models')],
          [home.apiCardChips.pricing, L('/pricing')],
          [home.apiCardChips.docs, L('/docs')],
          [home.apiCardChips.console, LINKS.console],
        ].map(([label, href]) => (
          <li><a href={href} class="rounded-full border border-stone-200 bg-stone-50 px-3 py-1 text-xs font-medium text-muted transition hover:border-violet-300 hover:text-brush-violet">{label}</a></li>
        ))}
      </ul>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href={L('/models')} class="group/dev inline-flex items-center gap-1.5 rounded-control bg-brush-violet px-5 py-2.5 text-sm font-semibold text-white shadow-brand transition hover:bg-violet-700">
          {home.apiCardCta}
          <ArrowRight class="h-4 w-4 transition-transform group-hover/dev:translate-x-0.5" aria-hidden="true" />
        </a>
        <a href={L('/docs')} class="inline-flex items-center gap-2 rounded-control border border-stone-300 bg-white px-5 py-2.5 text-sm font-semibold text-ink shadow-soft transition hover:border-violet-400 hover:text-brush-violet">
          {home.apiCardSecondary}
        </a>
      </div>
    </div>

    <!-- product 2: Image Studio -->
    <div class="reveal relative overflow-hidden rounded-panel border border-stone-200 bg-white p-8 shadow-soft transition hover:-translate-y-1 hover:border-orange-300 hover:shadow-lift">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <BrushStroke shape="sweep" color="orange" class="absolute -top-10 -right-24 w-[420px] rotate-3 opacity-25" />
      </div>
      <span class="relative inline-flex items-center gap-2 rounded-full bg-brush-orange px-3 py-1 text-[11px] font-semibold text-ink shadow-card">
        {home.appsCardBadge}
      </span>
      <h3 class="relative mt-4 text-2xl font-bold tracking-tight">{home.appsCardTitle}</h3>
      <p class="relative mt-1 font-display text-sm font-semibold text-orange-700">{home.appsCardSubtitle}</p>
      <p class="relative mt-3 text-sm leading-relaxed text-muted">
        {home.appsCardDescription}
      </p>
      <ul class="relative mt-5 flex flex-wrap gap-2">
        {apps.map((a) => (
          <li class="rounded-full border border-stone-200 bg-stone-50 px-3 py-1 text-xs font-medium text-orange-700">{a.name}</li>
        ))}
      </ul>
      <div class="relative mt-5 flex items-center gap-3">
        {apps.map((a) => (
          <a href={L(a.href)} title={a.name} class="transition-transform hover:-translate-y-0.5">
            <img src={a.icon} alt="" width="32" height="32" class="h-8 w-8 rounded-chip shadow-soft" />
          </a>
        ))}
        <span class="text-xs font-medium text-stone-500">{home.appsCardNote}</span>
      </div>
      <div class="relative mt-4 flex flex-wrap gap-3">
        <a href={L('/apps')} class="group/create inline-flex items-center gap-1.5 rounded-control bg-brush-orange px-5 py-2.5 text-sm font-semibold text-ink shadow-lift transition hover:bg-orange-600">
          {home.appsCardCta}
          <ArrowRight class="h-4 w-4 transition-transform group-hover/create:translate-x-0.5" aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ═══ Apps: the BrushLLM desktop family ═══ -->
<section id="apps" class="border-y border-stone-100 bg-stone-50/50">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold text-brush-violet">{home.appsSectionEyebrow}</p>
      <h2 class="mt-3 text-2xl font-bold tracking-tight">
        {home.appsSectionTitle}
        <span class="relative inline-block">
          <span>{home.appsSectionTitleBand}</span>
          <BrushStroke shape="underline" color="orange" class="absolute -bottom-2 left-0 h-2.5 w-full" />
        </span>
      </h2>
    </div>

    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      {
        apps.map((app) => (
          <div class="reveal group rounded-panel border border-stone-200 bg-white p-6 shadow-soft transition hover:-translate-y-1 hover:border-violet-300 hover:shadow-lift">
            <div class="flex items-center gap-4">
              <img src={app.icon} alt="" width="56" height="56" class="h-14 w-14 rounded-card shadow-card shadow-stone-300/50" />
              <div>
                <h3 class="text-lg font-bold tracking-tight">
                  <a href={L(app.href)} class="transition-colors hover:text-brush-violet">{app.name}</a>
                </h3>
                <p class="text-sm text-muted">{t.data.apps[app.id as keyof typeof t.data.apps].tagline}</p>
              </div>
            </div>
            <div class="mt-4 flex items-center justify-between border-t border-stone-100 pt-4">
              <a href={L(app.href)} class="text-sm font-semibold text-brush-violet hover:text-violet-700">{t.common.learnMoreArrow}</a>
              <a href={app.releases} class="text-sm font-medium text-muted transition-colors hover:text-brush-violet" rel="noopener">{t.common.downloadArrow}</a>
            </div>
          </div>
        ))
      }
    </div>
    <p class="reveal mt-6 text-center text-sm text-muted">
      <Fragment set:html={home.appsSectionFooter.replace('{link}', `<a href="${L('/apps')}" class="font-semibold text-brush-violet hover:text-violet-700">${home.appsSectionFooterLink}</a>`)} />
    </p>
  </div>
</section>

<!-- ═══ AI Model Services benefits ═══ -->
<section class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <BrushStroke shape="sweep" color="violet" class="absolute top-10 right-0 hidden w-96 rotate-2 opacity-10 lg:block" />
  <div class="reveal mx-auto max-w-2xl text-center">
    <p class="text-sm font-semibold text-brush-violet">{home.benefitsEyebrow}</p>
    <h2 class="mt-3 text-2xl font-bold tracking-tight">
      {home.benefitsTitle}
      <span class="relative inline-block">
        <span>{home.benefitsTitleBand}</span>
        <BrushStroke shape="underline" color="orange" class="absolute -bottom-2 left-0 h-2.5 w-full" />
      </span>
    </h2>
    <p class="mt-4 text-muted">{home.benefitsSubtitle}</p>
  </div>
  <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      benefits.map((benefit, i) => (
        <div class="reveal group rounded-panel border border-stone-200 bg-white p-7 shadow-soft transition duration-200 hover:-translate-y-1.5 hover:border-violet-300 hover:shadow-card">
          <div class={`flex h-12 w-12 items-center justify-center rounded-card shadow-lift ${benefitStyles[i % benefitStyles.length]}`}>
            <benefit.icon class="h-5.5 w-5.5" stroke-width={2} aria-hidden="true" />
          </div>
          <h3 class="mt-5 text-lg font-semibold">{benefit.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{benefit.description}</p>
        </div>
      ))
    }
  </div>
</section>

<!-- ═══ Available models + stats ═══ -->
<section class="border-b border-stone-100 py-16">
  <h2 class="text-center text-xs font-semibold text-stone-500">
    {home.statsEyebrow}
  </h2>
  <div class="marquee relative mt-7 overflow-hidden [mask-image:linear-gradient(90deg,transparent,black_24%,black_76%,transparent)]">
    <div class="marquee-track flex gap-3 pr-3">
      {
        marqueeProviders.map((provider) => (
          <div class="flex shrink-0 items-center gap-3 rounded-card border border-stone-200 bg-white px-5 py-4 shadow-soft transition hover:-translate-y-0.5 hover:border-violet-300">
            <span class="flex h-10 w-10 items-center justify-center rounded-control bg-stone-50">
              <ProviderLogo provider={provider.id} class="h-6 w-6" />
            </span>
            <span class="block text-sm font-semibold">{provider.name}</span>
          </div>
        ))
      }
    </div>
  </div>

  <div class="mx-auto mt-10 grid max-w-6xl grid-cols-2 divide-stone-100 px-4 text-center sm:grid-cols-4 sm:divide-x sm:px-6">
    <div class="reveal p-4">
      <p class="text-4xl font-bold text-brush-violet tabular-nums sm:text-5xl" data-count-to={visibleProviders.length} data-suffix="+">{visibleProviders.length}+</p>
      <p class="mt-1.5 text-sm text-muted">{home.stats.providers}</p>
    </div>
    <div class="reveal p-4">
      <p class="inline-block rounded-chip bg-brush-orange px-3 text-4xl font-bold text-ink tabular-nums sm:text-5xl" data-count-to={models.length} data-suffix="+">{models.length}+</p>
      <p class="mt-1.5 text-sm text-muted">{home.stats.models}</p>
    </div>
    <div class="reveal p-4">
      <p class="text-4xl font-bold text-mint-700 tabular-nums sm:text-5xl">1</p>
      <p class="mt-1.5 text-sm text-muted">{home.stats.account}</p>
    </div>
    <div class="reveal p-4">
      <p class="text-4xl font-bold text-brush-violet tabular-nums sm:text-5xl" data-count-to="195">195</p>
      <p class="mt-1.5 text-sm text-muted">{home.stats.countries}</p>
    </div>
  </div>
  <p class="mt-6 text-center text-sm text-muted">
    <Fragment set:html={home.statsCompare.replace('{link}', `<a href="${L('/pricing')}" class="font-semibold text-brush-violet hover:text-violet-700">${home.statsCompareLink}</a>`)} />
  </p>
</section>

<!-- ═══ How it works + first request ═══ -->
<section class="bg-white">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold text-brush-violet">{home.howEyebrow}</p>
      <h2 class="mt-3 text-2xl font-bold tracking-tight">{home.howTitle}</h2>
    </div>
    <div class="relative mt-12 grid gap-10 md:grid-cols-3">
      <!-- dashed connector -->
      <div class="absolute top-6 right-[16%] left-[16%] hidden border-t-2 border-dashed border-stone-300 md:block" aria-hidden="true"></div>
      {
        steps.map((step, i) => (
          <div class="reveal relative text-center">
            <div class="relative mx-auto flex h-12 w-12 items-center justify-center rounded-card bg-brush-mint text-ink shadow-lift">
              <step.icon class="h-5.5 w-5.5" aria-hidden="true" />
              <span class="absolute -top-2 -right-2 flex h-6 w-6 items-center justify-center rounded-full border-2 border-white bg-ink text-[11px] font-bold text-white">
                {i + 1}
              </span>
            </div>
            <h3 class="mt-5 text-lg font-semibold">{step.title}</h3>
            <p class="mx-auto mt-2 max-w-xs text-sm leading-relaxed text-muted">{step.description}</p>
          </div>
        ))
      }
    </div>
    <div class="reveal mt-12 rounded-card border border-stone-200 bg-white p-5 text-center shadow-soft">
      <p class="font-mono text-sm text-stone-600">
        base_url = <span class="font-semibold text-brush-violet">{LINKS.apiBase}</span>
      </p>
    </div>

    <div class="reveal mx-auto mt-14 max-w-2xl text-center">
      <h3 class="text-xl font-bold tracking-tight">{home.howCodeTitle}</h3>
      <p class="mt-2 text-muted">
        {home.howCodeSubtitle}
      </p>
    </div>
    <div class="reveal mx-auto mt-8 max-w-3xl">
      <CodeTabs tabs={codeTabs} locale={locale} />
    </div>
  </div>
</section>

<!-- ═══ FAQ: developers + creators ═══ -->
<section class="border-t border-stone-100">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold text-brush-violet">{home.faqEyebrow}</p>
      <h2 class="mt-3 text-2xl font-bold tracking-tight">{home.faqTitle}</h2>
    </div>

    <div class="reveal mx-auto mt-12 max-w-3xl">
      <h3 class="text-center font-display text-sm font-semibold text-brush-violet">{home.faqDevelopers}</h3>
      <div class="mt-5">
        <FAQ faqs={homeDevFaqs} />
      </div>
