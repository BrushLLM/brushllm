---
import { ArrowRight } from '@lucide/astro';
import logoUrl from '../../assets/logo.png?url';
import BrushStroke from '../BrushStroke.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { LocaleCode } from '../../config';
import { getDictionary, localePath } from '../../i18n';

interface Props {
  locale?: LocaleCode;
}

const { locale = 'en' } = Astro.props;
const t = await getDictionary(locale);
const n = t.pages.notFound;
const L = (path: string) => localePath(locale, path);
---

<BaseLayout locale={locale} title={n.title} description={n.metaDescription} noindex>
  <section class="relative mx-auto flex max-w-2xl flex-col items-center overflow-hidden px-4 py-28 text-center sm:px-6">
    <BrushStroke shape="sweep" color="violet" class="pointer-events-none absolute -top-8 -left-36 w-[540px] -rotate-3 opacity-15" />
    <img src={logoUrl} alt="" aria-hidden="true" width="80" height="80" class="h-20 w-20 rounded-card" />
    <p class="mt-8 font-mono text-sm font-semibold tracking-widest text-brush-violet">{n.code}</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl">{n.title}</h1>
    <p class="mt-4 text-muted">
      {n.text}
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={L('/')} class="group inline-flex items-center justify-center gap-2 rounded-control bg-brush-violet px-6 py-3 text-sm font-semibold text-white shadow-brand transition hover:bg-violet-700">
        {n.backHome}
        <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
      </a>
      <a
        href={L('/models')}
        class="inline-flex items-center justify-center gap-2 rounded-control border border-stone-300 bg-white px-6 py-3 text-sm font-semibold text-ink shadow-soft transition hover:border-violet-400 hover:text-brush-violet"
      >
        {n.browseModels}
      </a>
    </div>
  </section>
</BaseLayout>
