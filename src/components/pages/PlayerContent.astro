---
import AppPage from '../AppPage.astro';
import { appById } from '../../data/apps';
import type { LocaleCode } from '../../config';
import { getDictionary } from '../../i18n';

interface Props {
  locale?: LocaleCode;
}

const { locale = 'en' } = Astro.props;
const t = await getDictionary(locale);
const p = t.pages.player;

const app = appById('player')!;
---

<AppPage app={app} badge={p.badge} featureGroups={p.groups} locale={locale}>
  <p slot="intro" class="reveal mx-auto mt-0 max-w-2xl text-center text-muted">
    {p.intro}
  </p>
</AppPage>
