---
import { ExternalLink } from '@lucide/astro';
import BrushStroke from '../BrushStroke.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type LocaleCode } from '../../config';
import { getDictionary, localePath } from '../../i18n';

interface Props {
  locale?: LocaleCode;
}

const { locale = 'en' } = Astro.props;
const t = await getDictionary(locale);
const p = t.pages.privacy;
const L = (path: string) => localePath(locale, path);
---

<BaseLayout locale={locale} title={p.title} description={p.metaDescription}>
  <section class="relative mx-auto max-w-3xl overflow-hidden px-4 py-16 sm:px-6">
    <BrushStroke shape="sweep" color="violet" class="pointer-events-none absolute -top-10 -right-44 w-[620px] rotate-2 opacity-15" />

    <p class="text-sm font-semibold text-brush-violet">{p.eyebrow}</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-balance sm:text-5xl">
      {p.title}
      <span class="relative inline-block">
        <span>{p.titleBand}</span>
        <BrushStroke shape="underline" color="orange" class="absolute -bottom-2 left-0 h-2.5 w-full" />
      </span>
    </h1>
    <p class="mt-4 text-sm text-stone-500">{p.updated}</p>
    <p class="mt-6 text-lg leading-relaxed text-muted">{p.intro}</p>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-20 sm:px-6">
    <div class="space-y-10">
      {
        p.sections.map((section) => (
          <div class="reveal">
            <h2 class="text-xl font-bold tracking-tight">{section.heading}</h2>
            <div class="mt-3 space-y-3">
              {section.paragraphs.map((para) => (
                <p class="leading-relaxed text-muted">{para}</p>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <div class="reveal mt-12 rounded-card border border-stone-200 bg-white p-6 text-center shadow-soft">
      <p class="text-sm leading-relaxed text-muted">
        {p.openSourceNote.replace('github.com/BrushLLM', '')}
        <a
          href="https://github.com/BrushLLM"
          class="font-semibold text-brush-violet hover:text-violet-700"
          rel="noopener"
          target="_blank"
        >
          github.com/BrushLLM
          <ExternalLink class="ml-0.5 inline h-3.5 w-3.5" aria-hidden="true" />
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
