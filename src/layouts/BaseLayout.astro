---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LOCALES, SITE, type LocaleCode } from '../config';
import { getDictionary, localePath } from '../i18n';

export interface FaqEntry {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  description?: string;
  /** page locale — drives <html lang>, hreflang alternates and SEO strings */
  locale?: LocaleCode;
  /** visible FAQ entries on this page — emitted as matching FAQPage JSON-LD */
  faqSchema?: FaqEntry[];
  /** extra JSON-LD nodes for this page (Product, SoftwareApplication, …) */
  extraSchema?: Record<string, unknown>[];
}

const { title, locale = 'en', faqSchema, extraSchema = [] } = Astro.props;
const t = await getDictionary(locale);
const description = Astro.props.description ?? t.site.description;
const pageTitle = title ? `${title} · ${SITE.name}` : t.site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

/* hreflang alternates: one per locale + x-default pointing at the English
   (unprefixed) URL of this page. English pages and prefixed pages of the
   same route share the same canonical path after the prefix is stripped. */
const canonicalPath = Astro.url.pathname.replace(/^\/[a-z]{2}(?:-[A-Za-z]{2})?(?=\/|$)/, '') || '/';
const alternates = LOCALES.map((l) => ({
  hreflang: l.htmlLang,
  href: new URL(localePath(l.code, canonicalPath === '/' ? '/' : canonicalPath), Astro.site),
}));
alternates.push({ hreflang: 'x-default', href: new URL(canonicalPath === '/' ? '/' : canonicalPath, Astro.site) });

/* Structured data (SEO + GEO): stable, factual entity graph for AI answer engines */
const schemaGraph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    name: SITE.name,
    url: SITE.url,
    logo: `${SITE.url}/apple-touch-icon.png`,
    email: SITE.contactEmail,
    description: t.site.organizationDescription,
  },
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    name: SITE.name,
    url: SITE.url,
    publisher: { '@id': `${SITE.url}/#organization` },
  },
];

if (faqSchema?.length) {
  schemaGraph.push({
    '@type': 'FAQPage',
    mainEntity: faqSchema.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  });
}
schemaGraph.push(...extraSchema);

const schemaJson = JSON.stringify({ '@context': 'https://schema.org', '@graph': schemaGraph });
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=logo-purple" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={schemaJson} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {locale === 'en' && <script is:inline src="/scripts/locale-redirect.js" />}
  </head>
  <body class="flex min-h-screen flex-col">
    <Header locale={locale} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
