---
import { ArrowRight, Brush } from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page could not be found.">
  <section class="relative mx-auto flex max-w-2xl flex-col items-center overflow-hidden px-4 py-28 text-center sm:px-6">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="blob absolute top-10 left-1/4 h-56 w-56 rounded-full bg-violet-200/50 blur-3xl"></div>
      <div class="blob blob-slow absolute right-1/4 bottom-10 h-56 w-56 rounded-full bg-orange-200/50 blur-3xl"></div>
    </div>
    <span class="bg-brush flex h-20 w-20 items-center justify-center rounded-3xl text-white shadow-xl shadow-fuchsia-500/30">
      <Brush class="h-9 w-9" aria-hidden="true" />
    </span>
    <p class="bg-brush mt-8 bg-clip-text font-mono text-sm font-semibold tracking-widest text-transparent">404 · OFF THE CANVAS</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl">This page got painted over</h1>
    <p class="mt-4 text-muted">
      The link may be outdated or the page may have moved. The models, however, are exactly where
      you left them.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="group inline-flex items-center justify-center gap-2 rounded-xl bg-brush px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-fuchsia-500/25 transition hover:brightness-110">
        Back to home
        <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
      </a>
      <a
        href="/models"
        class="inline-flex items-center justify-center gap-2 rounded-xl border border-violet-200 bg-white px-6 py-3 text-sm font-semibold text-ink shadow-sm transition hover:border-fuchsia-300 hover:text-brush-violet"
      >
        Browse models
      </a>
    </div>
  </section>
</BaseLayout>
