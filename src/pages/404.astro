---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page could not be found.">
  <section class="mx-auto flex max-w-2xl flex-col items-center px-4 py-28 text-center sm:px-6">
    <svg width="88" height="88" viewBox="0 0 32 32" aria-hidden="true">
      <rect width="32" height="32" rx="8" class="fill-accent-soft"></rect>
      <circle
        cx="16"
        cy="16"
        r="8"
        fill="none"
        class="stroke-accent"
        stroke-width="3.2"
        stroke-linecap="round"
        stroke-dasharray="38 12.3"
        transform="rotate(45 16 16)"></circle>
    </svg>
    <p class="mt-8 font-mono text-sm font-semibold tracking-widest text-accent">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">This page wandered off the paper</h1>
    <p class="mt-4 text-stone-600">
      The link may be outdated or the page may have moved. The models, however, are exactly where
      you left them.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="rounded-xl bg-accent px-6 py-3 text-sm font-semibold text-white transition hover:bg-accent-strong">
        Back to home
      </a>
      <a
        href="/models"
        class="rounded-xl border border-stone-300 bg-white px-6 py-3 text-sm font-semibold text-stone-700 transition hover:border-accent/50 hover:text-accent"
      >
        Browse models
      </a>
    </div>
  </section>
</BaseLayout>
