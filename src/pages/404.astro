---
import { ArrowRight } from '@lucide/astro';
import siteIcon from '../assets/site-icon.png';
import BrushStroke from '../components/BrushStroke.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page could not be found.">
  <section class="relative mx-auto flex max-w-2xl flex-col items-center overflow-hidden px-4 py-28 text-center sm:px-6">
<BrushStroke shape="sweep" color="violet" class="pointer-events-none absolute -top-8 -left-36 w-[540px] -rotate-3 opacity-15" />
    <img src={siteIcon} alt="" aria-hidden="true" width="80" height="80" class="h-20 w-20" />
    <p class="mt-8 font-mono text-sm font-semibold tracking-widest text-brush-violet">404 · OFF THE CANVAS</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl">This page got painted over</h1>
    <p class="mt-4 text-muted">
      The link may be outdated or the page may have moved. The models, however, are exactly where
      you left them.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="group inline-flex items-center justify-center gap-2 rounded-xl bg-brush-violet px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-violet-500/25 transition hover:bg-violet-700">
        Back to home
        <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
      </a>
      <a
        href="/models"
        class="inline-flex items-center justify-center gap-2 rounded-xl border border-stone-300 bg-white px-6 py-3 text-sm font-semibold text-ink shadow-sm transition hover:border-violet-400 hover:text-brush-violet"
      >
        Browse models
      </a>
    </div>
  </section>
</BaseLayout>
