---
import { ArrowRight, EyeOff, Globe2, Paintbrush, Tag } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrushStroke from '../components/BrushStroke.astro';
import { LINKS, SITE } from '../config';
import { models } from '../data/models';

const values = [
  {
    icon: Globe2,
    title: 'Source for the world',
    description:
      'China’s frontier models shouldn’t need a local ID, a local card, or a VPN to reach — and shouldn’t cost a fortune either. We deliver them, at the source, at prices any developer can afford.',
    tile: 'bg-brush-violet shadow-violet-500/25',
  },
  {
    icon: Paintbrush,
    title: 'Radical simplicity',
    description:
      'One key, one endpoint, one bill. If integrating us takes longer than a coffee break, that’s our bug, not your problem.',
    tile: 'bg-brush-orange shadow-orange-500/25',
  },
  {
    icon: Tag,
    title: 'Honest pricing',
    description:
      'Published per-token rates, no subscription traps, and free tiers that stay free. You should always know what a request costs.',
    tile: 'bg-brush-cyan shadow-cyan-500/25',
  },
  {
    icon: EyeOff,
    title: 'Privacy by design',
    description:
      'We collect only what your account needs to function. No trackers, no analytics, no ads — your prompts are never stored, sold, or used to profile you.',
    tile: 'bg-brush-rose shadow-rose-500/25',
  },
];
---

<BaseLayout
  title="About"
  description="BrushLLM delivers the source of China’s frontier AI to developers in every country — one OpenAI-compatible endpoint, one key, one bill."
>
  <section class="relative mx-auto max-w-4xl px-4 py-16 sm:px-6">
<BrushStroke shape="sweep" color="violet" class="pointer-events-none absolute -top-10 -right-44 w-[620px] rotate-2 opacity-15" />

    <p class="text-sm font-semibold uppercase tracking-widest text-brush-violet">About</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-balance sm:text-5xl">
      China’s AI, served at the
      <span class="relative inline-block px-1">
        <BrushStroke shape="highlight" color="violet" class="absolute inset-x-0 top-1/2 h-[0.78em] -translate-y-[42%] -rotate-1 opacity-25" />
        <span class="relative whitespace-nowrap text-ink">source</span>
      </span>
      — for everyone
    </h1>

    <div class="mt-8 space-y-5 text-lg leading-relaxed text-muted">
      <p>
        DeepSeek, Qwen, GLM, Kimi — the labs behind these models are pushing the frontier of coding,
        reasoning and agentic AI. But if you’re a developer outside mainland China, actually
        <em>using</em> them means juggling local accounts, payments and docs in a language your
        stack doesn’t speak.
      </p>
      <p>
        BrushLLM exists to close that gap — and to go one step further. We aggregate
        {models.length} models from China’s leading labs, plus ChatGPT and text-to-image, behind a
        single OpenAI-compatible endpoint billed in USD, documented in English, and reachable from
        anywhere. Your code stays the same — only the base URL changes.
      </p>
      <p>
        Our mission is simple: make frontier AI affordable and effortless for the world — every
        country, every region, every developer with an idea worth building — and protect your
        privacy at every hop. Beyond the gateway, Image Studio wraps the same models in a
        browser-based AI photo editor, coming soon.
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        values.map((value) => (
          <div class="reveal rounded-2xl border border-stone-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-violet-300 hover:shadow-lg">
            <div class={`flex h-11 w-11 items-center justify-center rounded-xl text-white shadow-lg ${value.tile}`}>
              <value.icon class="h-5 w-5" aria-hidden="true" />
            </div>
            <h2 class="mt-4 font-semibold">{value.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-muted">{value.description}</p>
          </div>
        ))
      }
    </div>

    <div class="reveal mt-12 rounded-2xl border border-stone-200 bg-white p-8 shadow-sm">
      <h2 class="text-xl font-bold tracking-tight">Talk to us</h2>
      <p class="mt-2 text-sm leading-relaxed text-muted">
        Questions, volume pricing, or a model you’d like us to add — we read everything.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href={`mailto:${SITE.contactEmail}`}
          class="inline-flex items-center gap-2 rounded-xl border border-stone-300 bg-white px-5 py-2.5 text-sm font-semibold text-ink shadow-sm transition hover:border-violet-400 hover:text-brush-violet"
        >
          {SITE.contactEmail}
        </a>
        <a
          href={LINKS.signUp}
          class="group inline-flex items-center gap-2 rounded-xl bg-brush-violet px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-violet-500/25 transition hover:bg-violet-700"
        >
          Get started
          <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
