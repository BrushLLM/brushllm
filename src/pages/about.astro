---
import { ArrowRight, EyeOff, Globe2, Paintbrush, Tag } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrushStroke from '../components/BrushStroke.astro';
import { LINKS, SITE } from '../config';
import { models } from '../data/models';

const values = [
  {
    icon: Globe2,
    title: 'Open to the world',
    description:
      'Frontier AI shouldn’t need separate accounts, local payment hoops, or region locks — and shouldn’t cost a fortune either. One signup, in USD, from any country',
    tile: 'bg-brush-violet text-white shadow-violet-500/25',
  },
  {
    icon: Paintbrush,
    title: 'One platform, one account',
    description:
      'One platform, one account, one bill. If integrating us takes longer than a coffee break, that’s our bug, not your problem',
    tile: 'bg-brush-orange text-ink shadow-orange-500/25',
  },
  {
    icon: Tag,
    title: 'Honest pricing',
    description:
      'Published per-token rates, no subscription traps, and free tiers that stay free. You should always know what a request costs',
    tile: 'bg-brush-mint text-ink shadow-mint-600/25',
  },
  {
    icon: EyeOff,
    title: 'Privacy by design',
    description:
      'We collect only what your account needs to function. No trackers, no analytics, no ads — your prompts are never stored, sold, or used to profile you',
    tile: 'bg-brush-violet text-white shadow-violet-500/25',
  },
];
---

<BaseLayout
  title="About"
  description="BrushLLM builds AI products for both developers and creators — a unified API for powerful AI models, and free local-first desktop apps for images, video and media."
>
  <section class="relative mx-auto max-w-4xl overflow-hidden px-4 py-16 sm:px-6">
<BrushStroke shape="sweep" color="violet" class="pointer-events-none absolute -top-10 -right-44 w-[620px] rotate-2 opacity-15" />

    <p class="text-sm font-semibold uppercase tracking-widest text-brush-violet">About</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-balance sm:text-5xl">
      AI products for
      <span class="brush-band text-ink">developers and creators</span>
    </h1>

    <div class="mt-8 space-y-5 text-lg leading-relaxed text-muted">
      <p>
        BrushLLM builds AI products for both developers and creators. One platform, one
        account — and the same promise in each: simple tools, published prices, privacy by
        design.
      </p>
      <p>
        <strong class="text-ink">For developers.</strong>
        <a href="/models" class="font-semibold text-brush-violet hover:text-violet-700">AI Model Services</a>
        — a unified API for accessing powerful AI models. {models.length} models from DeepSeek,
        Qwen, GLM, Kimi, MiniMax, OpenAI and more, behind one OpenAI-compatible endpoint.
      </p>
      <p>
        <strong class="text-ink">For creators.</strong>
        <a href="/apps" class="font-semibold text-brush-violet hover:text-violet-700">Image Studio, Video Studio and Player</a>
        — free local-first desktop apps for macOS and Windows. Image Studio pairs free local
        tools with AI editing through the same API; all three are open source with zero telemetry.
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        values.map((value) => (
          <div class="reveal rounded-2xl border border-stone-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-violet-300 hover:shadow-lg">
            <div class={`flex h-11 w-11 items-center justify-center rounded-xl shadow-lg ${value.tile}`}>
              <value.icon class="h-5 w-5" aria-hidden="true" />
            </div>
            <h2 class="mt-4 font-semibold">{value.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-muted">{value.description}</p>
          </div>
        ))
      }
    </div>

    <div class="reveal mt-12 rounded-2xl border border-stone-200 bg-white p-8 shadow-sm">
      <h2 class="text-xl font-bold tracking-tight">Talk to us</h2>
      <p class="mt-2 text-sm leading-relaxed text-muted">
        Questions, volume pricing, or a model you’d like us to add — we read everything
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href={`mailto:${SITE.contactEmail}`}
          class="inline-flex items-center gap-2 rounded-xl border border-stone-300 bg-white px-5 py-2.5 text-sm font-semibold text-ink shadow-sm transition hover:border-violet-400 hover:text-brush-violet"
        >
          {SITE.contactEmail}
        </a>
        <a
          href={LINKS.signUp}
          class="group inline-flex items-center gap-2 rounded-xl bg-brush-violet px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-violet-500/25 transition hover:bg-violet-700"
        >
          Get started
          <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
