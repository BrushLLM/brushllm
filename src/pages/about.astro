---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LINKS, SITE } from '../config';
import { models } from '../data/models';
import { providers } from '../data/providers';

const values = [
  {
    title: 'Open access',
    description:
      'The best models in the world aren’t all built in one country. We make China’s frontier LLMs as easy to call as any API from the US.',
  },
  {
    title: 'Radical simplicity',
    description:
      'One key, one endpoint, one bill. If integrating us takes longer than a coffee break, that’s our bug, not your problem.',
  },
  {
    title: 'Honest pricing',
    description:
      'Published per-token rates, no subscription traps, and free tiers that stay free. You should always know what a request costs.',
  },
];
---

<BaseLayout
  title="About"
  description="BrushLLM exists to make China’s frontier LLMs effortlessly reachable for developers everywhere — one OpenAI-compatible endpoint, one key, one bill."
>
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-widest text-accent">About</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
      China’s models deserve a global front door
    </h1>

    <div class="mt-8 space-y-5 text-lg leading-relaxed text-stone-600">
      <p>
        DeepSeek, Qwen, GLM, Kimi — the labs behind these models are pushing the frontier of coding,
        reasoning and agentic AI. But if you’re a developer outside mainland China, actually
        <em>using</em> them means juggling local accounts, payments and docs in a language your
        stack doesn’t speak.
      </p>
      <p>
        BrushLLM removes that friction. We aggregate {models.length} models from
        {providers.length} leading Chinese AI labs behind a single OpenAI-compatible endpoint,
        billed in USD, documented in English, and reachable from anywhere. Your code stays the same
        — only the base URL changes.
      </p>
      <p>
        The name is our mission: a brush (笔) writes with ink; BrushLLM writes with China’s best
        models.
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-3">
      {
        values.map((value) => (
          <div class="rounded-2xl border border-stone-200 bg-white p-6">
            <h2 class="font-semibold">{value.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-stone-600">{value.description}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-12 rounded-2xl border border-stone-200 bg-white p-8">
      <h2 class="text-xl font-bold tracking-tight">Talk to us</h2>
      <p class="mt-2 text-sm leading-relaxed text-stone-600">
        Questions, volume pricing, or a model you’d like us to add — we read everything.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href={`mailto:${SITE.contactEmail}`}
          class="rounded-xl border border-stone-300 bg-white px-5 py-2.5 text-sm font-semibold text-stone-700 transition hover:border-accent/50 hover:text-accent"
        >
          {SITE.contactEmail}
        </a>
        <a
          href={LINKS.signUp}
          class="rounded-xl bg-accent px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-accent-strong"
        >
          Get started
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
