---
import { ArrowRight, LifeBuoy } from '@lucide/astro';
import BrushStroke from '../components/BrushStroke.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CodeTabs from '../components/CodeTabs.astro';
import { LINKS, SITE } from '../config';
import { formatContext, models } from '../data/models';

const codeTabs = [
  {
    label: 'cURL',
    code: `curl ${LINKS.apiBase}/chat/completions \\
  -H "Authorization: Bearer $BRUSH_LLM_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "model": "deepseek-chat",
    "messages": [
      {"role": "user", "content": "Say hello in three languages."}
    ]
  }'`,
  },
  {
    label: 'Python',
    code: `from openai import OpenAI

client = OpenAI(
    api_key="brsh-...",              # your BrushLLM key
    base_url="${LINKS.apiBase}",
)

stream = client.chat.completions.create(
    model="glm-4.6",
    messages=[{"role": "user", "content": "Say hello in three languages."}],
    stream=True,
)
for chunk in stream:
    print(chunk.choices[0].delta.content or "", end="")`,
  },
  {
    label: 'Node.js',
    code: `import OpenAI from "openai";

const client = new OpenAI({
  apiKey: process.env.BRUSH_LLM_API_KEY,
  baseURL: "${LINKS.apiBase}",
});

const stream = await client.chat.completions.create({
  model: "kimi-k2-0905",
  messages: [{ role: "user", content: "Say hello in three languages." }],
  stream: true,
});
for await (const chunk of stream) {
  process.stdout.write(chunk.choices[0]?.delta?.content ?? "");
}`,
  },
  {
    label: 'Go',
    code: `package main

import (
	"context"
	"fmt"
	"os"

	openai "github.com/sashabaranov/go-openai"
)

func main() {
	cfg := openai.DefaultConfig(os.Getenv("BRUSH_LLM_API_KEY"))
	cfg.BaseURL = "${LINKS.apiBase}"
	client := openai.NewClientWithConfig(cfg)

	resp, err := client.CreateChatCompletion(context.Background(),
		openai.ChatCompletionRequest{
			Model:    "qwen3-max",
			Messages: []openai.ChatCompletionMessage{{Role: "user", Content: "Say hello in three languages."}},
		})
	if err != nil {
		panic(err)
	}
	fmt.Println(resp.Choices[0].Message.Content)
}`,
  },
];

const errors = [
  {
    code: '401',
    meaning: 'Invalid or missing API key',
    fix: 'Check that your key starts with “brsh-” and hasn’t been revoked in the console.',
  },
  {
    code: '404',
    meaning: 'Unknown model id',
    fix: 'Use an id exactly as listed in the table above — they are case-sensitive.',
  },
  {
    code: '429',
    meaning: 'Rate limit or quota exceeded',
    fix: 'Wait and retry with backoff, or raise the quota for this key in the console.',
  },
  {
    code: '402',
    meaning: 'Insufficient balance',
    fix: 'Top up your account in the console and retry the request.',
  },
  {
    code: '5xx',
    meaning: 'Upstream provider error',
    fix: 'Retry after a few seconds; if it persists, switch to another model id or contact support.',
  },
];
---

<BaseLayout
  title="Docs"
  description={`Quickstart guide for the BrushLLM API — authentication, an OpenAI-compatible base URL, SDK examples in four languages, and the full list of model ids.`}
>
  <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-widest text-brush-cyan">Documentation</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
      Quickstart, <span class="relative inline-block">brushstroke quick<BrushStroke shape="underline" color="cyan" class="absolute -bottom-2 left-0 h-2.5 w-full" /></span>
    </h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
      BrushLLM is an OpenAI-compatible gateway. If you’ve ever called the OpenAI API, you already
      know how to call BrushLLM — here’s the thirty-second version.
    </p>

    <!-- Steps -->
    <ol class="mt-12 space-y-5">
      <li class="reveal flex gap-5 rounded-2xl border border-stone-200 bg-white p-6 shadow-sm transition hover:border-violet-300">
        <span class="bg-brush-violet flex h-10 w-10 shrink-0 items-center justify-center rounded-xl font-bold text-white shadow-lg shadow-violet-500/25">1</span>
        <div>
          <h2 class="font-semibold">Get an API key</h2>
          <p class="mt-1.5 text-sm leading-relaxed text-muted">
            <a href={LINKS.signUp} class="font-semibold text-brush-violet hover:text-violet-700">Create an account</a>
            or <a href={LINKS.signIn} class="font-semibold text-brush-violet hover:text-violet-700">sign in</a> to the console, then create a
            key. Keys look like <code class="rounded bg-stone-100 px-1.5 py-0.5 font-mono text-xs">brsh-…</code> — treat them
            like passwords and set a spend quota if you hand them to tools.
          </p>
        </div>
      </li>
      <li class="reveal flex gap-5 rounded-2xl border border-stone-200 bg-white p-6 shadow-sm transition hover:border-violet-300">
        <span class="bg-brush-violet flex h-10 w-10 shrink-0 items-center justify-center rounded-xl font-bold text-white shadow-lg shadow-violet-500/25">2</span>
        <div>
          <h2 class="font-semibold">Set the base URL and key</h2>
          <p class="mt-1.5 text-sm leading-relaxed text-muted">
            Point any OpenAI SDK at our endpoint:
          </p>
          <div class="mt-3 space-y-1.5">
            <p class="font-mono text-xs text-stone-500">base_url</p>
            <code class="block rounded-lg bg-stone-100 px-3 py-2 font-mono text-sm">{LINKS.apiBase}</code>
          </div>
        </div>
      </li>
      <li class="reveal flex gap-5 rounded-2xl border border-stone-200 bg-white p-6 shadow-sm transition hover:border-violet-300">
        <span class="bg-brush-violet flex h-10 w-10 shrink-0 items-center justify-center rounded-xl font-bold text-white shadow-lg shadow-violet-500/25">3</span>
        <div>
          <h2 class="font-semibold">Call any model by id</h2>
          <p class="mt-1.5 text-sm leading-relaxed text-muted">
            Pass one of the ids from the table below as
            <code class="rounded bg-stone-100 px-1.5 py-0.5 font-mono text-xs">model</code>. That’s it — you’re calling
            models from the world’s top labs.
          </p>
        </div>
      </li>
    </ol>

    <!-- Code -->
    <h2 class="reveal mt-16 text-2xl font-bold tracking-tight" id="examples">Your first request</h2>
    <p class="reveal mt-3 text-muted">
      The same request in four languages — including streaming. Copy, paste, run.
    </p>
    <div class="reveal mt-6">
      <CodeTabs tabs={codeTabs} />
    </div>

    <!-- Model ids -->
    <h2 class="reveal mt-16 text-2xl font-bold tracking-tight" id="model-ids">Model ids</h2>
    <p class="reveal mt-3 text-muted">
      Use these exact ids (case-sensitive). See the
      <a href="/models" class="font-semibold text-brush-violet hover:text-violet-700">models page</a> for descriptions and capabilities.
      Image models are called via <code class="rounded bg-stone-100 px-1.5 py-0.5 font-mono text-xs">POST /v1/images/generations</code>
      with the same API key.
    </p>
    <div class="reveal mt-6 overflow-x-auto rounded-2xl border border-stone-200 bg-white shadow-sm">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-stone-100 bg-stone-50 text-xs uppercase tracking-wide text-stone-500">
          <tr>
            <th class="px-4 py-3 font-medium">Model id</th>
            <th class="px-4 py-3 font-medium">Display name</th>
            <th class="px-4 py-3 font-medium">Context</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          {
            models.map((model) => (
              <tr>
                <td class="px-4 py-2.5">
                  <code class="rounded bg-stone-100 px-1.5 py-0.5 font-mono text-xs">{model.id}</code>
                </td>
                <td class="px-4 py-2.5 text-stone-700">{model.name}</td>
                <td class="px-4 py-2.5 text-stone-500">{formatContext(model.context)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <!-- Errors -->
    <h2 class="reveal mt-16 text-2xl font-bold tracking-tight" id="errors">Errors</h2>
    <div class="reveal mt-6 overflow-x-auto rounded-2xl border border-stone-200 bg-white shadow-sm">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-stone-100 bg-stone-50 text-xs uppercase tracking-wide text-stone-500">
          <tr>
            <th class="px-4 py-3 font-medium">Status</th>
            <th class="px-4 py-3 font-medium">Meaning</th>
            <th class="px-4 py-3 font-medium">What to do</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          {
            errors.map((error) => (
              <tr>
                <td class="px-4 py-2.5 font-mono font-semibold text-brush-violet">{error.code}</td>
                <td class="px-4 py-2.5 text-stone-700">{error.meaning}</td>
                <td class="px-4 py-2.5 text-stone-500">{error.fix}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <!-- Help -->
    <div class="reveal relative mt-16 overflow-hidden rounded-3xl border border-stone-200 bg-white p-10 text-center shadow-xl shadow-stone-200/60">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <BrushStroke shape="sweep" color="cyan" class="absolute -top-10 -left-28 w-[480px] -rotate-3 opacity-80" />
        <BrushStroke shape="underline" color="amber" class="absolute right-[14%] -bottom-2 w-52 rotate-2 opacity-70" />
      </div>
      <LifeBuoy class="relative mx-auto h-10 w-10 text-brush-violet" aria-hidden="true" />
      <h2 class="relative mt-4 text-xl font-bold tracking-tight">Stuck on something?</h2>
      <p class="relative mx-auto mt-2 max-w-md text-sm leading-relaxed text-muted">
        Check the console for keys, quotas and billing, or email us at
        <a href={`mailto:${SITE.contactEmail}`} class="font-semibold text-brush-violet underline underline-offset-2">{SITE.contactEmail}</a>.
      </p>
      <a href={LINKS.console} class="group relative mt-6 inline-flex items-center gap-2 rounded-xl bg-brush-violet px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-violet-500/25 transition hover:bg-violet-700">
        Open the console
        <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
      </a>
    </div>
  </div>
</BaseLayout>
