---
import {
  ArrowRight,
  Eraser,
  ImagePlus,
  KeyRound,
  Layers,
  Link2,
  Maximize2,
  Palette,
  PlugZap,
  Sparkles,
  Wand2,
  Wallet,
} from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrushStroke from '../components/BrushStroke.astro';
import CodeTabs from '../components/CodeTabs.astro';
import FAQ from '../components/FAQ.astro';
import ProviderLogo from '../components/ProviderLogo.astro';
import ShinyButton from '../components/ShinyButton.astro';
import { LINKS, SITE } from '../config';
import { models } from '../data/models';
import { visibleProviders } from '../data/providers';
import { compareRows, orAllIn, savePct, fmt } from '../data/compare';
import AppDownload from '../components/AppDownload.astro';
import { apps } from '../data/apps';

/* GEO structured data: the platform's products, stated factually */
const productSchemas: Record<string, unknown>[] = [
  {
    '@type': 'Product',
    '@id': `${SITE.url}/#ai-model-services`,
    name: 'BrushLLM AI Model Services',
    description:
      'Unified API access to multiple AI models through one OpenAI-compatible endpoint. Built for developers, startups, and businesses.',
    url: `${SITE.url}/models`,
    brand: { '@type': 'Brand', name: 'BrushLLM' },
    category: 'AI Model API',
  },
  {
    '@type': 'SoftwareApplication',
    '@id': `${SITE.url}/#image-studio`,
      name: 'BrushLLM Image Studio',
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'macOS, Windows',
      description:
        'Local-first desktop image toolbox — free offline tools for convert, compress, crop and EXIF, plus AI generation and editing through the BrushLLM API, billed per image.',
      url: `${SITE.url}/studio`,
      downloadUrl: 'https://github.com/BrushLLM/brushllm-image-studio/releases',
      brand: { '@type': 'Brand', name: 'BrushLLM' },
  },
  {
    '@type': 'SoftwareApplication',
    '@id': `${SITE.url}/#video-studio`,
      name: 'BrushLLM Video Studio',
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'macOS, Windows',
      description:
        'Free, local-first toolbox for video, audio and subtitle processing — 100% local, zero network requests, 9-language UI.',
      url: `${SITE.url}/video-studio`,
      downloadUrl: 'https://github.com/BrushLLM/brushllm-video-studio/releases',
      brand: { '@type': 'Brand', name: 'BrushLLM' },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${SITE.url}/#player`,
      name: 'BrushLLM Player',
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'macOS, Windows',
      description:
        'Open-source cross-platform media player built on mpv — every format, plus WebDAV, SMB, FTP, Emby and Jellyfin streaming.',
      url: `${SITE.url}/player`,
      downloadUrl: 'https://github.com/BrushLLM/brushllm-player/releases',
      brand: { '@type': 'Brand', name: 'BrushLLM' },
  },
];

const codeTabs = [
  {
    label: 'cURL',
    code: `curl ${LINKS.apiBase}/chat/completions \\
  -H "Authorization: Bearer $BRUSH_LLM_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "model": "deepseek-chat",
    "messages": [
      {"role": "user", "content": "Hello, BrushLLM!"}
    ]
  }'`,
  },
  {
    label: 'Python',
    code: `from openai import OpenAI

client = OpenAI(
    api_key="brsh-...",
    base_url="${LINKS.apiBase}",
)

response = client.chat.completions.create(
    model="glm-4.6",
    messages=[{"role": "user", "content": "Hello, BrushLLM!"}],
)
print(response.choices[0].message.content)`,
  },
  {
    label: 'Node.js',
    code: `import OpenAI from "openai";

const client = new OpenAI({
  apiKey: process.env.BRUSH_LLM_API_KEY,
  baseURL: "${LINKS.apiBase}",
});

const response = await client.chat.completions.create({
  model: "kimi-k2-0905",
  messages: [{ role: "user", content: "Hello, BrushLLM!" }],
});
console.log(response.choices[0].message.content);`,
  },
  {
    label: 'Go',
    code: `package main

import (
	"context"
	"fmt"
	"os"

	openai "github.com/sashabaranov/go-openai"
)

func main() {
	cfg := openai.DefaultConfig(os.Getenv("BRUSH_LLM_API_KEY"))
	cfg.BaseURL = "${LINKS.apiBase}"
	client := openai.NewClientWithConfig(cfg)

	resp, _ := client.CreateChatCompletion(context.Background(),
		openai.ChatCompletionRequest{
			Model:    "qwen3-max",
			Messages: []openai.ChatCompletionMessage{{Role: "user", Content: "Hello, BrushLLM!"}},
		})
	fmt.Println(resp.Choices[0].Message.Content)
}`,
  },
];

/* AI Model Services benefit cards — icon tiles rotate the icon's trio */
const benefitStyles = [
  'bg-brush-violet text-white shadow-violet-500/25',
  'bg-brush-orange text-ink shadow-orange-500/25',
  'bg-brush-mint text-ink shadow-mint-600/25',
  'bg-brush-violet text-white shadow-violet-500/25',
] as const;

const benefits = [
  {
    icon: PlugZap,
    title: 'Unified API',
    description: 'One OpenAI-compatible endpoint for every model. Keep your SDK — change one line and ship',
  },
  {
    icon: Layers,
    title: 'Multiple Models',
    description: `Chat, reasoning, vision and image models from leading labs — ${models.length} models in one catalog`,
  },
  {
    icon: Link2,
    title: 'Simple Integration',
    description: 'Drop-in with any OpenAI SDK. Copy, paste, and run — in cURL, Python, Node.js or Go',
  },
  {
    icon: Wallet,
    title: 'Usage-based Pricing',
    description: 'Pay for what you use — per token or per image, in USD. No subscriptions, and free tiers to start',
  },
];

const steps = [
  {
    icon: KeyRound,
    title: 'Create an account',
    description: 'Sign up with email and grab an API key from the console. No credit card to start',
  },
  {
    icon: Link2,
    title: 'Point your SDK at BrushLLM',
    description: 'Set the base URL and keep the OpenAI SDK you already use',
  },
  {
    icon: Sparkles,
    title: 'Call any model by id',
    description: 'Swap model ids freely — the whole catalog is one key away',
  },
];

/* Marquee: six copies of the provider row. The -50% loop point lands on a
   copy boundary (seamless wrap), and half the track — three copies, ~3.9k px —
   stays wider than any viewport so the track's right end is never exposed. */
const marqueeProviders = Array.from({ length: 6 }, () => visibleProviders).flat();

const developerFaqs = [
  {
    question: 'What is BrushLLM?',
    answer:
      'BrushLLM is an AI platform for developers and creators. AI Model Services gives developers one API for powerful AI models, and a family of free local-first desktop apps — Image Studio, Video Studio and Player — covers the creator side. One account covers the platform.',
  },
  {
    question: 'How does the API work?',
    answer: `Point any OpenAI SDK at ${LINKS.apiBase} and use your BrushLLM key. Chat completions, tool calling, and streaming work the way you already expect.`,
  },
  {
    question: 'Which AI models are available?',
    answer: `The catalog spans ${models.length} models from DeepSeek, Qwen, GLM, Kimi, MiniMax and OpenAI — chat, reasoning, vision and text-to-image. See the full list with live prices on the Models page.`,
  },
  {
    question: 'Is the API OpenAI compatible?',
    answer:
      'Yes, fully. If it works with the OpenAI API, it works with BrushLLM — including coding agents and CLIs like Cursor, Cline, OpenCode and aider.',
  },
  {
    question: 'How is usage billed?',
    answer:
      'Strictly pay-as-you-go in USD — per token for text models, per image for image models. No subscriptions or minimums; several models have free tiers.',
  },
  {
    question: 'Is BrushLLM suitable for startups and businesses?',
    answer:
      'Yes. One endpoint covers every provider, usage-based pricing scales with you, each key carries its own spend quota, and volume discounts are available for committed use.',
  },
  {
    question: 'How do you protect my privacy?',
    answer:
      'We collect only what an account needs to function. No trackers, no analytics, no ads — your prompts are proxied straight to the upstream model and never stored, sold, or used to profile you.',
  },
];

const creatorFaqs = [
  {
    question: 'What is Image Studio?',
    answer:
      'Image Studio is BrushLLM’s free desktop image toolbox. Everyday tools — convert, compress, crop, EXIF — run locally and offline; AI features like background removal and generative fill run through the BrushLLM API, billed per image.',
  },
  {
    question: 'What can I do with Image Studio?',
    answer:
      'Convert, compress, crop and clean up images with free local tools — then generate, remove backgrounds, erase objects, fill and restyle with AI, billed per image.',
  },
  {
    question: 'Can I edit existing images?',
    answer:
      'Yes. Open any image, select a region or the whole canvas, and describe the change — inpainting and background removal are built in.',
  },
  {
    question: 'Can I generate and transform images?',
    answer:
      'Yes — text-to-image generation and restyling run in the same workspace, powered by GPT-Image through the BrushLLM API.',
  },
  {
    question: 'Where do I get the apps?',
    answer:
      'All three apps — Image Studio, Video Studio and Player — are available now from the BrushLLM GitHub releases, for macOS (Apple Silicon) and Windows.',
  },
  {
    question: 'Are the apps really free?',
    answer:
      'Yes. All local tools are free and the source code is on GitHub. Only AI features in Image Studio use the pay-as-you-go BrushLLM API.',
  },
];
---

<BaseLayout faqSchema={[...developerFaqs, ...creatorFaqs]} extraSchema={productSchemas}>
  <!-- ═══ Hero ═══ -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <BrushStroke shape="sweep" color="violet" class="absolute -top-8 -left-40 w-[720px] -rotate-6 opacity-20" />
      <BrushStroke shape="sweep" color="mint" class="absolute top-40 -right-52 w-[680px] rotate-3 opacity-15" />
    </div>

    <div class="mx-auto max-w-6xl px-4 pb-20 pt-20 text-center sm:px-6 sm:pt-28">
      <p class="reveal mx-auto inline-flex items-center gap-2 rounded-full border border-stone-200 bg-white px-4 py-1.5 text-xs font-semibold text-stone-600 shadow-sm">
        <span class="h-2 w-2 rounded-full bg-brush-mint"></span>
        For developers · For creators
      </p>

      <h1 class="reveal mx-auto mt-7 max-w-4xl text-5xl font-bold tracking-tight text-balance sm:text-6xl lg:text-7xl">
        Your AI,{' '}
        <span class="brush-band text-ink">Without the Complexity</span>
      </h1>

      <p class="reveal mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-muted">
        Access powerful AI models through one API, and create with free local-first apps
      </p>

      <div class="reveal mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <ShinyButton href={LINKS.signUp}>
          Get API Key
          <ArrowRight class="h-4.5 w-4.5 transition-transform group-hover:translate-x-1" aria-hidden="true" />
        </ShinyButton>
        <ShinyButton
          href="/apps"
          bg="bg-brush-orange"
          hoverBg="group-hover:bg-orange-600"
          shadowColor="shadow-orange-500/25"
          class="text-ink!"
        >
          Desktop Apps
          <ArrowRight class="h-4.5 w-4.5 transition-transform group-hover:translate-x-1" aria-hidden="true" />
        </ShinyButton>
      </div>
      <p class="reveal mt-5 text-sm text-stone-500">One account for the whole platform</p>
    </div>
  </section>

  <!-- ═══ One platform: API + apps ═══ -->
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-brush-violet">One platform</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">One platform, built for developers and creators</h2>
      <p class="mt-4 leading-relaxed text-muted">
        BrushLLM is one platform for developers and creators: unified API access to powerful AI
        models through
        <a href="/models" class="font-semibold text-brush-violet hover:text-violet-700">AI Model Services</a>,
        plus a family of
        <a href="/apps" class="font-semibold text-brush-violet hover:text-violet-700">free local-first desktop apps</a>
        — with Image Studio’s AI features billed through the same API.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      <!-- product 1: AI Model Services -->
      <div class="reveal group rounded-[2rem] border border-stone-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:border-violet-300 hover:shadow-lg">
        <span class="inline-flex items-center gap-2 rounded-full bg-brush-violet px-3 py-1 text-[11px] font-semibold uppercase tracking-widest text-white shadow-md shadow-violet-500/25">
          For developers
        </span>
        <h3 class="mt-4 text-2xl font-bold tracking-tight">AI Model Services</h3>
        <p class="mt-1 font-display text-sm font-semibold text-brush-violet">One API for powerful AI models</p>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Access powerful AI models through a single API — {models.length} models, {visibleProviders.length}
          providers, unified and usage-based.
        </p>
        <ul class="mt-5 space-y-2 text-sm text-muted">
          <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-brush-violet"></span>Unified, OpenAI-compatible endpoint</li>
          <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-brush-violet"></span>Chat, reasoning, vision & image models</li>
          <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-brush-orange"></span>Published prices, pay-as-you-go, free tiers</li>
        </ul>
        <p class="mt-5 text-xs font-medium uppercase tracking-wide text-stone-500">Developers · Startups · Businesses</p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href="/models" class="group/dev inline-flex items-center gap-1.5 rounded-xl bg-brush-violet px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-violet-500/25 transition hover:bg-violet-700">
            Explore AI Models
            <ArrowRight class="h-4 w-4 transition-transform group-hover/dev:translate-x-0.5" aria-hidden="true" />
          </a>
          <a href="/docs" class="inline-flex items-center gap-2 rounded-xl border border-stone-300 bg-white px-5 py-2.5 text-sm font-semibold text-ink shadow-sm transition hover:border-violet-400 hover:text-brush-violet">
            Read the docs
          </a>
        </div>
      </div>

      <!-- product 2: Image Studio -->
      <div class="reveal relative overflow-hidden rounded-[2rem] border border-stone-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:border-orange-300 hover:shadow-lg">
        <div class="pointer-events-none absolute inset-0" aria-hidden="true">
          <BrushStroke shape="sweep" color="orange" class="absolute -top-10 -right-24 w-[420px] rotate-3 opacity-80" />
        </div>
        <span class="relative inline-flex items-center gap-2 rounded-full bg-brush-orange px-3 py-1 text-[11px] font-semibold uppercase tracking-widest text-ink shadow-md shadow-orange-500/25">
          For creators · Free apps
        </span>
        <h3 class="relative mt-4 text-2xl font-bold tracking-tight">Desktop Apps</h3>
        <p class="relative mt-1 font-display text-sm font-semibold text-orange-700">Free local-first tools for everyday work</p>
        <p class="relative mt-3 text-sm leading-relaxed text-muted">
          Image Studio, Video Studio and Player — open-source desktop apps for macOS and
          Windows, zero telemetry. Image Studio’s AI features run on the same API.
        </p>
        <ul class="relative mt-5 flex flex-wrap gap-2">
          {['Image Studio', 'Video Studio', 'Player'].map((cap) => (
            <li class="rounded-full border border-stone-200 bg-stone-50 px-3 py-1 text-xs font-medium text-orange-700">{cap}</li>
          ))}
        </ul>
        <p class="relative mt-5 text-xs font-medium uppercase tracking-wide text-stone-500">Open source · macOS · Windows</p>
        <div class="relative mt-4 flex flex-wrap gap-3">
          <a href="/apps" class="group/create inline-flex items-center gap-1.5 rounded-xl bg-brush-orange px-5 py-2.5 text-sm font-semibold text-ink shadow-lg shadow-orange-500/25 transition hover:bg-orange-600">
            Explore the apps
            <ArrowRight class="h-4 w-4 transition-transform group-hover/create:translate-x-0.5" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ AI Model Services benefits ═══ -->
  <section class="relative mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <BrushStroke shape="sweep" color="violet" class="absolute top-10 right-0 hidden w-96 rotate-2 opacity-10 lg:block" />
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-brush-violet">Why BrushLLM</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
        Everything you need,
        <span class="relative inline-block">
          <span>nothing you don’t</span>
          <BrushStroke shape="underline" color="orange" class="absolute -bottom-2 left-0 h-2.5 w-full" />
        </span>
      </h2>
      <p class="mt-4 text-muted">Simple, honest tools for building with AI models</p>
    </div>
    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        benefits.map((benefit, i) => (
          <div class="reveal group rounded-3xl border border-stone-200 bg-white p-7 shadow-sm transition duration-300 hover:-translate-y-1.5 hover:border-violet-300 hover:shadow-lg hover:shadow-violet-100">
            <div class={`flex h-12 w-12 items-center justify-center rounded-2xl shadow-lg ${benefitStyles[i % benefitStyles.length]}`}>
              <benefit.icon class="h-5.5 w-5.5" stroke-width={2} aria-hidden="true" />
            </div>
            <h3 class="mt-5 text-lg font-semibold">{benefit.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{benefit.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ═══ Apps: the BrushLLM desktop family ═══ -->
  <section id="apps" class="border-y border-stone-100 bg-stone-50/50">
    <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-brush-violet">Apps</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl">
          Free local-first apps,
          <span class="relative inline-block">
            <span>built on one platform</span>
            <BrushStroke shape="underline" color="orange" class="absolute -bottom-2 left-0 h-2.5 w-full" />
          </span>
        </h2>
        <p class="mt-4 text-muted">
          Three open-source desktop tools for macOS and Windows — zero telemetry, zero accounts.
          Image Studio’s AI features plug straight into the BrushLLM API.
        </p>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {
          apps.map((app) => (
            <div class="reveal group flex flex-col rounded-[2rem] border border-stone-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:border-violet-300 hover:shadow-lg">
              <img src={app.icon} alt="" width="64" height="64" class="h-16 w-16 rounded-2xl shadow-lg shadow-stone-300/50" />
              <h3 class="mt-5 text-xl font-bold tracking-tight"><a href={app.href} class="transition-colors hover:text-brush-violet">{app.name}</a></h3>
              <p class="mt-1 font-display text-sm font-semibold text-brush-violet">{app.tagline}</p>
              <p class="mt-3 text-sm leading-relaxed text-muted">{app.description}</p>
              <ul class="mt-4 flex flex-wrap gap-1.5">
                {app.highlights.map((h) => (
                  <li class="rounded-full border border-stone-200 bg-stone-50 px-2.5 py-1 text-[11px] font-medium text-stone-600">{h}</li>
                ))}
              </ul>
              <p class="mt-4 text-xs font-medium uppercase tracking-wide text-stone-500">{app.platforms.join(' · ')}</p>
              <div class="mt-auto pt-6">
                <AppDownload releases={app.releases} repo={app.repo} />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ Available models + stats ═══ -->
  <section class="border-b border-stone-100 py-10">
    <h2 class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-stone-400">
      Available models, one API
    </h2>
    <div class="marquee relative mt-7 overflow-hidden [mask-image:linear-gradient(90deg,transparent,black_24%,black_76%,transparent)]">
      <div class="marquee-track flex gap-3 pr-3">
        {
          marqueeProviders.map((provider) => (
            <div class="flex shrink-0 items-center gap-3 rounded-2xl border border-stone-200 bg-white px-5 py-4 shadow-sm transition hover:-translate-y-0.5 hover:border-violet-300">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-stone-50">
                <ProviderLogo provider={provider.id} class="h-6 w-6" />
              </span>
              <span class="block text-sm font-semibold">{provider.name}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-stone-100">
    <div class="mx-auto grid max-w-6xl grid-cols-2 divide-stone-100 px-4 py-14 text-center sm:grid-cols-4 sm:divide-x sm:px-6">
      <div class="reveal p-4">
        <p class="text-4xl font-bold text-brush-violet sm:text-5xl" data-count-to={visibleProviders.length} data-suffix="+">{visibleProviders.length}+</p>
        <p class="mt-1.5 text-sm text-muted">AI providers</p>
      </div>
      <div class="reveal p-4">
        <p class="text-4xl font-bold text-brush-orange sm:text-5xl" data-count-to={models.length} data-suffix="+">{models.length}+</p>
        <p class="mt-1.5 text-sm text-muted">Models, one catalog</p>
      </div>
      <div class="reveal p-4">
        <p class="text-4xl font-bold text-mint-700 sm:text-5xl">1</p>
        <p class="mt-1.5 text-sm text-muted">Account</p>
      </div>
      <div class="reveal p-4">
        <p class="text-4xl font-bold text-brush-violet sm:text-5xl" data-count-to="195">195</p>
        <p class="mt-1.5 text-sm text-muted">Countries served</p>
      </div>
    </div>
  </section>

  <!-- ═══ Price check vs OpenRouter ═══ -->
  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-brush-violet">Price check</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          Same models,
          <span class="relative inline-block">
            <span>smaller all-in bills</span>
            <BrushStroke shape="underline" color="orange" class="absolute -bottom-2 left-0 h-2.5 w-full" />
          </span>
        </h2>
        <p class="mt-4 text-muted">
          OpenRouter adds a payment fee when you buy credits — 5.5% by card — on top of every
          model’s list price. BrushLLM’s published rate is the final rate you pay.
        </p>
      </div>

      <div class="reveal mx-auto mt-12 max-w-4xl overflow-x-auto rounded-2xl border border-stone-200 bg-white shadow-sm">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-stone-100 bg-stone-50 text-xs uppercase tracking-wide text-stone-500">
            <tr>
              <th class="px-4 py-3 font-medium">Model</th>
