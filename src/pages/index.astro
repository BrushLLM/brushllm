---
import {
  ArrowRight,
  EyeOff,
  Globe2,
  KeyRound,
  Layers,
  Link2,
  PlugZap,
  ShieldCheck,
  Sparkles,
  Wallet,
} from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrushStroke from '../components/BrushStroke.astro';
import CodeTabs from '../components/CodeTabs.astro';
import FAQ from '../components/FAQ.astro';
import ProviderLogo from '../components/ProviderLogo.astro';
import { LINKS } from '../config';
import { models } from '../data/models';
import { visibleProviders } from '../data/providers';

const codeTabs = [
  {
    label: 'cURL',
    code: `curl ${LINKS.apiBase}/chat/completions \\
  -H "Authorization: Bearer $BRUSH_LLM_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "model": "deepseek-chat",
    "messages": [
      {"role": "user", "content": "Hello, BrushLLM!"}
    ]
  }'`,
  },
  {
    label: 'Python',
    code: `from openai import OpenAI

client = OpenAI(
    api_key="brsh-...",
    base_url="${LINKS.apiBase}",
)

response = client.chat.completions.create(
    model="glm-4.6",
    messages=[{"role": "user", "content": "Hello, BrushLLM!"}],
)
print(response.choices[0].message.content)`,
  },
  {
    label: 'Node.js',
    code: `import OpenAI from "openai";

const client = new OpenAI({
  apiKey: process.env.BRUSH_LLM_API_KEY,
  baseURL: "${LINKS.apiBase}",
});

const response = await client.chat.completions.create({
  model: "kimi-k2-0905",
  messages: [{ role: "user", content: "Hello, BrushLLM!" }],
});
console.log(response.choices[0].message.content);`,
  },
  {
    label: 'Go',
    code: `package main

import (
	"context"
	"fmt"
	"os"

	openai "github.com/sashabaranov/go-openai"
)

func main() {
	cfg := openai.DefaultConfig(os.Getenv("BRUSH_LLM_API_KEY"))
	cfg.BaseURL = "${LINKS.apiBase}"
	client := openai.NewClientWithConfig(cfg)

	resp, _ := client.CreateChatCompletion(context.Background(),
		openai.ChatCompletionRequest{
			Model:    "qwen3-max",
			Messages: []openai.ChatCompletionMessage{{Role: "user", Content: "Hello, BrushLLM!"}},
		})
	fmt.Println(resp.Choices[0].Message.Content)
}`,
  },
];

/* feature cards: solid color icon tiles */
const featureStyles = [
  'bg-brush-violet shadow-violet-500/25',
  'bg-brush-cyan shadow-cyan-500/25',
  'bg-brush-orange shadow-orange-500/25',
  'bg-brush-amber shadow-amber-500/25',
  'bg-brush-rose shadow-rose-500/25',
  'bg-brush-blue shadow-blue-500/25',
] as const;

const features = [
  {
    icon: PlugZap,
    title: 'OpenAI-compatible API',
    description:
      'Keep your existing SDK and code. Change one base URL and every request just works — chat, tools, and streaming.',
  },
  {
    icon: Layers,
    title: 'Six labs, one key',
    description: `DeepSeek, Qwen, GLM, Kimi, Doubao and MiniMax — ${models.length} models behind a single API key.`,
  },
  {
    icon: Globe2,
    title: 'Built for every country',
    description:
      'No mainland-China accounts, local phone numbers, or separate billing per lab. Sign up from anywhere on earth and start calling in under a minute.',
  },
  {
    icon: Wallet,
    title: 'Pay-as-you-go pricing',
    description:
      'Per-token billing with no subscriptions and no minimums. Several models — including GLM-4.5 Flash and Doubao Seed 1.6 Flash — are free.',
  },
  {
    icon: ShieldCheck,
    title: 'Keys with guardrails',
    description:
      'Create multiple API keys, set spend quotas per key, and monitor usage from the console — safe to hand keys to agents and teammates.',
  },
  {
    icon: EyeOff,
    title: 'Your privacy, protected',
    description:
      'No trackers, no analytics, no ads. Your prompts are proxied straight to the model and never stored, sold, or used to profile you.',
  },
];

const steps = [
  {
    icon: KeyRound,
    title: 'Create an account',
    description: 'Sign up with email and grab an API key from the console. No credit card to start.',
  },
  {
    icon: Link2,
    title: 'Point your SDK at BrushLLM',
    description: 'Set the base URL and keep the OpenAI SDK you already use.',
  },
  {
    icon: Sparkles,
    title: 'Call any model by id',
    description: 'Swap model ids freely — the whole catalog is one key away.',
  },
];

const faqs = [
  {
    question: 'What is BrushLLM?',
    answer:
      'BrushLLM is the source of China’s frontier AI for the world: a gateway that connects developers in every country directly to the leading Chinese labs — DeepSeek, Qwen, GLM, Kimi and more — through one OpenAI-compatible endpoint.',
  },
  {
    question: 'Is it really drop-in compatible with the OpenAI SDK?',
    answer: `Yes. Point your SDK’s base URL at ${LINKS.apiBase} and use your BrushLLM key. Chat completions, tool calling, and streaming work the way you expect — only the model ids change.`,
  },
  {
    question: 'How does billing work?',
    answer:
      'Strictly pay-as-you-go per token, in USD. There are no subscriptions or minimums, and several models have free tiers. Top up and track spend from the console.',
  },
  {
    question: 'How do you protect my privacy?',
    answer:
      'We collect only what an account needs to function. No trackers, no analytics, no ads — your prompts are proxied straight to the upstream model and never stored, sold, or used to profile you.',
  },
  {
    question: 'Do I need a mainland China account or VPN?',
    answer:
      'No. BrushLLM is built for developers everywhere: you sign up with an email, pay in USD, and reach every model through our endpoint — no local accounts or special network setup required.',
  },
  {
    question: 'Which model should I start with?',
    answer:
      'DeepSeek-V3.2 is a great default for chat and tools, GLM-4.6 and Qwen3-Max excel at coding and agentic workflows, and DeepSeek-R1 or Kimi K2 Thinking for hard reasoning. Browse the full catalog with live prices on the Models page.',
  },
  {
    question: 'Can I use my key in coding agents and CLIs?',
    answer:
      'Yes — anything that speaks the OpenAI API works. Set the base URL and API key in your tool’s config (Cursor, Cline, OpenCode, aider and similar) and pick any model id from the catalog.',
  },
];


---

<BaseLayout>
  <!-- ═══ Hero: white canvas, color in the swipes ═══ -->
  <section class="relative overflow-hidden">
    <!-- decorative long swipes crossing the corners -->
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <BrushStroke shape="sweep" color="cyan" class="absolute -top-8 -left-40 w-[720px] -rotate-6 opacity-20" />
      <BrushStroke shape="sweep" color="orange" class="absolute top-40 -right-52 w-[680px] rotate-3 opacity-15" />
    </div>

    <div class="mx-auto max-w-6xl px-4 pb-20 pt-20 text-center sm:px-6 sm:pt-28">
      <p class="reveal mx-auto inline-flex items-center gap-2 rounded-full border border-stone-200 bg-white px-4 py-1.5 text-xs font-semibold text-brush-violet shadow-sm">
        <span class="h-2 w-2 rounded-full bg-brush-fuchsia"></span>
        {models.length} models · {visibleProviders.length} Chinese labs · one endpoint
      </p>

      <h1 class="reveal mx-auto mt-7 max-w-4xl text-5xl font-bold tracking-tight text-balance sm:text-6xl lg:text-7xl">
        China’s AI,
        <span class="relative inline-block px-0.5">
          <BrushStroke shape="highlight" color="violet" class="absolute inset-x-0 top-1/2 h-[0.78em] -translate-y-[42%] -rotate-1 opacity-25" />
          <span class="relative whitespace-nowrap text-ink">straight from</span>
        </span>
        {' '}
        <span class="relative inline-block px-0.5">
          <BrushStroke shape="highlight" color="orange" class="absolute inset-x-0 top-1/2 h-[0.78em] -translate-y-[42%] rotate-1 opacity-25" />
          <span class="relative whitespace-nowrap text-ink">the source</span>
        </span>
      </h1>

      <p class="reveal mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-muted">
        BrushLLM connects developers in every country directly to China’s frontier models —
        DeepSeek, Qwen, GLM, Kimi, Doubao and more — through one OpenAI-compatible endpoint,
        at honest pay-as-you-go prices.
      </p>

      <div class="reveal mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={LINKS.signUp}
          class="group inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-brush-violet px-8 py-4 text-base font-semibold text-white shadow-xl shadow-violet-500/25 transition hover:scale-[1.02] hover:bg-violet-700 sm:w-auto"
        >
          Get my API key
          <ArrowRight class="h-4.5 w-4.5 transition-transform group-hover:translate-x-1" aria-hidden="true" />
        </a>
        <a
          href="/models"
          class="inline-flex w-full items-center justify-center gap-2 rounded-2xl border border-stone-300 bg-white px-8 py-4 text-base font-semibold text-ink shadow-sm transition hover:border-violet-400 hover:text-brush-violet sm:w-auto"
        >
          Browse models
          <ArrowRight class="h-4.5 w-4.5" aria-hidden="true" />
        </a>
      </div>
      <p class="reveal mt-5 text-sm text-stone-500">Free to start · Pay-as-you-go · Set up in 30 seconds</p>
    </div>
  </section>

  <!-- ═══ Provider marquee ═══ -->
  <section class="border-y border-stone-100 py-10">
    <h2 class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-stone-400">
      {visibleProviders.length} leading Chinese AI labs, one gateway
    </h2>
    <div class="marquee relative mt-7 overflow-hidden [mask-image:linear-gradient(90deg,transparent,black_24%,black_76%,transparent)]">
      <div class="marquee-track flex gap-3 pr-3">
        {
          [...visibleProviders, ...visibleProviders].map((provider) => (
            <div class="flex shrink-0 items-center gap-3 rounded-2xl border border-stone-200 bg-white px-5 py-4 shadow-sm transition hover:-translate-y-0.5 hover:border-violet-300">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-stone-50">
                <ProviderLogo provider={provider.id} class="h-6 w-6" />
              </span>
              <span class="block text-sm font-semibold">{provider.name}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ Features ═══ -->
  <section class="relative mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <BrushStroke shape="sweep" color="fuchsia" class="absolute top-10 right-0 hidden w-96 rotate-2 opacity-10 lg:block" />
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-brush-fuchsia">Why BrushLLM</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
        Everything you need,
        <span class="relative inline-block">
          <span>nothing you don’t</span>
          <BrushStroke shape="underline" color="fuchsia" class="absolute -bottom-2 left-0 h-2.5 w-full" />
        </span>
      </h2>
      <p class="mt-4 text-muted">
        A straight path from “somewhere outside China” to “calling DeepSeek in production”.
      </p>
    </div>
    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature, i) => (
          <div class="reveal group rounded-3xl border border-stone-200 bg-white p-7 shadow-sm transition duration-300 hover:-translate-y-1.5 hover:border-violet-300 hover:shadow-lg hover:shadow-violet-100">
            <div class={`flex h-12 w-12 items-center justify-center rounded-2xl text-white shadow-lg ${featureStyles[i % featureStyles.length]}`}>
              <feature.icon class="h-5.5 w-5.5" stroke-width={2} aria-hidden="true" />
            </div>
            <h3 class="mt-5 text-lg font-semibold">{feature.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{feature.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ═══ How it works ═══ -->
  <section class="border-y border-stone-100 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-brush-cyan">How it works</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Three steps to your first token</h2>
      </div>
      <div class="relative mt-16 grid gap-10 md:grid-cols-3">
        <!-- dashed connector -->
        <div class="absolute top-6 right-[16%] left-[16%] hidden border-t-2 border-dashed border-stone-300 md:block" aria-hidden="true"></div>
        {
          steps.map((step, i) => (
            <div class="reveal relative text-center">
              <div class="relative mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-brush-violet text-white shadow-lg shadow-violet-500/25">
                <step.icon class="h-5.5 w-5.5" aria-hidden="true" />
                <span class="absolute -top-2 -right-2 flex h-6 w-6 items-center justify-center rounded-full border-2 border-white bg-ink text-[11px] font-bold text-white">
                  {i + 1}
                </span>
              </div>
              <h3 class="mt-5 text-lg font-semibold">{step.title}</h3>
              <p class="mx-auto mt-2 max-w-xs text-sm leading-relaxed text-muted">{step.description}</p>
            </div>
          ))
        }
      </div>
      <div class="reveal mt-12 rounded-2xl border border-stone-200 bg-white p-5 text-center shadow-sm">
        <p class="font-mono text-sm text-stone-600">
          base_url = <span class="font-semibold text-brush-violet">{LINKS.apiBase}</span>
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ Code examples ═══ -->
  <section class="relative mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-brush-orange">Drop-in compatible</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Keep your code. Change one line.</h2>
      <p class="mt-4 text-muted">
        If it works with the OpenAI API, it works with BrushLLM. Here’s the same request in four languages.
      </p>
    </div>
    <div class="reveal mx-auto mt-10 max-w-3xl">
      <CodeTabs tabs={codeTabs} />
    </div>
  </section>

  <!-- ═══ Stats band ═══ -->
  <section class="border-y border-stone-100">
    <div class="mx-auto grid max-w-6xl grid-cols-2 divide-stone-100 px-4 py-14 text-center sm:grid-cols-4 sm:divide-x sm:px-6">
      <div class="reveal p-4">
        <p class="text-4xl font-bold text-brush-violet sm:text-5xl" data-count-to={visibleProviders.length} data-suffix="+">{visibleProviders.length}+</p>
        <p class="mt-1.5 text-sm text-muted">Chinese AI labs</p>
      </div>
      <div class="reveal p-4">
        <p class="text-4xl font-bold text-brush-cyan sm:text-5xl" data-count-to={models.length} data-suffix="+">{models.length}+</p>
        <p class="mt-1.5 text-sm text-muted">Models, one catalog</p>
      </div>
      <div class="reveal p-4">
        <p class="text-4xl font-bold text-brush-orange sm:text-5xl">1</p>
        <p class="mt-1.5 text-sm text-muted">API key</p>
      </div>
      <div class="reveal p-4">
        <p class="text-4xl font-bold text-brush-fuchsia sm:text-5xl" data-count-to="195">195</p>
        <p class="mt-1.5 text-sm text-muted">Countries served</p>
      </div>
    </div>
  </section>

  <!-- ═══ FAQ ═══ -->
  <section class="border-t border-stone-100">
    <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-brush-violet">FAQ</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Questions, answered</h2>
      </div>
      <div class="reveal mt-10">
        <FAQ faqs={faqs} />
      </div>
    </div>
  </section>

  <!-- ═══ Final CTA: white card, swipes crossing inside ═══ -->
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <div class="reveal relative overflow-hidden rounded-[2rem] border border-stone-200 bg-white px-6 py-20 text-center shadow-xl shadow-stone-200/60 sm:px-16">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <BrushStroke shape="sweep" color="violet" class="absolute -top-10 -left-24 w-[560px] -rotate-6 opacity-80" />
        <BrushStroke shape="sweep" color="orange" class="absolute -right-32 -bottom-16 w-[560px] rotate-3 opacity-70" />
        <BrushStroke shape="underline" color="cyan" class="absolute right-[12%] bottom-16 w-56 rotate-2 opacity-70" />
      </div>
      <h2 class="relative text-3xl font-bold tracking-tight sm:text-4xl">
        Paint with China’s best models
      </h2>
      <p class="relative mx-auto mt-4 max-w-xl text-muted">
        One key, {models.length} models, {visibleProviders.length} labs — from the source to your code,
        anywhere in the world.
      </p>
      <a
        href={LINKS.signUp}
        class="group relative mt-9 inline-flex items-center gap-2 rounded-2xl bg-brush-violet px-8 py-4 text-base font-semibold text-white shadow-xl shadow-violet-500/25 transition hover:scale-[1.02] hover:bg-violet-700"
      >
        Get my API key
        <ArrowRight class="h-4.5 w-4.5 transition-transform group-hover:translate-x-1" aria-hidden="true" />
      </a>
    </div>
  </section>

  <script>
    // stat count-up when scrolled into view
    const counters = document.querySelectorAll<HTMLElement>('[data-count-to]');
    const counterObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          counterObserver.unobserve(entry.target);
          const el = entry.target as HTMLElement;
          const target = Number(el.dataset.countTo ?? '0');
          const suffix = el.dataset.suffix ?? '';
          const duration = 900;
          const start = performance.now();
          const tick = (now: number) => {
            const p = Math.min(1, (now - start) / duration);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = `${Math.round(target * eased)}${suffix}`;
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }
      },
      { threshold: 0.5 },
    );
    counters.forEach((el) => counterObserver.observe(el));
  </script>
</BaseLayout>
