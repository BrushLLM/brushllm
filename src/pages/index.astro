---
import {
  ArrowRight,
  Eraser,
  ImagePlus,
  KeyRound,
  Layers,
  Link2,
  Maximize2,
  Palette,
  PlugZap,
  Sparkles,
  Wand2,
  Wallet,
} from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrushStroke from '../components/BrushStroke.astro';
import CodeTabs from '../components/CodeTabs.astro';
import FAQ from '../components/FAQ.astro';
import ProviderLogo from '../components/ProviderLogo.astro';
import ShinyButton from '../components/ShinyButton.astro';
import { LINKS, SITE } from '../config';
import { models } from '../data/models';
import { visibleProviders } from '../data/providers';

/* GEO structured data: the two core products, stated factually */
const productSchemas: Record<string, unknown>[] = [
  {
    '@type': 'Product',
    '@id': `${SITE.url}/#ai-model-services`,
    name: 'BrushLLM AI Model Services',
    description:
      'Unified API access to multiple AI models through one OpenAI-compatible endpoint. Built for developers, startups, and businesses.',
    url: `${SITE.url}/models`,
    brand: { '@type': 'Brand', name: 'BrushLLM' },
    category: 'AI Model API',
  },
  {
    '@type': 'SoftwareApplication',
    '@id': `${SITE.url}/#image-studio`,
    name: 'BrushLLM Image Studio',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Web',
    description:
      'AI-powered image creation and editing studio for creators and everyday users — generate, edit, remove, replace, expand, upscale, restyle, and transform images in the browser. Currently in development; early access is open.',
    url: `${SITE.url}/studio`,
    brand: { '@type': 'Brand', name: 'BrushLLM' },
  },
];

const codeTabs = [
  {
    label: 'cURL',
    code: `curl ${LINKS.apiBase}/chat/completions \\
  -H "Authorization: Bearer $BRUSH_LLM_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "model": "deepseek-chat",
    "messages": [
      {"role": "user", "content": "Hello, BrushLLM!"}
    ]
  }'`,
  },
  {
    label: 'Python',
    code: `from openai import OpenAI

client = OpenAI(
    api_key="brsh-...",
    base_url="${LINKS.apiBase}",
)

response = client.chat.completions.create(
    model="glm-4.6",
    messages=[{"role": "user", "content": "Hello, BrushLLM!"}],
)
print(response.choices[0].message.content)`,
  },
  {
    label: 'Node.js',
    code: `import OpenAI from "openai";

const client = new OpenAI({
  apiKey: process.env.BRUSH_LLM_API_KEY,
  baseURL: "${LINKS.apiBase}",
});

const response = await client.chat.completions.create({
  model: "kimi-k2-0905",
  messages: [{ role: "user", content: "Hello, BrushLLM!" }],
});
console.log(response.choices[0].message.content);`,
  },
  {
    label: 'Go',
    code: `package main

import (
	"context"
	"fmt"
	"os"

	openai "github.com/sashabaranov/go-openai"
)

func main() {
	cfg := openai.DefaultConfig(os.Getenv("BRUSH_LLM_API_KEY"))
	cfg.BaseURL = "${LINKS.apiBase}"
	client := openai.NewClientWithConfig(cfg)

	resp, _ := client.CreateChatCompletion(context.Background(),
		openai.ChatCompletionRequest{
			Model:    "qwen3-max",
			Messages: []openai.ChatCompletionMessage{{Role: "user", Content: "Hello, BrushLLM!"}},
		})
	fmt.Println(resp.Choices[0].Message.Content)
}`,
  },
];

/* AI Model Services benefit cards */
const benefitStyles = [
  'bg-brush-violet shadow-violet-500/25',
  'bg-brush-orange shadow-orange-500/25',
  'bg-brush-violet shadow-violet-500/25',
  'bg-brush-orange shadow-orange-500/25',
] as const;

const benefits = [
  {
    icon: PlugZap,
    title: 'Unified API',
    description: 'One OpenAI-compatible endpoint for every model. Keep your SDK — change one line and ship',
  },
  {
    icon: Layers,
    title: 'Multiple Models',
    description: `Chat, reasoning, vision and image models from leading labs — ${models.length} models in one catalog`,
  },
  {
    icon: Link2,
    title: 'Simple Integration',
    description: 'Drop-in with any OpenAI SDK. Copy, paste, and run — in cURL, Python, Node.js or Go',
  },
  {
    icon: Wallet,
    title: 'Usage-based Pricing',
    description: 'Pay for what you use — per token or per image, in USD. No subscriptions, and free tiers to start',
  },
];

const steps = [
  {
    icon: KeyRound,
    title: 'Create an account',
    description: 'Sign up with email and grab an API key from the console. No credit card to start',
  },
  {
    icon: Link2,
    title: 'Point your SDK at BrushLLM',
    description: 'Set the base URL and keep the OpenAI SDK you already use',
  },
  {
    icon: Sparkles,
    title: 'Call any model by id',
    description: 'Swap model ids freely — the whole catalog is one key away',
  },
];

const studioCapabilities = [
  'Generate',
  'Edit',
  'Remove',
  'Replace',
  'Expand',
  'Upscale',
  'Restyle',
  'Transform',
];

/* Marquee: six copies of the provider row. The -50% loop point lands on a
   copy boundary (seamless wrap), and half the track — three copies, ~3.9k px —
   stays wider than any viewport so the track's right end is never exposed. */
const marqueeProviders = Array.from({ length: 6 }, () => visibleProviders).flat();

const developerFaqs = [
  {
    question: 'What is BrushLLM?',
    answer:
      'BrushLLM is an AI platform with two core products. AI Model Services gives developers one API for powerful AI models, and Image Studio is an AI-powered image creation and editing app for everyone. One account covers both.',
  },
  {
    question: 'How does the API work?',
    answer: `Point any OpenAI SDK at ${LINKS.apiBase} and use your BrushLLM key. Chat completions, tool calling, and streaming work the way you already expect.`,
  },
  {
    question: 'Which AI models are available?',
    answer: `The catalog spans ${models.length} models from DeepSeek, Qwen, GLM, Kimi, Doubao, MiniMax and OpenAI — chat, reasoning, vision and text-to-image. See the full list with live prices on the Models page.`,
  },
  {
    question: 'Is the API OpenAI compatible?',
    answer:
      'Yes, fully. If it works with the OpenAI API, it works with BrushLLM — including coding agents and CLIs like Cursor, Cline, OpenCode and aider.',
  },
  {
    question: 'How is usage billed?',
    answer:
      'Strictly pay-as-you-go in USD — per token for text models, per image for image models. No subscriptions or minimums; several models have free tiers.',
  },
  {
    question: 'Is BrushLLM suitable for startups and businesses?',
    answer:
      'Yes. One endpoint covers every provider, usage-based pricing scales with you, each key carries its own spend quota, and volume discounts are available for committed use.',
  },
  {
    question: 'How do you protect my privacy?',
    answer:
      'We collect only what an account needs to function. No trackers, no analytics, no ads — your prompts are proxied straight to the upstream model and never stored, sold, or used to profile you.',
  },
];

const creatorFaqs = [
  {
    question: 'What is Image Studio?',
    answer:
      'Image Studio is BrushLLM’s app for AI-powered image creation and editing — a full workspace in your browser, no installs and no subscriptions. It’s coming soon.',
  },
  {
    question: 'What can I do with Image Studio?',
    answer:
      'Generate new images from text, edit them with plain words, remove or replace objects, expand the canvas, upscale to 4K, and restyle entire photos.',
  },
  {
    question: 'Can I edit existing images?',
    answer:
      'Yes. Upload any image, select a region or the whole canvas, and describe the change — inpainting, outpainting and background removal are all built in.',
  },
  {
    question: 'Can I generate and transform images?',
    answer:
      'Yes — text-to-image generation, style transfer and detail-preserving upscaling all run in the same workspace, powered by GPT-Image, Jimeng and Seedream.',
  },
  {
    question: 'When will Image Studio be available?',
    answer:
      'Image Studio is currently in development and available through early access. Follow the Studio page for updates as it takes shape.',
  },
  {
    question: 'How can I get early access?',
    answer:
      `Email ${'hello@brushllm.com'} with the subject “Image Studio early access” — we onboard early users in small batches and read every message.`,
  },
];
---

<BaseLayout faqSchema={[...developerFaqs, ...creatorFaqs]} extraSchema={productSchemas}>
  <!-- ═══ Hero ═══ -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <BrushStroke shape="sweep" color="violet" class="absolute -top-8 -left-40 w-[720px] -rotate-6 opacity-20" />
      <BrushStroke shape="sweep" color="orange" class="absolute top-40 -right-52 w-[680px] rotate-3 opacity-15" />
    </div>

    <div class="mx-auto max-w-6xl px-4 pb-20 pt-20 text-center sm:px-6 sm:pt-28">
      <p class="reveal mx-auto inline-flex items-center gap-2 rounded-full border border-stone-200 bg-white px-4 py-1.5 text-xs font-semibold text-brush-violet shadow-sm">
        <span class="h-2 w-2 rounded-full bg-brush-orange"></span>
        For developers · For creators
      </p>

      <h1 class="reveal mx-auto mt-7 max-w-4xl text-5xl font-bold tracking-tight text-balance sm:text-6xl lg:text-7xl">
        Your AI,{' '}
        <span class="brush-band text-ink">Without the Complexity</span>
      </h1>

      <p class="reveal mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-muted">
        Access powerful AI models through one API, and create with AI in one studio
      </p>

      <div class="reveal mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <ShinyButton href={LINKS.signUp}>
          Get API Key
          <ArrowRight class="h-4.5 w-4.5 transition-transform group-hover:translate-x-1" aria-hidden="true" />
        </ShinyButton>
        <ShinyButton
          href="/studio"
          bg="bg-brush-orange"
          hoverBg="group-hover:bg-orange-600"
          shadowColor="shadow-orange-500/25"
        >
          Image Studio
          <ArrowRight class="h-4.5 w-4.5 transition-transform group-hover:translate-x-1" aria-hidden="true" />
        </ShinyButton>
      </div>
      <p class="reveal mt-5 text-sm text-stone-500">One account covers both products</p>
    </div>
  </section>

  <!-- ═══ Two products, visually equal ═══ -->
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-brush-violet">Two products</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">One platform, built for developers and creators</h2>
      <p class="mt-4 leading-relaxed text-muted">
        BrushLLM is an AI platform for developers and creators. It provides unified API access to
        AI models through one endpoint —
        <a href="/models" class="font-semibold text-brush-violet hover:text-violet-700">AI Model Services</a>
        — and offers
        <a href="/studio" class="font-semibold text-brush-orange hover:text-orange-700">Image Studio</a>,
        an AI-powered image creation and editing studio.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      <!-- product 1: AI Model Services -->
      <div class="reveal group rounded-[2rem] border border-stone-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:border-violet-300 hover:shadow-lg">
        <span class="inline-flex items-center gap-2 rounded-full bg-brush-violet px-3 py-1 text-[11px] font-semibold uppercase tracking-widest text-white shadow-md shadow-violet-500/25">
          For developers
        </span>
        <h3 class="mt-4 text-2xl font-bold tracking-tight">AI Model Services</h3>
        <p class="mt-1 font-display text-sm font-semibold text-brush-violet">One API for powerful AI models</p>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Access powerful AI models through a single API — {models.length} models, {visibleProviders.length}
          providers, unified and usage-based.
        </p>
        <ul class="mt-5 space-y-2 text-sm text-muted">
          <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-brush-violet"></span>Unified, OpenAI-compatible endpoint</li>
          <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-brush-violet"></span>Chat, reasoning, vision & image models</li>
          <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-brush-orange"></span>Published prices, pay-as-you-go, free tiers</li>
        </ul>
        <p class="mt-5 text-xs font-medium uppercase tracking-wide text-stone-400">Developers · Startups · Businesses</p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href="/models" class="group/dev inline-flex items-center gap-1.5 rounded-xl bg-brush-violet px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-violet-500/25 transition hover:bg-violet-700">
            Explore AI Models
            <ArrowRight class="h-4 w-4 transition-transform group-hover/dev:translate-x-0.5" aria-hidden="true" />
          </a>
          <a href="/docs" class="inline-flex items-center gap-2 rounded-xl border border-stone-300 bg-white px-5 py-2.5 text-sm font-semibold text-ink shadow-sm transition hover:border-violet-400 hover:text-brush-violet">
            Read the docs
          </a>
        </div>
      </div>

      <!-- product 2: Image Studio -->
      <div class="reveal relative overflow-hidden rounded-[2rem] border border-stone-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:border-orange-300 hover:shadow-lg">
        <div class="pointer-events-none absolute inset-0" aria-hidden="true">
          <BrushStroke shape="sweep" color="orange" class="absolute -top-10 -right-24 w-[420px] rotate-3 opacity-80" />
        </div>
        <span class="relative inline-flex items-center gap-2 rounded-full bg-brush-orange px-3 py-1 text-[11px] font-semibold uppercase tracking-widest text-white shadow-md shadow-orange-500/25">
          For creators · Soon
        </span>
        <h3 class="relative mt-4 text-2xl font-bold tracking-tight">Image Studio</h3>
        <p class="relative mt-1 font-display text-sm font-semibold text-brush-orange">AI-powered image creation and editing for everyone</p>
        <p class="relative mt-3 text-sm leading-relaxed text-muted">
          Generate, edit, expand, upscale, and transform images with AI — a full creative
          workspace in your browser. No installs, no subscriptions.
        </p>
        <ul class="relative mt-5 flex flex-wrap gap-2">
          {
            studioCapabilities.map((cap) => (
              <li class="rounded-full border border-stone-200 bg-stone-50 px-3 py-1 text-xs font-medium text-brush-orange">{cap}</li>
            ))
          }
        </ul>
        <p class="relative mt-5 text-xs font-medium uppercase tracking-wide text-stone-400">Creators · Designers · Everyone</p>
        <div class="relative mt-4 flex flex-wrap gap-3">
          <a href="/studio" class="group/create inline-flex items-center gap-1.5 rounded-xl bg-brush-orange px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-orange-500/25 transition hover:bg-orange-600">
            Explore Image Studio
            <ArrowRight class="h-4 w-4 transition-transform group-hover/create:translate-x-0.5" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ AI Model Services benefits ═══ -->
  <section class="relative mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <BrushStroke shape="sweep" color="violet" class="absolute top-10 right-0 hidden w-96 rotate-2 opacity-10 lg:block" />
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-brush-orange">Why BrushLLM</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
        Everything you need,
        <span class="relative inline-block">
          <span>nothing you don’t</span>
          <BrushStroke shape="underline" color="orange" class="absolute -bottom-2 left-0 h-2.5 w-full" />
        </span>
      </h2>
      <p class="mt-4 text-muted">Simple, honest tools for building with AI models</p>
    </div>
    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        benefits.map((benefit, i) => (
          <div class="reveal group rounded-3xl border border-stone-200 bg-white p-7 shadow-sm transition duration-300 hover:-translate-y-1.5 hover:border-violet-300 hover:shadow-lg hover:shadow-violet-100">
            <div class={`flex h-12 w-12 items-center justify-center rounded-2xl text-white shadow-lg ${benefitStyles[i % benefitStyles.length]}`}>
              <benefit.icon class="h-5.5 w-5.5" stroke-width={2} aria-hidden="true" />
            </div>
            <h3 class="mt-5 text-lg font-semibold">{benefit.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{benefit.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ═══ Image Studio showcase ═══ -->
  <section class="border-y border-stone-100 bg-stone-50/50">
    <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-brush-orange">Image Studio</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl">
          A real AI image workspace,
          <span class="relative inline-block">
            <span>coming to your browser</span>
            <BrushStroke shape="underline" color="orange" class="absolute -bottom-2 left-0 h-2.5 w-full" />
          </span>
        </h2>
        <p class="mt-4 text-muted">
          Upload an image and paint changes with plain words — the studio does the rest
        </p>
      </div>

      <!-- product mockup -->
      <div class="reveal mx-auto mt-12 max-w-4xl">
        <div class="overflow-hidden rounded-3xl border border-stone-200 bg-white shadow-xl shadow-stone-300/40">
          <!-- window chrome -->
          <div class="flex items-center gap-3 border-b border-stone-100 bg-stone-50 px-4 py-3">
            <div class="flex gap-1.5" aria-hidden="true">
              <span class="h-3 w-3 rounded-full bg-stone-300"></span>
              <span class="h-3 w-3 rounded-full bg-stone-300"></span>
              <span class="h-3 w-3 rounded-full bg-stone-300"></span>
            </div>
            <p class="flex-1 truncate rounded-lg bg-white px-3 py-1 text-center font-mono text-xs text-stone-500 ring-1 ring-stone-200">
              brushllm.com/studio
            </p>
            <span class="rounded-full bg-brush-orange px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-widest text-white">Soon</span>
          </div>

          <div class="flex flex-col sm:flex-row">
            <!-- canvas: before / after -->
            <div class="relative min-h-[260px] flex-1 overflow-hidden bg-stone-100">
              <!-- before (left) -->
              <div class="absolute inset-y-0 left-0 w-1/2 bg-gradient-to-br from-stone-200 via-stone-300 to-stone-400/60 p-4">
                <span class="absolute left-4 top-4 rounded-full bg-white/80 px-2.5 py-0.5 text-[11px] font-semibold text-stone-600 backdrop-blur">Before</span>
                <div class="absolute bottom-4 left-4 space-y-2 opacity-60">
                  <div class="h-2.5 w-24 rounded bg-stone-500/40"></div>
                  <div class="h-2.5 w-16 rounded bg-stone-500/30"></div>
                </div>
              </div>
              <!-- after (right) -->
              <div class="absolute inset-y-0 right-0 w-1/2 overflow-hidden bg-gradient-to-br from-violet-500/80 via-violet-400/70 to-orange-400/80">
                <BrushStroke shape="sweep" color="violet" class="absolute -bottom-8 -right-16 w-[300px] rotate-6 opacity-70" />
                <span class="absolute right-4 top-4 rounded-full bg-white/85 px-2.5 py-0.5 text-[11px] font-semibold text-brush-orange backdrop-blur">After</span>
                <div class="absolute bottom-4 right-4 rounded-xl bg-white/90 px-3 py-2 text-xs font-medium text-ink shadow-lg backdrop-blur">
                  “golden hour, remove the crowd”
                </div>
              </div>
              <!-- AI divider handle -->
              <div class="absolute inset-y-0 left-1/2 w-0.5 -translate-x-1/2 bg-white/90 shadow-[0_0_12px_rgba(0,0,0,0.35)]" aria-hidden="true"></div>
              <div class="absolute left-1/2 top-1/2 flex h-10 w-10 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-2 border-white bg-brush-violet text-white shadow-xl">
                <Wand2 class="h-4.5 w-4.5" aria-hidden="true" />
              </div>
            </div>

            <!-- tool rail -->
            <div class="flex shrink-0 gap-1.5 border-t border-stone-100 bg-white p-2.5 sm:flex-col sm:border-t-0 sm:border-l">
              <span title="Generate" class="flex h-10 w-10 items-center justify-center rounded-xl border border-stone-200 bg-white text-muted shadow-sm transition hover:border-orange-300 hover:text-brush-orange"><ImagePlus class="h-4.5 w-4.5" aria-hidden="true" /></span>
              <span title="Edit" class="flex h-10 w-10 items-center justify-center rounded-xl border border-stone-200 bg-white text-muted shadow-sm transition hover:border-orange-300 hover:text-brush-orange"><Wand2 class="h-4.5 w-4.5" aria-hidden="true" /></span>
              <span title="Remove" class="flex h-10 w-10 items-center justify-center rounded-xl border border-stone-200 bg-white text-muted shadow-sm transition hover:border-orange-300 hover:text-brush-orange"><Eraser class="h-4.5 w-4.5" aria-hidden="true" /></span>
              <span title="Upscale" class="flex h-10 w-10 items-center justify-center rounded-xl border border-stone-200 bg-white text-muted shadow-sm transition hover:border-orange-300 hover:text-brush-orange"><Maximize2 class="h-4.5 w-4.5" aria-hidden="true" /></span>
              <span title="Restyle" class="flex h-10 w-10 items-center justify-center rounded-xl border border-stone-200 bg-white text-muted shadow-sm transition hover:border-orange-300 hover:text-brush-orange"><Palette class="h-4.5 w-4.5" aria-hidden="true" /></span>
            </div>
          </div>

          <!-- prompt bar -->
          <div class="flex items-center gap-2.5 border-t border-stone-100 bg-white p-3">
            <p class="flex-1 truncate rounded-xl bg-stone-100 px-4 py-2.5 text-sm text-stone-400">
              Remove the background and add golden-hour light…
            </p>
            <span class="inline-flex items-center gap-1.5 rounded-xl bg-brush-orange px-4 py-2.5 text-sm font-semibold text-white shadow-md shadow-orange-500/25">
              <Sparkles class="h-4 w-4" aria-hidden="true" />
              Generate
            </span>
          </div>
        </div>

        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href="/studio" class="group/show inline-flex items-center gap-2 rounded-xl bg-brush-orange px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-orange-500/25 transition hover:bg-orange-600">
            Explore Image Studio
            <ArrowRight class="h-4 w-4 transition-transform group-hover/show:translate-x-0.5" aria-hidden="true" />
          </a>
          <a href={`mailto:${SITE.contactEmail}?subject=Image%20Studio%20early%20access`} class="inline-flex items-center gap-2 rounded-xl border border-stone-300 bg-white px-6 py-3 text-sm font-semibold text-ink shadow-sm transition hover:border-orange-400 hover:text-brush-orange">
            Get early access
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Available models + stats ═══ -->
  <section class="border-b border-stone-100 py-10">
    <h2 class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-stone-400">
      Available models, one API
    </h2>
    <div class="marquee relative mt-7 overflow-hidden [mask-image:linear-gradient(90deg,transparent,black_24%,black_76%,transparent)]">
      <div class="marquee-track flex gap-3 pr-3">
        {
          marqueeProviders.map((provider) => (
