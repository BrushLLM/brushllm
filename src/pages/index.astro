---
import {
  ArrowRight,
  Eraser,
  EyeOff,
  Globe2,
  ImagePlus,
  KeyRound,
  Layers,
  Link2,
  Maximize2,
  Palette,
  PlugZap,
  ShieldCheck,
  Sparkles,
  Wand2,
  Wallet,
} from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrushStroke from '../components/BrushStroke.astro';
import CodeTabs from '../components/CodeTabs.astro';
import FAQ from '../components/FAQ.astro';
import ProviderLogo from '../components/ProviderLogo.astro';
import { LINKS, SITE } from '../config';
import { models } from '../data/models';
import { visibleProviders } from '../data/providers';

const codeTabs = [
  {
    label: 'cURL',
    code: `curl ${LINKS.apiBase}/chat/completions \\
  -H "Authorization: Bearer $BRUSH_LLM_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "model": "deepseek-chat",
    "messages": [
      {"role": "user", "content": "Hello, BrushLLM!"}
    ]
  }'`,
  },
  {
    label: 'Python',
    code: `from openai import OpenAI

client = OpenAI(
    api_key="brsh-...",
    base_url="${LINKS.apiBase}",
)

response = client.chat.completions.create(
    model="glm-4.6",
    messages=[{"role": "user", "content": "Hello, BrushLLM!"}],
)
print(response.choices[0].message.content)`,
  },
  {
    label: 'Node.js',
    code: `import OpenAI from "openai";

const client = new OpenAI({
  apiKey: process.env.BRUSH_LLM_API_KEY,
  baseURL: "${LINKS.apiBase}",
});

const response = await client.chat.completions.create({
  model: "kimi-k2-0905",
  messages: [{ role: "user", content: "Hello, BrushLLM!" }],
});
console.log(response.choices[0].message.content);`,
  },
  {
    label: 'Go',
    code: `package main

import (
	"context"
	"fmt"
	"os"

	openai "github.com/sashabaranov/go-openai"
)

func main() {
	cfg := openai.DefaultConfig(os.Getenv("BRUSH_LLM_API_KEY"))
	cfg.BaseURL = "${LINKS.apiBase}"
	client := openai.NewClientWithConfig(cfg)

	resp, _ := client.CreateChatCompletion(context.Background(),
		openai.ChatCompletionRequest{
			Model:    "qwen3-max",
			Messages: []openai.ChatCompletionMessage{{Role: "user", Content: "Hello, BrushLLM!"}},
		})
	fmt.Println(resp.Choices[0].Message.Content)
}`,
  },
];

/* feature cards: solid color icon tiles */
const featureStyles = [
  'bg-brush-violet shadow-violet-500/25',
  'bg-brush-cyan shadow-cyan-500/25',
  'bg-brush-orange shadow-orange-500/25',
  'bg-brush-amber shadow-amber-500/25',
  'bg-brush-rose shadow-rose-500/25',
  'bg-brush-blue shadow-blue-500/25',
] as const;

const features = [
  {
    icon: PlugZap,
    title: 'OpenAI-compatible API',
    description:
      'Keep your existing SDK and code. Change one base URL and every request just works — chat, tools, and streaming.',
  },
  {
    icon: Layers,
    title: 'Every frontier lab, one key',
    description: `DeepSeek, Qwen, GLM, Kimi, Doubao, MiniMax and GPT — ${models.length} models behind a single API key.`,
  },
  {
    icon: Globe2,
    title: 'Open to every country',
    description:
      'No separate accounts, local payment hoops, or region locks per provider. Sign up from anywhere and start in under a minute.',
  },
  {
    icon: Wallet,
    title: 'Pay-as-you-go pricing',
    description:
      'Per-token and per-image billing with no subscriptions and no minimums. Several models — including GLM-4.5 Flash and Doubao Seed 1.6 Flash — are free.',
  },
  {
    icon: ShieldCheck,
    title: 'Keys with guardrails',
    description:
      'Create multiple API keys, set spend quotas per key, and monitor usage from the console — safe to hand keys to agents and teammates.',
  },
  {
    icon: EyeOff,
    title: 'Your privacy, protected',
    description:
      'No trackers, no analytics, no ads. Your prompts are proxied straight to the model and never stored, sold, or used to profile you.',
  },
];

const steps = [
  {
    icon: KeyRound,
    title: 'Create an account',
    description: 'Sign up with email and grab an API key from the console. No credit card to start.',
  },
  {
    icon: Link2,
    title: 'Point your SDK at BrushLLM',
    description: 'Set the base URL and keep the OpenAI SDK you already use.',
  },
  {
    icon: Sparkles,
    title: 'Call any model by id',
    description: 'Swap model ids freely — the whole catalog is one key away.',
  },
];

const studioCapabilities = [
  'Generate',
  'Edit',
  'Remove',
  'Replace',
  'Expand',
  'Upscale',
  'Restyle',
  'Transform',
];

const faqs = [
  {
    question: 'What is BrushLLM?',
    answer:
      'BrushLLM is an AI platform with two core products. AI Model Services gives developers one API for the world’s leading models — from DeepSeek, Qwen, and GLM to GPT and text-to-image. Image Studio is a browser-based AI image editor for everyone. One account covers both.',
  },
  {
    question: 'Is it really drop-in compatible with the OpenAI SDK?',
    answer: `Yes. Point your SDK’s base URL at ${LINKS.apiBase} and use your BrushLLM key. Chat completions, tool calling, and streaming work the way you expect — only the model ids change.`,
  },
  {
    question: 'How does billing work?',
    answer:
      'Strictly pay-as-you-go in USD — per token for text models, per image for image models. There are no subscriptions or minimums, and several models have free tiers. Top up and track spend from the console.',
  },
  {
    question: 'Who is BrushLLM for?',
    answer:
      'Developers and teams building products on AI models, and creators who want a full AI image workspace. The API and Image Studio share one account and one balance.',
  },
  {
    question: 'How do you protect my privacy?',
    answer:
      'We collect only what an account needs to function. No trackers, no analytics, no ads — your prompts are proxied straight to the upstream model and never stored, sold, or used to profile you.',
  },
  {
    question: 'Which model should I start with?',
    answer:
      'GPT-5.2 if you want the ChatGPT experience, DeepSeek-V3.2 as a cheap default for chat and tools, GLM-4.6 and Qwen3-Max for coding and agentic workflows, DeepSeek-R1 or Kimi K2 Thinking for hard reasoning. Browse the full catalog with live prices on the Models page.',
  },
  {
    question: 'Can I use my key in coding agents and CLIs?',
    answer:
      'Yes — anything that speaks the OpenAI API works. Set the base URL and API key in your tool’s config (Cursor, Cline, OpenCode, aider and similar) and pick any model id from the catalog.',
  },
];
---

<BaseLayout>
  <!-- ═══ Hero: two products, one platform ═══ -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <BrushStroke shape="sweep" color="cyan" class="absolute -top-8 -left-40 w-[720px] -rotate-6 opacity-20" />
      <BrushStroke shape="sweep" color="orange" class="absolute top-40 -right-52 w-[680px] rotate-3 opacity-15" />
    </div>

    <div class="mx-auto max-w-6xl px-4 pb-16 pt-20 text-center sm:px-6 sm:pt-28">
      <p class="reveal mx-auto inline-flex items-center gap-2 rounded-full border border-stone-200 bg-white px-4 py-1.5 text-xs font-semibold text-brush-violet shadow-sm">
        <span class="h-2 w-2 rounded-full bg-brush-fuchsia"></span>
        AI Models · AI Images · One Platform
      </p>

      <h1 class="reveal mx-auto mt-7 max-w-4xl text-5xl font-bold tracking-tight text-balance sm:text-6xl lg:text-7xl">
        <span class="relative inline-block px-0.5">
          <BrushStroke shape="highlight" color="violet" class="absolute inset-x-0 top-1/2 h-[0.78em] -translate-y-[42%] -rotate-1 opacity-25" />
          <span class="relative whitespace-nowrap text-ink">AI Models.</span>
        </span>
        {' '}
        <span class="relative inline-block px-0.5">
          <BrushStroke shape="highlight" color="orange" class="absolute inset-x-0 top-1/2 h-[0.78em] -translate-y-[42%] rotate-1 opacity-25" />
          <span class="relative whitespace-nowrap text-ink">AI Images.</span>
        </span>
        One Platform.
      </h1>

      <p class="reveal mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-muted">
        Access the world’s leading AI models through one API — and create, edit, and transform
        images with AI in Image Studio. One account for developers and creators.
      </p>

      <!-- two product entries, visually equal -->
      <div class="reveal mx-auto mt-10 grid max-w-4xl gap-5 text-left sm:grid-cols-2">
        <div class="group rounded-3xl border border-stone-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-violet-300 hover:shadow-lg">
          <div class="flex items-center justify-between">
            <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-brush-violet text-white shadow-lg shadow-violet-500/25">
              <Layers class="h-5 w-5" aria-hidden="true" />
            </div>
            <span class="text-[11px] font-semibold uppercase tracking-widest text-brush-violet">For developers</span>
          </div>
          <h2 class="mt-4 text-xl font-bold tracking-tight">AI Model Services</h2>
          <p class="mt-2 text-sm leading-relaxed text-muted">One API. Many models. The world’s leading labs behind a single endpoint.</p>
          <div class="mt-5 flex flex-wrap gap-2.5">
            <a href="/models" class="inline-flex items-center gap-1.5 rounded-xl bg-brush-violet px-4 py-2.5 text-sm font-semibold text-white shadow-md shadow-violet-500/25 transition hover:bg-violet-700">
              Explore AI Models
              <ArrowRight class="h-3.5 w-3.5" aria-hidden="true" />
            </a>
            <a href={LINKS.signUp} class="inline-flex items-center rounded-xl border border-stone-300 bg-white px-4 py-2.5 text-sm font-semibold text-ink shadow-sm transition hover:border-violet-400 hover:text-brush-violet">
              Start Building
            </a>
          </div>
        </div>

        <div class="group relative overflow-hidden rounded-3xl border border-stone-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-fuchsia-300 hover:shadow-lg">
          <div class="pointer-events-none absolute inset-0" aria-hidden="true">
            <BrushStroke shape="sweep" color="fuchsia" class="absolute -top-12 -right-20 w-[360px] rotate-3 opacity-70" />
          </div>
          <div class="relative flex items-center justify-between">
            <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-brush-fuchsia text-white shadow-lg shadow-fuchsia-500/25">
              <ImagePlus class="h-5 w-5" aria-hidden="true" />
            </div>
            <span class="rounded-full bg-brush-fuchsia px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-widest text-white shadow-sm shadow-fuchsia-500/25">Soon</span>
          </div>
          <h2 class="relative mt-4 text-xl font-bold tracking-tight">Image Studio</h2>
          <p class="relative mt-2 text-sm leading-relaxed text-muted">Create, edit, and transform images with AI — right in your browser.</p>
          <div class="relative mt-5 flex flex-wrap gap-2.5">
            <a href="/studio" class="inline-flex items-center gap-1.5 rounded-xl bg-brush-fuchsia px-4 py-2.5 text-sm font-semibold text-white shadow-md shadow-fuchsia-500/25 transition hover:bg-fuchsia-600">
              Try Image Studio
              <ArrowRight class="h-3.5 w-3.5" aria-hidden="true" />
            </a>
            <a href={`mailto:${SITE.contactEmail}?subject=Image%20Studio%20early%20access`} class="inline-flex items-center rounded-xl border border-stone-300 bg-white px-4 py-2.5 text-sm font-semibold text-ink shadow-sm transition hover:border-fuchsia-400 hover:text-brush-fuchsia">
              Early access
            </a>
          </div>
        </div>
      </div>

      <p class="reveal mt-6 text-sm text-stone-500">For developers · For creators · One account</p>
    </div>
  </section>

  <!-- ═══ Provider marquee ═══ -->
  <section class="border-y border-stone-100 py-10">
    <h2 class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-stone-400">
      The world’s leading AI labs, one gateway
    </h2>
    <div class="marquee relative mt-7 overflow-hidden [mask-image:linear-gradient(90deg,transparent,black_24%,black_76%,transparent)]">
      <div class="marquee-track flex gap-3 pr-3">
        {
          [...visibleProviders, ...visibleProviders].map((provider) => (
            <div class="flex shrink-0 items-center gap-3 rounded-2xl border border-stone-200 bg-white px-5 py-4 shadow-sm transition hover:-translate-y-0.5 hover:border-violet-300">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-stone-50">
                <ProviderLogo provider={provider.id} class="h-6 w-6" />
              </span>
              <span class="block text-sm font-semibold">{provider.name}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ One platform, two ways to build ═══ -->
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-brush-violet">Two products</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">One platform. Two ways to build with AI.</h2>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      <!-- for developers -->
      <div class="reveal group rounded-[2rem] border border-stone-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:border-violet-300 hover:shadow-lg">
        <span class="inline-flex items-center gap-2 rounded-full bg-brush-violet px-3 py-1 text-[11px] font-semibold uppercase tracking-widest text-white shadow-md shadow-violet-500/25">
          For developers
        </span>
        <h3 class="mt-4 text-2xl font-bold tracking-tight">AI Model Services</h3>
        <p class="mt-1 font-display text-sm font-semibold text-brush-violet">One API. Many models.</p>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Access a growing collection of the world’s most powerful AI models through a single
          OpenAI-compatible API — {models.length} models, {visibleProviders.length} providers,
          honest per-use pricing.
        </p>
        <ul class="mt-5 space-y-2 text-sm text-muted">
          <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-brush-violet"></span>Drop-in with any OpenAI SDK</li>
          <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-brush-cyan"></span>Chat, reasoning, embeddings & image models</li>
          <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-brush-orange"></span>Published prices, pay-as-you-go, free tiers</li>
        </ul>
        <p class="mt-5 text-xs font-medium uppercase tracking-wide text-stone-400">Developers · Startups · Businesses</p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href="/models" class="group/dev inline-flex items-center gap-1.5 rounded-xl bg-brush-violet px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-violet-500/25 transition hover:bg-violet-700">
            Explore Models
            <ArrowRight class="h-4 w-4 transition-transform group-hover/dev:translate-x-0.5" aria-hidden="true" />
          </a>
          <a href="/docs" class="inline-flex items-center gap-2 rounded-xl border border-stone-300 bg-white px-5 py-2.5 text-sm font-semibold text-ink shadow-sm transition hover:border-violet-400 hover:text-brush-violet">
            Read the docs
          </a>
        </div>
      </div>

      <!-- for creators -->
      <div class="reveal relative overflow-hidden rounded-[2rem] border border-stone-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:border-fuchsia-300 hover:shadow-lg">
        <div class="pointer-events-none absolute inset-0" aria-hidden="true">
          <BrushStroke shape="sweep" color="fuchsia" class="absolute -top-10 -right-24 w-[420px] rotate-3 opacity-80" />
        </div>
        <span class="relative inline-flex items-center gap-2 rounded-full bg-brush-fuchsia px-3 py-1 text-[11px] font-semibold uppercase tracking-widest text-white shadow-md shadow-fuchsia-500/25">
          For creators · Soon
        </span>
        <h3 class="relative mt-4 text-2xl font-bold tracking-tight">Image Studio</h3>
        <p class="relative mt-1 font-display text-sm font-semibold text-brush-fuchsia">AI-powered image creation and editing.</p>
        <p class="relative mt-3 text-sm leading-relaxed text-muted">
          Generate, edit, expand, upscale, and transform images with AI — a full creative
          workspace in your browser. No installs, no subscriptions.
        </p>
        <ul class="relative mt-5 flex flex-wrap gap-2">
          {
            studioCapabilities.map((cap) => (
              <li class="rounded-full border border-stone-200 bg-stone-50 px-3 py-1 text-xs font-medium text-brush-fuchsia">{cap}</li>
            ))
          }
        </ul>
        <p class="relative mt-5 text-xs font-medium uppercase tracking-wide text-stone-400">Creators · Designers · Everyone</p>
        <div class="relative mt-4 flex flex-wrap gap-3">
          <a href="/studio" class="group/create inline-flex items-center gap-1.5 rounded-xl bg-brush-fuchsia px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-fuchsia-500/25 transition hover:bg-fuchsia-600">
            Open Image Studio
            <ArrowRight class="h-4 w-4 transition-transform group-hover/create:translate-x-0.5" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Image Studio showcase ═══ -->
  <section class="border-y border-stone-100 bg-stone-50/50">
    <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-brush-fuchsia">Image Studio</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl">
          A real AI image workspace,
          <span class="relative inline-block">
            <span>coming to your browser</span>
            <BrushStroke shape="underline" color="fuchsia" class="absolute -bottom-2 left-0 h-2.5 w-full" />
          </span>
        </h2>
        <p class="mt-4 text-muted">
          Upload an image and paint changes with plain words — the studio does the rest.
        </p>
      </div>

      <!-- product mockup -->
      <div class="reveal mx-auto mt-12 max-w-4xl">
        <div class="overflow-hidden rounded-3xl border border-stone-200 bg-white shadow-xl shadow-stone-300/40">
          <!-- window chrome -->
          <div class="flex items-center gap-3 border-b border-stone-100 bg-stone-50 px-4 py-3">
            <div class="flex gap-1.5" aria-hidden="true">
              <span class="h-3 w-3 rounded-full bg-stone-300"></span>
              <span class="h-3 w-3 rounded-full bg-stone-300"></span>
              <span class="h-3 w-3 rounded-full bg-stone-300"></span>
            </div>
            <p class="flex-1 truncate rounded-lg bg-white px-3 py-1 text-center font-mono text-xs text-stone-500 ring-1 ring-stone-200">
              brushllm.com/studio
            </p>
            <span class="rounded-full bg-brush-fuchsia px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-widest text-white">Soon</span>
          </div>

          <div class="flex flex-col sm:flex-row">
            <!-- canvas: before / after -->
            <div class="relative min-h-[260px] flex-1 overflow-hidden bg-stone-100">
              <!-- before (left) -->
              <div class="absolute inset-y-0 left-0 w-1/2 bg-gradient-to-br from-stone-200 via-stone-300 to-stone-400/60 p-4">
                <span class="absolute left-4 top-4 rounded-full bg-white/80 px-2.5 py-0.5 text-[11px] font-semibold text-stone-600 backdrop-blur">Before</span>
                <div class="absolute bottom-4 left-4 space-y-2 opacity-60">
                  <div class="h-2.5 w-24 rounded bg-stone-500/40"></div>
                  <div class="h-2.5 w-16 rounded bg-stone-500/30"></div>
                </div>
              </div>
              <!-- after (right) -->
              <div class="absolute inset-y-0 right-0 w-1/2 overflow-hidden bg-gradient-to-br from-violet-500/80 via-fuchsia-500/70 to-orange-400/80">
                <BrushStroke shape="sweep" color="amber" class="absolute -bottom-8 -right-16 w-[300px] rotate-6 opacity-70" />
                <span class="absolute right-4 top-4 rounded-full bg-white/85 px-2.5 py-0.5 text-[11px] font-semibold text-brush-fuchsia backdrop-blur">After</span>
                <div class="absolute bottom-4 right-4 rounded-xl bg-white/90 px-3 py-2 text-xs font-medium text-ink shadow-lg backdrop-blur">
                  “golden hour, remove the crowd”
                </div>
              </div>
              <!-- AI divider handle -->
              <div class="absolute inset-y-0 left-1/2 w-0.5 -translate-x-1/2 bg-white/90 shadow-[0_0_12px_rgba(0,0,0,0.35)]" aria-hidden="true"></div>
              <div class="absolute left-1/2 top-1/2 flex h-10 w-10 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-2 border-white bg-brush-violet text-white shadow-xl">
                <Wand2 class="h-4.5 w-4.5" aria-hidden="true" />
              </div>
            </div>

            <!-- tool rail -->
            <div class="flex shrink-0 gap-1.5 border-t border-stone-100 bg-white p-2.5 sm:flex-col sm:border-t-0 sm:border-l">
              <span title="Generate" class="flex h-10 w-10 items-center justify-center rounded-xl border border-stone-200 bg-white text-muted shadow-sm transition hover:border-fuchsia-300 hover:text-brush-fuchsia"><ImagePlus class="h-4.5 w-4.5" aria-hidden="true" /></span>
              <span title="Edit" class="flex h-10 w-10 items-center justify-center rounded-xl border border-stone-200 bg-white text-muted shadow-sm transition hover:border-fuchsia-300 hover:text-brush-fuchsia"><Wand2 class="h-4.5 w-4.5" aria-hidden="true" /></span>
              <span title="Remove" class="flex h-10 w-10 items-center justify-center rounded-xl border border-stone-200 bg-white text-muted shadow-sm transition hover:border-fuchsia-300 hover:text-brush-fuchsia"><Eraser class="h-4.5 w-4.5" aria-hidden="true" /></span>
              <span title="Upscale" class="flex h-10 w-10 items-center justify-center rounded-xl border border-stone-200 bg-white text-muted shadow-sm transition hover:border-fuchsia-300 hover:text-brush-fuchsia"><Maximize2 class="h-4.5 w-4.5" aria-hidden="true" /></span>
              <span title="Restyle" class="flex h-10 w-10 items-center justify-center rounded-xl border border-stone-200 bg-white text-muted shadow-sm transition hover:border-fuchsia-300 hover:text-brush-fuchsia"><Palette class="h-4.5 w-4.5" aria-hidden="true" /></span>
            </div>
          </div>

          <!-- prompt bar -->
          <div class="flex items-center gap-2.5 border-t border-stone-100 bg-white p-3">
            <p class="flex-1 truncate rounded-xl bg-stone-100 px-4 py-2.5 text-sm text-stone-400">
              Remove the background and add golden-hour light…
            </p>
            <span class="inline-flex items-center gap-1.5 rounded-xl bg-brush-violet px-4 py-2.5 text-sm font-semibold text-white shadow-md shadow-violet-500/25">
              <Sparkles class="h-4 w-4" aria-hidden="true" />
              Generate
            </span>
          </div>
        </div>

        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href="/studio" class="group/show inline-flex items-center gap-2 rounded-xl bg-brush-fuchsia px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-fuchsia-500/25 transition hover:bg-fuchsia-600">
            Open Image Studio
            <ArrowRight class="h-4 w-4 transition-transform group-hover/show:translate-x-0.5" aria-hidden="true" />
          </a>
