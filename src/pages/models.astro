---
import { Search } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrushStroke from '../components/BrushStroke.astro';
import ModelCard from '../components/ModelCard.astro';
import { models } from '../data/models';
import { providers } from '../data/providers';

const freeCount = models.filter((m) => m.price.input === 0 && m.price.output === 0).length;
---

<BaseLayout
  title="Models"
  description={`Browse ${models.length} models from ${providers.length} Chinese AI labs — DeepSeek, Qwen, GLM, Kimi, Doubao, MiniMax and more — with context windows, capabilities and indicative per-token pricing.`}
>
  <section class="relative overflow-hidden">
<BrushStroke shape="sweep" color="cyan" class="pointer-events-none absolute -top-10 -right-44 w-[640px] rotate-2 opacity-15" />
    <div class="mx-auto max-w-6xl px-4 pt-16 pb-8 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-widest text-brush-fuchsia">Model catalog</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
        {models.length} models. {providers.length} labs.
        <span class="relative inline-block">One endpoint.<BrushStroke shape="underline" color="amber" class="absolute -bottom-2 left-0 h-2.5 w-full" /></span>
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
        Every model below is callable through the same OpenAI-compatible API and the same key. Prices
        are indicative, in USD per 1M tokens{freeCount > 0 && ` — ${freeCount} models are free`}.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <!-- controls -->
    <div class="flex flex-col gap-4">
      <div class="relative max-w-md">
        <Search class="pointer-events-none absolute top-1/2 left-3.5 h-4 w-4 -translate-y-1/2 text-stone-400" aria-hidden="true" />
        <input
          id="model-search"
          type="search"
          placeholder="Search by name, id or provider…"
          autocomplete="off"
          class="w-full rounded-xl border border-stone-300 bg-white py-2.5 pr-4 pl-10 text-sm shadow-sm placeholder:text-stone-400 focus:border-violet-400 focus:ring-2 focus:ring-violet-200 focus:outline-none"
          aria-label="Search models"
        />
      </div>

      <div class="flex flex-wrap items-center gap-2" id="provider-chips" role="group" aria-label="Filter by provider">
        <button
          type="button"
          class="chip rounded-full border border-transparent bg-brush-violet px-3.5 py-1.5 text-sm font-semibold text-white shadow-md shadow-violet-500/25 transition"
          data-provider="all"
          aria-pressed="true"
        >
          All
        </button>
        {
          providers.map((provider) => (
            <button
              type="button"
              class="chip rounded-full border border-stone-300 bg-white px-3.5 py-1.5 text-sm font-medium text-muted transition hover:border-violet-400 hover:text-brush-violet"
              data-provider={provider.id}
              aria-pressed="false"
            >
              {provider.name}
            </button>
          ))
        }
      </div>

      <p id="model-count" class="text-sm text-stone-500" aria-live="polite">
        Showing {models.length} of {models.length} models
      </p>
    </div>

    <!-- grid -->
    <div id="model-grid" class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {models.map((model) => <ModelCard model={model} />)}
    </div>

    <p id="model-empty" class="mt-10 hidden rounded-2xl border border-dashed border-stone-300 bg-white p-10 text-center text-muted">
      No models match your search. Try a different keyword or provider.
    </p>

    <p class="mt-8 text-xs leading-relaxed text-stone-400">
      Prices are indicative list prices in USD per 1M tokens and may differ from the rates configured
      in your console. Context windows are the maximum supported by each upstream model.
    </p>
  </section>

  <script>
    const searchInput = document.getElementById('model-search') as HTMLInputElement | null;
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.model-card'));
    const countEl = document.getElementById('model-count');
    const emptyEl = document.getElementById('model-empty');

    let activeProvider = 'all';

    const apply = () => {
      const query = (searchInput?.value ?? '').trim().toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const matchesProvider = activeProvider === 'all' || card.dataset.provider === activeProvider;
        const matchesQuery = !query || (card.dataset.search ?? '').includes(query);
        const show = matchesProvider && matchesQuery;
        card.classList.toggle('hidden', !show);
        if (show) visible++;
      });

      if (countEl) countEl.textContent = `Showing ${visible} of ${cards.length} models`;
      emptyEl?.classList.toggle('hidden', visible !== 0);
    };

    searchInput?.addEventListener('input', apply);

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        activeProvider = chip.dataset.provider ?? 'all';
        chips.forEach((c) => {
          const active = c === chip;
          c.setAttribute('aria-pressed', String(active));
          c.classList.toggle('bg-brush-violet', active);
          c.classList.toggle('text-white', active);
          c.classList.toggle('shadow-md', active);
          c.classList.toggle('shadow-violet-500/25', active);
          c.classList.toggle('font-semibold', active);
          c.classList.toggle('border-transparent', active);
          c.classList.toggle('border-stone-300', !active);
          c.classList.toggle('bg-white', !active);
          c.classList.toggle('text-muted', !active);
          c.classList.toggle('font-medium', !active);
        });
        apply();
      });
    });
  </script>
</BaseLayout>
