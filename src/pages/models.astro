---
import { Search } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrushStroke from '../components/BrushStroke.astro';
import ModelCard from '../components/ModelCard.astro';
import { capabilityLabels, models } from '../data/models';
import { visibleProviders } from '../data/providers';

const freeCount = models.filter((m) => m.price.input === 0 && m.price.output === 0).length;
---

<BaseLayout
  title="AI Models"
  description={`Browse ${models.length} AI models — from DeepSeek, Qwen, GLM and Kimi to GPT and text-to-image — with context windows, capabilities and indicative prices.`}
>
  <section class="relative overflow-hidden">
<BrushStroke shape="sweep" color="mint" class="pointer-events-none absolute -top-10 -right-44 w-[640px] rotate-2 opacity-15" />
    <div class="mx-auto max-w-6xl px-4 pt-16 pb-8 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-widest text-brush-violet">AI models</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
        {models.length} models · {visibleProviders.length} providers ·{' '}
        <span class="relative inline-block">One endpoint<BrushStroke shape="underline" color="orange" class="absolute -bottom-2 left-0 h-2.5 w-full" /></span>
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
        Every model below is callable through the same OpenAI-compatible API and the same key. Prices
        are indicative — USD per 1M tokens for text models, USD per image for image models{freeCount > 0 && ` — ${freeCount} models are free`}.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <!-- controls -->
    <div class="flex flex-col gap-4">
      <div class="relative max-w-md">
        <Search class="pointer-events-none absolute top-1/2 left-3.5 h-4 w-4 -translate-y-1/2 text-stone-400" aria-hidden="true" />
        <input
          id="model-search"
          type="search"
          placeholder="Search by name, id or provider…"
          autocomplete="off"
          class="w-full rounded-xl border border-stone-300 bg-white py-2.5 pr-4 pl-10 text-sm shadow-sm placeholder:text-stone-400 focus:border-mint-400 focus:ring-2 focus:ring-mint-200 focus:outline-none"
          aria-label="Search models"
        />
      </div>

      <div>
        <p class="mb-1.5 text-[11px] font-semibold uppercase tracking-widest text-stone-400">Provider</p>
        <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter by provider">
          <button
            type="button"
            class="chip rounded-full border border-transparent bg-brush-mint px-3.5 py-1.5 text-sm font-semibold text-ink shadow-md shadow-mint-600/25 transition"
            data-group="provider"
            data-value="all"
            aria-pressed="true"
          >
            All
          </button>
          {
            visibleProviders.map((provider) => (
              <button
                type="button"
                class="chip rounded-full border border-stone-300 bg-white px-3.5 py-1.5 text-sm font-medium text-muted transition hover:border-mint-400 hover:text-mint-700"
                data-group="provider"
                data-value={provider.id}
                aria-pressed="false"
              >
                {provider.name}
              </button>
            ))
          }
        </div>
      </div>

      <div>
        <p class="mb-1.5 text-[11px] font-semibold uppercase tracking-widest text-stone-400">Capability</p>
        <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter by capability">
          <button
            type="button"
            class="chip rounded-full border border-transparent bg-brush-mint px-3.5 py-1.5 text-sm font-semibold text-ink shadow-md shadow-mint-600/25 transition"
            data-group="capability"
            data-value="all"
            aria-pressed="true"
          >
            All
          </button>
          {
            Object.entries(capabilityLabels).map(([value, label]) => (
              <button
                type="button"
                class="chip rounded-full border border-stone-300 bg-white px-3.5 py-1.5 text-sm font-medium text-muted transition hover:border-mint-400 hover:text-mint-700"
                data-group="capability"
                data-value={value}
                aria-pressed="false"
              >
                {label}
              </button>
            ))
          }
        </div>
      </div>

      <p id="model-count" class="text-sm text-stone-500" aria-live="polite">
        Showing {models.length} of {models.length} models
      </p>
    </div>

    <!-- grid -->
    <div id="model-grid" class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {models.map((model) => <ModelCard model={model} />)}
    </div>

    <p id="model-empty" class="mt-10 hidden rounded-2xl border border-dashed border-stone-300 bg-white p-10 text-center text-muted">
      No models match your filters. Try a different keyword, provider, capability or use case.
    </p>

    <p class="mt-8 text-xs leading-relaxed text-stone-400">
      Prices are indicative list prices in USD — per 1M tokens for text models, per generated
      image for image models — and may differ from the rates configured in your console. Context
      windows are the maximum supported by each upstream model. See the
      <a href="/docs" class="font-medium text-mint-700 hover:text-mint-800">Docs</a>
      for integration details.
    </p>
  </section>

  <script>
    const searchInput = document.getElementById('model-search') as HTMLInputElement | null;
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.model-card'));
    const countEl = document.getElementById('model-count');
    const emptyEl = document.getElementById('model-empty');

    /* one active value per filter group; groups combine with AND */
    const active: Record<string, string> = { provider: 'all', capability: 'all' };

    const setChipActive = (chip: HTMLButtonElement, on: boolean) => {
      chip.setAttribute('aria-pressed', String(on));
      chip.classList.toggle('bg-brush-mint', on);
      chip.classList.toggle('text-ink', on);
      chip.classList.toggle('shadow-md', on);
      chip.classList.toggle('shadow-mint-600/25', on);
      chip.classList.toggle('font-semibold', on);
      chip.classList.toggle('border-transparent', on);
      chip.classList.toggle('border-stone-300', !on);
      chip.classList.toggle('bg-white', !on);
      chip.classList.toggle('text-muted', !on);
      chip.classList.toggle('font-medium', !on);
    };

    const apply = () => {
      const query = (searchInput?.value ?? '').trim().toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const caps = (card.dataset.capabilities ?? '').split(',').filter(Boolean);
        const show =
          (active.provider === 'all' || card.dataset.provider === active.provider) &&
          (active.capability === 'all' || caps.includes(active.capability)) &&
          (!query || (card.dataset.search ?? '').includes(query));
        card.classList.toggle('hidden', !show);
        if (show) visible++;
      });

      if (countEl) countEl.textContent = `Showing ${visible} of ${cards.length} models`;
      emptyEl?.classList.toggle('hidden', visible !== 0);
    };

    searchInput?.addEventListener('input', apply);

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const group = chip.dataset.group ?? 'provider';
        const value = chip.dataset.value ?? 'all';
        // clicking the active chip again resets the group to All
        active[group] = active[group] === value && value !== 'all' ? 'all' : value;
        chips.forEach((c) => {
          if ((c.dataset.group ?? 'provider') === group) {
            setChipActive(c, (c.dataset.value ?? 'all') === active[group]);
          }
        });
        apply();
      });
    });
  </script>
</BaseLayout>
