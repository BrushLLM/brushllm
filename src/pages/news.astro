---
import BrushStroke from '../components/BrushStroke.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsList from '../components/NewsList.astro';
import { news } from '../data/news';
---

<BaseLayout
  title="News"
  description="New model releases, catalog updates and platform news from BrushLLM — refreshed daily."
>
  <section class="relative mx-auto max-w-6xl overflow-hidden px-4 py-16 sm:px-6">
    <BrushStroke shape="sweep" color="rose" class="pointer-events-none absolute -top-8 -left-40 w-[620px] -rotate-3 opacity-15" />
    <p class="text-sm font-semibold uppercase tracking-widest text-brush-rose">AI News</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
      All updates, <span class="relative inline-block">fresh as paint<BrushStroke shape="underline" color="rose" class="absolute -bottom-2 left-0 h-2.5 w-full" /></span>
    </h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
      {news.length} updates and counting — new releases land here as soon as they hit the catalog.
    </p>
    <div class="mt-10">
      <NewsList />
    </div>
  </section>
</BaseLayout>
