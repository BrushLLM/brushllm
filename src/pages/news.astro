---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsList from '../components/NewsList.astro';
import { news } from '../data/news';
---

<BaseLayout
  title="News"
  description="New model releases, catalog updates and platform news from BrushLLM — refreshed daily."
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-widest text-accent">AI News</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">All updates</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-stone-600">
      {news.length} updates and counting — new releases land here as soon as they hit the catalog.
    </p>
    <div class="mt-10">
      <NewsList />
    </div>
  </section>
</BaseLayout>
