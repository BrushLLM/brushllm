---
import { ArrowLeft, ArrowRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrushStroke from '../../components/BrushStroke.astro';
import { formatDate, news } from '../../data/news';

export function getStaticPaths() {
  return news.map((item, i) => ({
    params: { slug: item.slug },
    props: {
      item,
      newer: i > 0 ? news[i - 1] : undefined,
      older: i < news.length - 1 ? news[i + 1] : undefined,
    },
  }));
}

const { item, newer, older } = Astro.props;
---

<BaseLayout title={item.title} description={item.summary}>
  <article class="relative mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <BrushStroke shape="sweep" color="violet" class="absolute -top-10 -right-40 w-[560px] rotate-3 opacity-10" />
    </div>

    <a href="/news" class="group inline-flex items-center gap-1.5 text-sm font-semibold text-muted transition-colors hover:text-brush-violet">
      <ArrowLeft class="h-4 w-4 transition-transform group-hover:-translate-x-0.5" aria-hidden="true" />
      All news
    </a>

    <time class="mt-6 inline-block rounded-full bg-violet-100 px-3 py-1 text-xs font-semibold text-violet-700" datetime={item.date}>
      {formatDate(item.date)}
    </time>

    <h1 class="mt-4 text-3xl font-bold tracking-tight text-balance sm:text-4xl">
      {item.title}
      <BrushStroke shape="underline" color="violet" class="mt-3 h-2.5 w-40" />
    </h1>

    <div class="mt-8 space-y-5 text-lg leading-relaxed text-muted">
      {item.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <!-- prev / next -->
    <nav class="mt-14 grid gap-3 border-t border-stone-200 pt-8 sm:grid-cols-2" aria-label="News navigation">
      {
        older ? (
          <a
            href={`/news/${older.slug}`}
            class="group rounded-2xl border border-stone-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-violet-300"
          >
            <p class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-stone-400">
              <ArrowLeft class="h-3.5 w-3.5" aria-hidden="true" />
              Older
            </p>
            <p class="mt-2 font-semibold group-hover:text-brush-violet">{older.title}</p>
          </a>
        ) : (
          <span class="hidden sm:block" />
        )
      }
      {
        newer ? (
          <a
            href={`/news/${newer.slug}`}
            class="group rounded-2xl border border-stone-200 bg-white p-5 text-right shadow-sm transition hover:-translate-y-0.5 hover:border-violet-300"
          >
            <p class="flex items-center justify-end gap-1.5 text-xs font-semibold uppercase tracking-wide text-stone-400">
              Newer
              <ArrowRight class="h-3.5 w-3.5" aria-hidden="true" />
            </p>
            <p class="mt-2 font-semibold group-hover:text-brush-violet">{newer.title}</p>
          </a>
        ) : (
          <span class="hidden sm:block" />
        )
      }
    </nav>
  </article>
</BaseLayout>
