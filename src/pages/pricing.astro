---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LINKS } from '../config';
import { formatContext, formatPrice, models } from '../data/models';
import { providers } from '../data/providers';

const providerName = (id: string) => providers.find((p) => p.id === id)?.name ?? id;
const chatModels = models.filter((m) => !m.capabilities.includes('embeddings'));
const embeddingModels = models.filter((m) => m.capabilities.includes('embeddings'));
const freeModels = models.filter((m) => m.price.input === 0 && m.price.output === 0);

const highlights = [
  {
    title: 'Pay-as-you-go only',
    description: 'Per-token billing in USD. No subscriptions, no minimums, no markup games — top up and go.',
  },
  {
    title: `${freeModels.length} free models`,
    description: `GLM-4.5 Flash, Doubao Seed 1.6 Flash and Spark Lite cost nothing — perfect for prototypes and hobby apps.`,
  },
  {
    title: 'Volume discounts',
    description: 'Running serious volume? Reach out and we’ll work out committed-use rates for your workload.',
  },
];
---

<BaseLayout
  title="Pricing"
  description={`Simple pay-as-you-go pricing for every model on BrushLLM — indicative per-token prices in USD, with several free tiers.`}
>
  <section class="mx-auto max-w-6xl px-4 pt-16 pb-8 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-widest text-accent">Pricing</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">Pay per token. That’s it.</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-stone-600">
      Every model is billed per token in USD. What you see below is the indicative catalog rate —
      your exact rates and balance live in the console.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-8 sm:px-6">
    <div class="grid gap-4 sm:grid-cols-3">
      {
        highlights.map((item) => (
          <div class="rounded-2xl border border-stone-200 bg-white p-6">
            <h2 class="font-semibold">{item.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-stone-600">{item.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <h2 class="mt-8 text-2xl font-bold tracking-tight">Generation models</h2>
    <div class="mt-6 overflow-x-auto rounded-xl border border-stone-200 bg-white">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-stone-200 bg-stone-50 text-xs uppercase tracking-wide text-stone-500">
          <tr>
            <th class="px-4 py-3 font-medium">Model</th>
            <th class="px-4 py-3 font-medium">Provider</th>
            <th class="px-4 py-3 font-medium">Context</th>
            <th class="px-4 py-3 text-right font-medium">Input / 1M</th>
            <th class="px-4 py-3 text-right font-medium">Output / 1M</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          {
            chatModels.map((model) => (
              <tr>
                <td class="px-4 py-3">
                  <p class="font-medium">{model.name}</p>
                  <code class="mt-0.5 font-mono text-xs text-stone-500">{model.id}</code>
                </td>
                <td class="px-4 py-3 text-stone-700">{providerName(model.provider)}</td>
                <td class="px-4 py-3 text-stone-500">{formatContext(model.context)}</td>
                <td class="px-4 py-3 text-right font-semibold">{formatPrice(model.price.input)}</td>
                <td class="px-4 py-3 text-right font-semibold">{formatPrice(model.price.output)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    {
      embeddingModels.length > 0 && (
        <>
          <h2 class="mt-12 text-2xl font-bold tracking-tight">Embeddings</h2>
          <div class="mt-6 overflow-x-auto rounded-xl border border-stone-200 bg-white">
            <table class="w-full text-left text-sm">
              <thead class="border-b border-stone-200 bg-stone-50 text-xs uppercase tracking-wide text-stone-500">
                <tr>
                  <th class="px-4 py-3 font-medium">Model</th>
                  <th class="px-4 py-3 font-medium">Provider</th>
                  <th class="px-4 py-3 font-medium">Context</th>
                  <th class="px-4 py-3 text-right font-medium">Input / 1M</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-stone-100">
                {embeddingModels.map((model) => (
                  <tr>
                    <td class="px-4 py-3">
                      <p class="font-medium">{model.name}</p>
                      <code class="mt-0.5 font-mono text-xs text-stone-500">{model.id}</code>
                    </td>
                    <td class="px-4 py-3 text-stone-700">{providerName(model.provider)}</td>
                    <td class="px-4 py-3 text-stone-500">{formatContext(model.context)}</td>
                    <td class="px-4 py-3 text-right font-semibold">{formatPrice(model.price.input)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      )
    }

    <p class="mt-8 text-xs leading-relaxed text-stone-400">
      Prices are indicative list prices in USD per 1M tokens. Actual billing happens in your
      console, where you can also track spend per API key.
    </p>

    <div class="mt-12 rounded-3xl border border-accent/20 bg-gradient-to-b from-accent-soft/70 to-white px-6 py-14 text-center">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Check your balance &amp; rates</h2>
      <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-stone-600">
        Top up, set key quotas and watch usage in real time — all in the console.
      </p>
      <a href={LINKS.console} class="mt-6 inline-block rounded-xl bg-accent px-7 py-3 text-sm font-semibold text-white transition hover:bg-accent-strong">
        Open the console
      </a>
    </div>
  </section>
</BaseLayout>
