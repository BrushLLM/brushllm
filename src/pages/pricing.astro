---
import { ArrowRight, Gift, Percent, Scale } from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { LINKS } from '../config';
import { formatContext, formatPrice, models } from '../data/models';
import { providers } from '../data/providers';

const providerName = (id: string) => providers.find((p) => p.id === id)?.name ?? id;
const chatModels = models.filter((m) => !m.capabilities.includes('embeddings'));
const embeddingModels = models.filter((m) => m.capabilities.includes('embeddings'));
const freeModels = models.filter((m) => m.price.input === 0 && m.price.output === 0);

const highlights = [
  {
    icon: Percent,
    title: 'Pay-as-you-go only',
    description: 'Per-token billing in USD. No subscriptions, no minimums, no markup games — top up and go.',
    tile: 'from-violet-500 to-fuchsia-500',
  },
  {
    icon: Gift,
    title: `${freeModels.length} free models`,
    description: 'GLM-4.5 Flash, Doubao Seed 1.6 Flash and Spark Lite cost nothing — perfect for prototypes and hobby apps.',
    tile: 'from-orange-400 to-rose-500',
  },
  {
    icon: Scale,
    title: 'Volume discounts',
    description: 'Running serious volume? Reach out and we’ll work out committed-use rates for your workload.',
    tile: 'from-cyan-400 to-blue-600',
  },
];
---

<BaseLayout
  title="Pricing"
  description={`Simple pay-as-you-go pricing for every model on BrushLLM — indicative per-token prices in USD, with several free tiers.`}
>
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="blob absolute -top-16 left-1/4 h-64 w-64 rounded-full bg-orange-200/40 blur-3xl"></div>
      <div class="blob blob-slow absolute -top-8 right-1/4 h-64 w-64 rounded-full bg-violet-200/40 blur-3xl"></div>
    </div>
    <div class="mx-auto max-w-6xl px-4 pt-16 pb-8 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-widest text-brush-orange">Pricing</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
        Pay per token. <span class="text-brush">That’s it.</span>
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
        Every model is billed per token in USD. What you see below is the indicative catalog rate —
        your exact rates and balance live in the console.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-8 sm:px-6">
    <div class="grid gap-5 sm:grid-cols-3">
      {
        highlights.map((item) => (
          <div class="reveal rounded-2xl border border-violet-100 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-fuchsia-200 hover:shadow-lg">
            <div class={`flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br text-white shadow-lg ${item.tile}`}>
              <item.icon class="h-5 w-5" aria-hidden="true" />
            </div>
            <h2 class="mt-4 font-semibold">{item.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-muted">{item.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <h2 class="reveal mt-8 text-2xl font-bold tracking-tight">Generation models</h2>
    <div class="reveal mt-6 overflow-x-auto rounded-2xl border border-violet-100 bg-white shadow-sm">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-violet-100 bg-gradient-to-r from-violet-50 via-fuchsia-50 to-orange-50 text-xs uppercase tracking-wide text-stone-500">
          <tr>
            <th class="px-4 py-3 font-medium">Model</th>
            <th class="px-4 py-3 font-medium">Provider</th>
            <th class="px-4 py-3 font-medium">Context</th>
            <th class="px-4 py-3 text-right font-medium">Input / 1M</th>
            <th class="px-4 py-3 text-right font-medium">Output / 1M</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-violet-100/60">
          {
            chatModels.map((model) => (
              <tr class="transition hover:bg-violet-50/50">
                <td class="px-4 py-3">
                  <p class="font-medium">{model.name}</p>
                  <code class="mt-0.5 font-mono text-xs text-stone-500">{model.id}</code>
                </td>
                <td class="px-4 py-3 text-stone-700">{providerName(model.provider)}</td>
                <td class="px-4 py-3 text-stone-500">{formatContext(model.context)}</td>
                <td class="px-4 py-3 text-right font-semibold">{formatPrice(model.price.input)}</td>
                <td class="px-4 py-3 text-right font-semibold">{formatPrice(model.price.output)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    {
      embeddingModels.length > 0 && (
        <>
          <h2 class="reveal mt-12 text-2xl font-bold tracking-tight">Embeddings</h2>
          <div class="reveal mt-6 overflow-x-auto rounded-2xl border border-violet-100 bg-white shadow-sm">
            <table class="w-full text-left text-sm">
              <thead class="border-b border-violet-100 bg-gradient-to-r from-violet-50 via-fuchsia-50 to-orange-50 text-xs uppercase tracking-wide text-stone-500">
                <tr>
                  <th class="px-4 py-3 font-medium">Model</th>
                  <th class="px-4 py-3 font-medium">Provider</th>
                  <th class="px-4 py-3 font-medium">Context</th>
                  <th class="px-4 py-3 text-right font-medium">Input / 1M</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-violet-100/60">
                {embeddingModels.map((model) => (
                  <tr class="transition hover:bg-violet-50/50">
                    <td class="px-4 py-3">
                      <p class="font-medium">{model.name}</p>
                      <code class="mt-0.5 font-mono text-xs text-stone-500">{model.id}</code>
                    </td>
                    <td class="px-4 py-3 text-stone-700">{providerName(model.provider)}</td>
                    <td class="px-4 py-3 text-stone-500">{formatContext(model.context)}</td>
                    <td class="px-4 py-3 text-right font-semibold">{formatPrice(model.price.input)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      )
    }

    <p class="mt-8 text-xs leading-relaxed text-stone-400">
      Prices are indicative list prices in USD per 1M tokens. Actual billing happens in your
      console, where you can also track spend per API key.
    </p>

    <div class="reveal relative mt-12 overflow-hidden rounded-[2rem] bg-brush px-6 py-14 text-center text-white shadow-2xl shadow-fuchsia-500/30 sm:px-16">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute -top-14 -left-14 h-52 w-52 rounded-full border-[20px] border-white/15"></div>
        <div class="absolute -right-16 -bottom-18 h-64 w-64 rounded-full border-[24px] border-white/10"></div>
      </div>
      <h2 class="relative text-2xl font-bold tracking-tight sm:text-3xl">Check your balance &amp; rates</h2>
      <p class="relative mx-auto mt-3 max-w-md text-sm leading-relaxed text-white/85">
        Top up, set key quotas and watch usage in real time — all in the console.
      </p>
      <a href={LINKS.console} class="group relative mt-6 inline-flex items-center gap-2 rounded-xl bg-white px-7 py-3 text-sm font-semibold text-brush-violet shadow-lg transition hover:scale-[1.02]">
        Open the console
        <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
      </a>
    </div>
  </section>
</BaseLayout>
